<div data-controller="dismiss" role="status" class="<%= cn("flex items-center gap-4 rounded-lg border border-primary px-5 py-4", "bg-module-#{medallion[:mod]}/10", @class_name) %>">
  <%= render Ui::ModuleMedallionComponent.new(mod: medallion[:mod], icon: medallion[:icon]) %>

  <div class="flex-1 min-w-0">
    <%# 28px, not text-2xl's 26: the serif has a smaller x-height than Caveat at
        the same size. font-normal is the only weight --font-display ships. %>
    <p class="font-display font-normal text-[28px] leading-tight text-primary"><%= @title %></p>
    <% if @note %><p class="text-secondary text-sm mt-0.5"><%= @note %></p><% end %>
  </div>

  <% if action? %><div class="shrink-0"><%= action %></div><% end %>

  <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: {
        class: "shrink-0",
        data: { action: "click->dismiss#dismiss" },
        aria: { label: t("ui.celebration_moment.dismiss_aria") }
      })) do %>
    <%= lucide_icon("x", css_class: "size-4") %>
  <% end %>
</div>
