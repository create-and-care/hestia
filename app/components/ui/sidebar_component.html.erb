<div data-controller="sidebar" data-sidebar-collapsed-class="w-16" class="flex">
  <aside data-sidebar-target="panel" class="<%= cn("flex w-64 flex-col gap-4 border-r border-primary bg-surface p-4 transition-[width] overflow-hidden", @class_name) %>">
    <% if header? %><div class="flex items-center justify-between gap-2"><%= header %>
      <button type="button" data-action="click->sidebar#toggle" class="rounded-md p-1.5 text-secondary hover:bg-surface-hover" aria-label="Toggle sidebar">
        <svg class="size-4" viewBox="0 0 24 24" fill="none"><path d="M9 4v16M4 4h16v16H4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
      </button>
    </div><% end %>

    <nav class="flex-1 flex flex-col gap-1"><%= content %></nav>

    <% if footer? %><div><%= footer %></div><% end %>
  </aside>
</div>
