<div data-controller="sidebar" data-sidebar-collapsed-class="w-16" data-sidebar-expanded-class="w-72" class="flex">
  <aside data-sidebar-target="panel" class="<%= cn("group flex w-72 flex-col gap-3 border-r border-primary bg-surface p-3 transition-[width] overflow-hidden", @class_name) %>">
    <% if header? %><div class="flex items-center justify-between gap-2 group-data-[collapsed=true]:justify-center"><%= header %>
      <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: {
            class: "shrink-0 px-2",
            data: { action: "click->sidebar#toggle", sidebar_target: "panelToggle" },
            aria: { label: t("ui.sidebar.toggle_aria"), expanded: "true" }
          })) do %>
        <%# Two glyphs rather than one rotated: the rail state is "click to open",
            and a 180°-flipped panel-left-close reads as a right-hand panel, not
            as the same panel reopening. %>
        <span class="group-data-[collapsed=true]:hidden"><%= lucide_icon("panel-left-close", css_class: "size-4") %></span>
        <span class="hidden group-data-[collapsed=true]:block"><%= lucide_icon("panel-left-open", css_class: "size-4") %></span>
      <% end %>
    </div><% end %>

    <% if toolbar? %><div class="group-data-[collapsed=true]:hidden"><%= toolbar %></div><% end %>

    <nav class="flex-1 min-h-0 overflow-y-auto"><%= content %></nav>

    <% if footer? %><div class="flex shrink-0 flex-col gap-3"><%= footer %></div><% end %>
  </aside>
</div>
