<div data-controller="accordion" data-accordion-multiple-value="<%= @multiple %>" class="divide-y divide-tertiary border-y border-primary">
  <% items.each do |item| %>
    <div>
      <button type="button" data-accordion-target="trigger" data-key="<%= item.key %>" aria-expanded="false"
        aria-controls="<%= panel_id(item.key) %>"
        data-action="click->accordion#toggle"
        class="flex w-full items-center justify-between py-4 text-sm font-medium text-primary [&[aria-expanded=true]>svg]:rotate-180">
        <%= item.title %>
        <svg class="size-4 text-secondary transition-transform duration-200" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div id="<%= panel_id(item.key) %>" data-accordion-target="panel" data-key="<%= item.key %>" hidden data-state="closed"
        class="overflow-hidden text-sm text-secondary data-[state=open]:animate-accordion-down data-[state=closed]:animate-accordion-up">
        <div class="pb-4"><%= item %></div>
      </div>
    </div>
  <% end %>
</div>
