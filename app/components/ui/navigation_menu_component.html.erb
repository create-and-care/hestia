<nav data-controller="navigation-menu" class="relative">
  <ul class="flex items-center gap-1">
    <% menus.each do |menu| %>
      <li>
        <button type="button" id="<%= trigger_id(menu.key) %>" data-navigation-menu-target="trigger" data-key="<%= menu.key %>"
          data-action="click->navigation-menu#toggle keydown->navigation-menu#onTriggerKeydown"
          aria-haspopup="menu" aria-expanded="false" aria-controls="<%= panel_id(menu.key) %>"
          class="rounded-md px-3 h-9 text-sm font-medium text-primary hover:bg-surface-hover">
          <%= menu.label %>
        </button>
      </li>
    <% end %>
  </ul>
  <% menus.each do |menu| %>
    <div id="<%= panel_id(menu.key) %>" role="menu" aria-labelledby="<%= trigger_id(menu.key) %>"
      data-navigation-menu-target="panel" data-for="<%= menu.key %>" hidden data-state="closed"
      class="z-50 w-80 rounded-lg border border-primary bg-container p-4 shadow-lg
             data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95
             data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95">
      <%= menu %>
    </div>
  <% end %>
</nav>
