<div data-controller="dialog" <%= tag.attributes(data: { action: root_data_action }) if root_data_action %> class="<%= trigger_wrapper_class %>">
  <div data-action="click->dialog#open" class="<%= trigger_wrapper_class %>">
    <%= trigger %>
  </div>

  <dialog data-dialog-target="dialog" role="<%= @role %>" data-action="click->dialog#closeOnBackdrop cancel->dialog#onCancel" data-state="closed"
    class="<%= cn(
      "p-0 bg-container shadow-border-lg duration-200 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0",
      POSITION_CLASSES.fetch(@position), size_class, ANIMATION_CLASSES.fetch(@position)
    ) %>">
    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: {
          class: "absolute right-4 top-4",
          data: { action: "click->dialog#close" },
          aria: { label: t("ui.dialog.close_aria") }
        })) do %>
      <svg class="size-4" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <% end %>

    <div class="<%= cn("flex flex-col gap-4 overflow-auto p-6", CONTENT_CLASSES.fetch(@position)) %>">
      <% if title? || description? %>
        <div class="pr-8">
          <% if title? %><h2 class="text-base font-semibold text-primary"><%= title %></h2><% end %>
          <% if description? %><p class="text-sm text-secondary mt-1"><%= description %></p><% end %>
        </div>
      <% end %>

      <div class="<%= cn("text-sm text-primary", BODY_CLASSES[@position]) %>"><%= content %></div>

      <% if footer? %>
        <div class="flex items-center justify-end gap-2"><%= footer %></div>
      <% end %>
    </div>
  </dialog>
</div>
