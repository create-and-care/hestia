<div class="flex h-9 w-full items-center gap-2 rounded-md border border-primary bg-container px-3 has-[:focus-visible]:ring-focus">
  <% if leading? %><span class="shrink-0 text-secondary"><%= leading %></span><% end %>
  <div class="flex-1 [&_input]:h-full [&_input]:border-0 [&_input]:px-0 [&_input]:focus-visible:ring-0">
    <%= content %>
  </div>
  <% if trailing? %><span class="shrink-0 text-secondary"><%= trailing %></span><% end %>
</div>
