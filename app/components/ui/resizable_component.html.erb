<div data-controller="resizable" class="flex h-64 w-full overflow-hidden rounded-lg border border-primary">
  <div data-resizable-target="first" class="flex-1 overflow-auto p-4 text-sm text-primary" style="width: 50%">
    <%= first %>
  </div>
  <div data-resizable-target="handle" data-action="pointerdown->resizable#startDrag keydown->resizable#nudge"
    role="separator" aria-orientation="vertical" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" tabindex="0"
    class="w-1 shrink-0 cursor-col-resize bg-tertiary hover:bg-border-primary focus-visible:outline-none focus-visible:ring-focus"></div>
  <div class="flex-1 overflow-auto p-4 text-sm text-primary">
    <%= second %>
  </div>
</div>
