<div data-controller="popover" data-popover-placement-value="<%= @placement %>" class="inline-flex">
  <div data-popover-target="trigger" data-action="click->popover#toggle" class="inline-flex"
    aria-haspopup="dialog" aria-expanded="false" aria-controls="<%= @panel_id %>">
    <%= trigger %>
  </div>
  <div data-popover-target="panel" id="<%= @panel_id %>" hidden data-state="closed"
    class="fixed z-50 w-72 rounded-lg border border-primary bg-container p-4 shadow-lg
           data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=open]:slide-in-from-top-2
           data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95">
    <%= content %>
  </div>
</div>
