<div data-controller="slider" class="flex items-center gap-3">
  <input type="range" name="<%= @name %>" min="<%= @min %>" max="<%= @max %>" step="<%= @step %>" value="<%= @value %>"
    <% if @label %>aria-label="<%= @label %>"<% end %>
    data-slider-target="input" data-action="input->slider#update"
    class="h-1.5 w-full cursor-pointer appearance-none rounded-full bg-surface-inset accent-gray-900
           [&::-webkit-slider-thumb]:size-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-button-primary">
  <output data-slider-target="output" class="w-8 text-right text-sm text-secondary"></output>
</div>
