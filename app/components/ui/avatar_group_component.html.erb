<div class="flex <%= OVERLAP.fetch(@size) %>">
  <% visible_members.each do |member| %>
    <%= render(Ui::TooltipComponent.new) do |tooltip| %>
      <% tooltip.with_trigger { render Ui::AvatarComponent.new(src: member[:src], alt: member[:alt], fallback: member[:fallback], size: @size, class_name: "ring-2 ring-container") } %>
      <%= member[:label] || member[:alt] %>
    <% end %>
  <% end %>

  <% if overflow_count.positive? %>
    <%= render Ui::AvatarComponent.new(fallback: "+#{overflow_count}", size: @size, class_name: "ring-2 ring-container") %>
  <% end %>
</div>
