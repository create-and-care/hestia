<div class="inline-flex items-center gap-2 rounded-md border border-primary bg-container pl-2 pr-1 py-1.5 text-sm">
  <svg class="size-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551" />
  </svg>
  <div class="min-w-0">
    <p class="truncate font-medium text-primary max-w-[10rem]"><%= @name %></p>
    <% if @size %><p class="text-xs text-subdued"><%= @size %></p><% end %>
  </div>
  <% if @removable %>
    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: {
          class: "ml-1 shrink-0",
          aria: { label: "Retirer la pièce jointe" }
        })) do %>
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12" /></svg>
    <% end %>
  <% end %>
</div>
