<div data-controller="carousel" role="region" aria-roledescription="carousel" class="relative w-full">
  <div data-carousel-target="track" class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none]">
    <% slides.each do |slide| %>
      <div data-carousel-target="item" class="w-full shrink-0 snap-start">
        <%= slide %>
      </div>
    <% end %>
  </div>

  <div data-carousel-target="status" role="status" aria-live="polite" class="sr-only"></div>

  <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: {
        class: "absolute left-2 top-1/2 -translate-y-1/2 !rounded-full border border-primary !bg-container hover:!bg-surface-hover shadow-md",
        data: { action: "click->carousel#previous" },
        aria: { label: "Previous slide" }
      })) do %>
    <svg class="size-4" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <% end %>
  <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: {
        class: "absolute right-2 top-1/2 -translate-y-1/2 !rounded-full border border-primary !bg-container hover:!bg-surface-hover shadow-md",
        data: { action: "click->carousel#next" },
        aria: { label: "Next slide" }
      })) do %>
    <svg class="size-4" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <% end %>

  <div class="mt-3 flex justify-center gap-1.5">
    <% slides.each_with_index do |_, index| %>
      <button type="button" data-carousel-target="dot" data-index="<%= index %>" data-action="click->carousel#goTo"
        class="size-1.5 rounded-full bg-surface-inset transition-colors" aria-label="Go to slide <%= index + 1 %>" aria-current="false"></button>
    <% end %>
  </div>
</div>
