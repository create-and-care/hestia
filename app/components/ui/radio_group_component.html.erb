<div role="radiogroup" class="flex flex-col gap-2.5">
  <% @options.each do |label, value| %>
    <% id = "#{@name}-#{value}" %>
    <label for="<%= id %>" class="flex items-center gap-2 text-sm text-primary cursor-pointer">
      <input type="radio" id="<%= id %>" name="<%= @name %>" value="<%= value %>" <%= "checked" if value == @selected %>
        class="size-4 appearance-none rounded-full border border-primary checked:border-[5px] checked:border-button-primary focus-visible:ring-focus">
      <%= label %>
    </label>
  <% end %>
</div>
