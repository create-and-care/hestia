<div class="flex flex-col gap-1.5">
  <% if label? %><%= render(Ui::LabelComponent.new(for_id: @id)) { label.to_s } %><% end %>
  <%= control %>
  <% if description? && !error? %><p id="<%= description_id %>" class="text-xs text-secondary"><%= description %></p><% end %>
  <% if error? %><p id="<%= error_id %>" class="text-xs text-destructive"><%= error %></p><% end %>
</div>
