<div class="flex flex-col items-center gap-2 rounded-lg border border-dashed border-primary bg-container-inset py-8 px-8 text-center">
  <% if illustration? %>
    <div class="mb-2 w-[200px]"><%= illustration %></div>
  <% elsif icon? %>
    <div class="mb-2 text-subdued"><%= icon %></div>
  <% end %>
  <%# The title carries the editorial serif (22px/400, was 15px/500) — an empty
      state is the app speaking to a person, not a data label. leading-tight is
      1.25. The rest of the component is unchanged. %>
  <% if title? %><p class="font-display text-xl font-normal leading-tight text-primary"><%= title %></p><% end %>
  <% if description? %><p class="text-sm text-secondary max-w-sm"><%= description %></p><% end %>
  <% if action? %><div class="mt-3"><%= action %></div><% end %>
</div>
