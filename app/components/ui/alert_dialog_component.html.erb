<%= render(Ui::DialogComponent.new(position: :center, role: "alertdialog")) do |dialog| %>
  <% dialog.with_trigger { trigger.to_s } %>
  <% dialog.with_title { @title } %>
  <% dialog.with_description { @description } if @description %>
  <% dialog.with_footer do %>
    <%# Was pinned at h-9 while the confirm button beside it renders at the
        :default height — the two never lined up. %>
    <%= render(Ui::ButtonComponent.new(variant: :secondary,
          html_options: { data: { action: "click->dialog#close" } })) { @cancel_label } %>
    <% if @confirm_url %>
      <%= render(Ui::ButtonToComponent.new(@confirm_url, method: @confirm_method, variant: @confirm_variant, size: :default)) { @confirm_label } %>
    <% else %>
      <button type="button" data-action="click->dialog#close"
        class="<%= cn("inline-flex h-9 items-center rounded-md px-4 text-sm font-medium", Ui::ButtonComponent::VARIANTS.fetch(@confirm_variant)) %>">
        <%= @confirm_label %>
      </button>
    <% end %>
  <% end %>
  <%= content %>
<% end %>
