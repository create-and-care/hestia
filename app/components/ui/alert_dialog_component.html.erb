<%= render(Ui::DialogComponent.new(position: :center, role: "alertdialog")) do |dialog| %>
  <% dialog.with_trigger { trigger.to_s } %>
  <% dialog.with_title { @title } %>
  <% dialog.with_description { @description } if @description %>
  <% dialog.with_footer do %>
    <button type="button" data-action="click->dialog#close"
      class="inline-flex h-9 items-center rounded-md px-4 text-sm font-medium text-primary bg-button-secondary hover:bg-button-secondary-hover">
      <%= @cancel_label %>
    </button>
    <% if @confirm_url %>
      <%= render(Ui::ButtonToComponent.new(@confirm_url, method: @confirm_method, variant: @confirm_variant, size: :default)) { @confirm_label } %>
    <% else %>
      <button type="button" data-action="click->dialog#close"
        class="inline-flex h-9 items-center rounded-md px-4 text-sm font-medium text-inverse bg-button-destructive hover:bg-button-destructive-hover">
        <%= @confirm_label %>
      </button>
    <% end %>
  <% end %>
  <%= content %>
<% end %>
