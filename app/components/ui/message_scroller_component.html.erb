<div data-controller="message-scroller" class="relative w-full">
  <div data-message-scroller-target="viewport" data-action="scroll->message-scroller#handleScroll"
    role="log" aria-live="polite" tabindex="0"
    class="<%= cn("space-y-3 overflow-y-auto rounded-lg border border-primary bg-surface p-4 [scrollbar-width:thin]", @class_name) %>">
    <%= content %>
  </div>
  <div role="status" aria-live="polite" aria-atomic="true">
    <button type="button" data-message-scroller-target="jumpButton" data-action="click->message-scroller#scrollToBottom" hidden
      class="absolute bottom-3 left-1/2 -translate-x-1/2 inline-flex items-center gap-1.5 rounded-full border border-primary bg-container px-3 h-8 text-xs font-medium text-primary shadow-md hover:bg-surface-hover transition-colors">
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></svg>
      Nouveaux messages
    </button>
  </div>
</div>
