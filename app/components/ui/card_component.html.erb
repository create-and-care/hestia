<div class="<%= cn("rounded-lg border border-primary bg-container shadow-xs", @class_name) %>">
  <% if title? || description? %>
    <div class="flex flex-col gap-1.5 p-6">
      <% if title? %><h3 class="text-xl font-semibold text-primary"><%= title %></h3><% end %>
      <% if description? %><p class="text-base text-secondary"><%= description %></p><% end %>
    </div>
  <% end %>

  <div class="px-6 <%= title? || description? ? "pb-6" : "py-6" %> text-sm text-primary">
    <%= content %>
  </div>

  <% if footer? %>
    <div class="flex items-center gap-2 px-6 pb-6">
      <%= footer %>
    </div>
  <% end %>
</div>
