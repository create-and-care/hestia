<%# The post is added to the feed via the real-time stream; we just reset the field. %>
<%= turbo_stream.replace "new_circle_post" do %>
  <%= tag.div id: "new_circle_post" do %>
    <%= form_with model: [ @circle, @circle.circle_posts.new ], url: circle_posts_path(@circle), class: "mb-6 flex gap-2" do |form| %>
      <%= render Ui::TextareaComponent.new(name: "circle_post[body]", rows: 2, placeholder: t("circles.post_placeholder"),
            html_options: { id: "circle_post_body", required: true, autofocus: true, class: "flex-1" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t("circles.publish") } %>
    <% end %>
  <% end %>
<% end %>
