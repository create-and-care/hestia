<%= tag.div id: "new_prepared_dish" do %>
  <%= form_with model: prepared_dish, url: prepared_dishes_path do |form| %>
    <div class="flex flex-wrap items-end gap-2 rounded-lg border border-primary p-3">
      <div class="min-w-40 flex-1">
        <%= render(Ui::FieldComponent.new(id: "prepared_dish_name")) do |field| %>
          <% field.with_label { t(".name_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(name: "prepared_dish[name]", value: prepared_dish.name,
                  placeholder: t(".name_placeholder"),
                  html_options: { id: "prepared_dish_name", required: true, autocomplete: "off" }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-44">
        <%= render(Ui::FieldComponent.new(id: "prepared_dish_location")) do |field| %>
          <% field.with_label { t(".location_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "prepared_dish[location]", options: location_select_options,
                  selected: prepared_dish.location, html_options: { id: "prepared_dish_location" }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-40">
        <%= render(Ui::FieldComponent.new(id: "prepared_dish_expires_on")) do |field| %>
          <% field.with_label { t(".expires_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "date", name: "prepared_dish[expires_on]", value: prepared_dish.expires_on,
                  html_options: { id: "prepared_dish_expires_on" }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render Ui::LabelComponent.new(for_id: "prepared_dish_photo") { t(".photo_label") } %>
        <%= form.file_field :photo, accept: "image/*", id: "prepared_dish_photo", class: "mt-1 block text-xs text-secondary" %>
      </div>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
    </div>
  <% end %>
<% end %>
