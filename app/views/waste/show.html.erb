<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "waste" %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:waste) %></div>

  <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("trash-2", css_class: "size-6") %> <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <section class="mb-8">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-medium"><%= t(".upcoming_title") %></h2>
      <div class="flex flex-wrap items-center gap-2">
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: waste_path(from: (@from - 4.weeks).iso8601))) { t(".prev_window") } %>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: waste_path)) { t(".today") } %>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: waste_path(from: (@from + 4.weeks).iso8601))) { t(".next_window") } %>
        <%= render(Ui::DialogComponent.new(close_on_submit: true)) do |dialog| %>
          <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :default, size: :sm)) { t(".add") } } %>
          <% dialog.with_title { t(".add_one_time_title") } %>
          <%= render "event_form", event: @event %>
        <% end %>
        <%= render Ui::ViewToggleComponent.new(mode: @events_view_mode, path_for: ->(mode) { waste_path(from: @from.iso8601, events_view: mode) }) %>
      </div>
    </div>
    <% if @events.any? %>
      <div id="waste_events" class="<%= Ui::ViewToggleComponent.container_classes(@events_view_mode) %>">
        <% @events.each do |date, events| %>
          <%= render(Ui::CardComponent.new) do %>
            <p class="mb-1 text-xs font-medium text-secondary"><%= weekday_label(date.wday) %> <%= l(date, format: :numeric_short) %></p>
            <div class="flex flex-wrap gap-2">
              <% events.each do |event| %>
                <%= tag.span id: dom_id(event) do %>
                  <%= render(Ui::BadgeComponent.new(variant: waste_type_badge_variant(event.waste_type))) do %>
                    <%= waste_type_icon(event.waste_type) %> <%= waste_type_label(event.waste_type) %>
                    <%= link_to edit_waste_collection_event_path(event), class: "hover:underline",
                          aria: { label: t(".edit_event_aria", type: waste_type_label(event.waste_type)) } do %><%= lucide_icon("pencil", css_class: "size-3") %><% end %>
                    <%= render(Ui::AlertDialogComponent.new(title: t(".delete_event_confirm"), confirm_label: t(".delete_event_label"),
                          confirm_url: waste_collection_event_path(event), confirm_method: :delete)) do |alert_dialog| %>
                      <% alert_dialog.with_trigger do %>
                        <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon,
                              html_options: { aria: { label: t(".delete_event_aria", type: waste_type_label(event.waste_type)) } })) { lucide_icon("x", css_class: "size-4") } %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".no_events") } %>
      <% end %>
    <% end %>
  </section>

  <section class="mb-8">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-medium"><%= t(".series_title") %></h2>
      <div class="flex items-center gap-2">
        <%= render(Ui::DialogComponent.new(close_on_submit: true)) do |dialog| %>
          <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :default, size: :sm)) { t(".generate_series") } } %>
          <% dialog.with_title { t(".generate_series") } %>
          <%= render "series_form" %>
        <% end %>
        <%= render Ui::ViewToggleComponent.new(mode: @series_view_mode, path_for: ->(mode) { waste_path(from: @from.iso8601, series_view: mode) }) %>
      </div>
    </div>
    <% if @series.any? %>
      <div id="waste_series" class="<%= Ui::ViewToggleComponent.container_classes(@series_view_mode) %>">
        <% @series.each do |series| %>
          <%= tag.div id: dom_id(series) do %>
            <%= render(Ui::CardComponent.new) do %>
              <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
                <div>
                  <%= waste_type_icon(series.waste_type) %> <%= waste_type_label(series.waste_type) %> —
                  <%= weekday_label(series.weekday) %>, <%= t(".every_n_weeks", count: series.interval_weeks) %>
                  <span class="text-subdued">(<%= l(series.starts_on, format: :numeric_compact) %> → <%= l(series.ends_on, format: :numeric_compact) %>)</span>
                </div>
                <%= render(Ui::ButtonToComponent.new(waste_collection_series_path(series), method: :delete, variant: :ghost, size: :sm,
                      html_options: { aria: { label: t(".delete_series_aria", type: waste_type_label(series.waste_type)) },
                                      form: { data: { turbo_confirm: t(".delete_series_confirm") } } })) { t(".delete_series") } %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="mb-3"><%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_series") } } %></div>
    <% end %>
  </section>

</div>
