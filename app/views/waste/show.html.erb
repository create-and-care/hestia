<% content_for :title, "Déchets" %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "waste" %>

<div class="mx-auto mt-10 max-w-2xl px-4">
  <h1 class="mb-6 text-2xl font-semibold">🗑 Déchets</h1>

  <%= render "shared/flash" %>

  <section class="mb-8">
    <h2 class="mb-3 font-medium">Prochaines collectes</h2>
    <% if @events.any? %>
      <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200">
        <% @events.each do |date, events| %>
          <li class="px-4 py-2">
            <p class="text-xs font-medium text-gray-500"><%= weekday_label(date.wday) %> <%= date.strftime("%d/%m") %></p>
            <div class="mt-1 flex flex-wrap gap-2">
              <% events.each do |event| %>
                <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs <%= waste_type_badge_class(event.waste_type) %>">
                  <%= waste_type_icon(event.waste_type) %> <%= waste_type_label(event.waste_type) %>
                  <%= button_to "×", waste_collection_event_path(event), method: :delete, class: "cursor-pointer hover:text-red-600", form: { class: "inline" } %>
                </span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">Aucune collecte planifiée.</p>
    <% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-3 font-medium">Ajouter une collecte ponctuelle</h2>
    <%= form_with model: @event, url: waste_collection_events_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= form.select :waste_type, waste_type_options, {}, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.date_field :collected_on, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit "Ajouter", class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-3 font-medium">Séries récurrentes</h2>
    <% @series.each do |series| %>
      <div class="mb-2 flex items-center justify-between rounded-lg border border-gray-200 px-3 py-2 text-sm">
        <span>
          <%= waste_type_icon(series.waste_type) %> <%= waste_type_label(series.waste_type) %> —
          <%= weekday_label(series.weekday) %>, toutes les <%= series.interval_weeks %> semaine(s)
          <span class="text-gray-400">(<%= series.starts_on.strftime("%d/%m/%y") %> → <%= series.ends_on.strftime("%d/%m/%y") %>)</span>
        </span>
        <%= button_to "Supprimer la série", waste_collection_series_path(series), method: :delete,
              class: "cursor-pointer text-xs text-red-600 hover:underline" %>
      </div>
    <% end %>

    <%= form_with url: waste_collection_series_index_path, method: :post, scope: :waste_collection_series, class: "mt-3 flex flex-wrap items-end gap-2" do |form| %>
      <%= form.select :waste_type, waste_type_options, {}, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.select :weekday, weekday_options, {}, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.number_field :interval_weeks, value: 1, min: 1, class: "w-16 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.date_field :starts_on, value: Date.current, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.date_field :ends_on, value: 3.months.from_now.to_date, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit "Générer la série", class: "cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>
  </section>

  <p class="text-sm"><%= link_to "← Tableau de bord", root_path, class: "underline" %></p>
</div>
