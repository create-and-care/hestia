<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:birthdays) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("cake", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= render(Ui::ButtonComponent.new(variant: :outline, href: calendar_contacts_path)) { t(".calendar_link") } %>
      <%= render Ui::ButtonComponent.new(href: new_contact_path) { t(".new_contact") } %>
      <%= render Ui::ViewToggleComponent.new(mode: @view_mode, path_for: ->(mode) { contacts_path(tag_id: @tag&.id, view: mode) }) %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <section class="mb-6 flex flex-wrap items-center gap-2">
    <%= render(Ui::BadgeComponent.new(variant: @tag ? :secondary : :default)) { link_to t(".all_filter"), contacts_path } %>
    <% @tags.each do |tag| %>
      <%= render(Ui::BadgeComponent.new(variant: @tag == tag ? :default : :secondary)) do %>
        <%= link_to "#{tag.emoji} #{tag.name}".strip, contacts_path(tag_id: tag.id) %>
        <%= button_to "×", contact_tag_path(tag), method: :delete, class: "cursor-pointer text-subdued hover:text-destructive",
              aria: { label: t(".delete_tag_aria", name: tag.name) },
              form: { class: "inline", data: { turbo_confirm: t(".delete_tag_confirm", name: tag.name) } } %>
      <% end %>
    <% end %>
    <%= form_with url: contact_tags_path, method: :post, class: "inline-flex items-end gap-1" do %>
      <div>
        <label for="contact_tag_emoji" class="sr-only"><%= t(".tag_emoji_label") %></label>
        <%= render Ui::InputComponent.new(name: "contact_tag[emoji]", placeholder: "🙂",
              html_options: { id: "contact_tag_emoji", maxlength: 4, class: "w-12 text-xs" }) %>
      </div>
      <div>
        <label for="contact_tag_name" class="sr-only"><%= t(".tag_name_placeholder") %></label>
        <%= render Ui::InputComponent.new(name: "contact_tag[name]", placeholder: t(".tag_name_placeholder"),
              html_options: { id: "contact_tag_name", class: "text-xs" }) %>
      </div>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add_tag") } %>
    <% end %>
  </section>

  <div id="contacts" class="<%= Ui::ViewToggleComponent.container_classes(@view_mode) %>">
    <%= render @contacts %>
  </div>
  <% if @contacts.empty? %>
    <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".none") } } %>
  <% end %>

</div>
