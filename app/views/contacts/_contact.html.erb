<%= tag.div id: dom_id(contact) do %>
  <%= render(Ui::CardComponent.new) do %>
    <div class="flex flex-wrap items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="font-medium"><%= contact.name %></p>
        <p class="text-xs text-secondary">
          <% if contact.born_on %>
            <%= contact.born_on.strftime(contact.year_known ? "%d/%m/%Y" : "%d/%m") %>
            <% if contact.age %> · <%= contact.age %> <%= t(".years") %><% end %>
          <% else %>
            <%= t(".no_date") %>
          <% end %>
          <% contact.contact_tags.each do |tag| %>
            <%= render(Ui::BadgeComponent.new(variant: :secondary, html_options: { class: "ml-1" })) { "#{tag.emoji} #{tag.name}".strip } %>
          <% end %>
        </p>
      </div>

      <%= render(Ui::BadgeComponent.new(variant: proximity_badge_variant(contact.proximity_status))) do %>
        <%= proximity_label(contact.proximity_status) %>
        <% if (days = contact.days_until_birthday) && days.positive? %> (<%= t(".days_until_prefix") %><%= days %>)<% end %>
      <% end %>

      <div class="flex shrink-0 items-center gap-2 text-sm">
        <%= link_to edit_contact_path(contact), class: "text-gray-400 hover:text-gray-900" do %><%= lucide_icon("pencil", css_class: "size-4") %><% end %>
        <%= button_to contact_path(contact), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
      </div>
    </div>
  <% end %>
<% end %>
