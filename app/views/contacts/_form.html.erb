<%= form_with model: contact, url: url do |form| %>
  <% if contact.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% contact.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <%= render(Ui::FieldComponent.new(id: "contact_name")) do |field| %>
      <% field.with_label { t(".name_label") } %>
      <% field.with_control do %>
        <%= render Ui::InputComponent.new(name: "contact[name]", value: contact.name, invalid: contact.errors[:name].any?,
              html_options: { id: "contact_name", required: true }) %>
      <% end %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: "contact_born_on")) do |field| %>
      <% field.with_label { t(".born_on_label") } %>
      <% field.with_control do %>
        <%= render Ui::InputComponent.new(type: "date", name: "contact[born_on]", value: contact.born_on&.iso8601, invalid: contact.errors[:born_on].any?,
              html_options: { id: "contact_born_on" }) %>
      <% end %>
    <% end %>

    <div class="flex items-center gap-2 text-sm">
      <%= hidden_field_tag "contact[year_known]", "0", id: nil %>
      <%= render Ui::CheckboxComponent.new(name: "contact[year_known]", id: "contact_year_known", checked: contact.year_known) %>
      <%= render(Ui::LabelComponent.new(for_id: "contact_year_known")) { t(".year_known_label") } %>
    </div>

    <% if (tags = Current.household.contact_tags.order(:name)).any? %>
      <div>
        <span class="mb-1 block text-sm font-medium"><%= t(".tags_label") %></span>
        <div class="flex flex-wrap gap-3">
          <% tags.each do |tag| %>
            <div class="flex items-center gap-2 text-sm">
              <%= render Ui::CheckboxComponent.new(name: "contact_tag_ids[]", id: "contact_tag_#{tag.id}",
                    checked: contact.contact_tag_ids.include?(tag.id), html_options: { value: tag.id }) %>
              <%= render(Ui::LabelComponent.new(for_id: "contact_tag_#{tag.id}")) { "#{tag.emoji} #{tag.name}".strip } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
  </div>
<% end %>
