<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("handshake", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= form_with model: SharedProject.new, url: shared_projects_path, class: "flex gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: t(".name_placeholder"), class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= form.submit t(".create"), class: "cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>
  </header>

  <%= render "shared/flash" %>

  <% if @projects.any? %>
    <div class="divide-y divide-gray-100 rounded-lg border border-primary">
      <% @projects.each do |project| %>
        <%= render Ui::ItemComponent.new(href: shared_project_path(project)) do |item| %>
          <% item.with_title { project.name } %>
          <% item.with_trailing { number_to_currency(project.total_spent, unit: "€", format: "%n %u") } %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render Ui::EmptyComponent.new do |empty| %>
      <% empty.with_description { t(".empty") } %>
    <% end %>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_budget"), budget_path, class: "underline" %></p>
</div>
