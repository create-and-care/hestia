<%= tag.div id: "new_task" do %>
  <%= form_with model: task, url: tasks_path do |form| %>
    <div class="flex flex-wrap items-end gap-2 rounded-lg border border-primary p-3">
      <div class="min-w-40 flex-1">
        <%= render(Ui::FieldComponent.new(id: "task_title")) do |field| %>
          <% field.with_label { t(".title_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(name: "task[title]", value: task.title, placeholder: t(".title_placeholder"),
                  html_options: { id: "task_title", required: true, autocomplete: "off" }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-16">
        <%= render(Ui::FieldComponent.new(id: "task_emoji")) do |field| %>
          <% field.with_label { t(".emoji_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(name: "task[emoji]", value: task.emoji,
                  html_options: { id: "task_emoji", maxlength: 4 }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-36">
        <%= render(Ui::FieldComponent.new(id: "task_due_on")) do |field| %>
          <% field.with_label { t(".due_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "date", name: "task[due_on]", value: task.due_on,
                  html_options: { id: "task_due_on" }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-36">
        <%= render(Ui::FieldComponent.new(id: "task_assignee_id")) do |field| %>
          <% field.with_label { t(".assignee_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "task[assignee_id]",
                  options: [ [ "—", "" ] ] + task_assignee_options,
                  selected: task.assignee_id, html_options: { id: "task_assignee_id" }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-36">
        <%= render(Ui::FieldComponent.new(id: "task_task_category_id")) do |field| %>
          <% field.with_label { t(".category_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "task[task_category_id]",
                  options: [ [ "—", "" ] ] + task_category_options,
                  selected: task.task_category_id, html_options: { id: "task_task_category_id" }) %>
          <% end %>
        <% end %>
      </div>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
    </div>
  <% end %>
<% end %>
