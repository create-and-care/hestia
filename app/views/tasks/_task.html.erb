<%= tag.div id: dom_id(task), data: { sortable_id: task.id },
      class: "rounded-lg border border-primary bg-container p-3 #{'opacity-60' if task.done}" do %>
  <div class="flex items-start gap-2">
    <div class="mt-0.5 flex shrink-0 items-center gap-0.5">
      <span data-sortable-handle class="cursor-grab select-none text-subdued hover:text-secondary" title="<%= t('.move_title') %>"><%= lucide_icon("grip-vertical", css_class: "size-4") %></span>
      <%# Reorder gutter: 36px each would double the row height, so this pair
          takes the WCAG AA floor (24px) instead and says so — see
          touchFloorFor in script/visual_check/measure.js. %>
      <div class="flex flex-col" data-touch-target="compact">
        <%= button_to move_up_task_path(task), method: :patch,
              class: "flex size-6 items-center justify-center cursor-pointer text-subdued hover:text-primary", aria: { label: t(".move_up_aria") } do %><%= lucide_icon("chevron-up", css_class: "size-3") %><% end %>
        <%= button_to move_down_task_path(task), method: :patch,
              class: "flex size-6 items-center justify-center cursor-pointer text-subdued hover:text-primary", aria: { label: t(".move_down_aria") } do %><%= lucide_icon("chevron-down", css_class: "size-3") %><% end %>
      </div>
    </div>
    <%= button_to toggle_task_path(task), method: :patch, class: "mt-0.5 shrink-0 cursor-pointer",
          aria: { label: task.done ? t(".reopen_aria") : t(".complete_aria") } do %>
      <span class="flex size-5 items-center justify-center rounded border <%= task.done ? "border-button-primary bg-button-primary text-inverse" : "border-primary" %>">
        <%= lucide_icon("check", css_class: "size-3.5") if task.done %>
      </span>
    <% end %>

    <div class="min-w-0 flex-1">
      <p class="<%= "text-subdued line-through" if task.done %>">
        <%= "#{task.emoji} " if task.emoji.present? %><%= task.title %>
      </p>
      <div class="mt-1 flex flex-wrap items-center gap-1 text-xs">
        <% if task.assignee %>
          <span class="flex items-center gap-1 text-secondary">
            <%= render(Ui::AvatarComponent.new(alt: task.assignee.name.presence || task.assignee.email_address, size: :sm)) %>
            <%= task.assignee.name.presence || task.assignee.email_address %>
          </span>
        <% end %>
        <% unless task.due_status == :none %>
          <%= render(Ui::BadgeComponent.new(variant: due_badge_variant(task.due_status))) { due_label(task.due_status) } %>
        <% end %>
        <%# Only in the agenda, where the grouping is by due date — on the board
            the column heading already says which category this is. %>
        <% if local_assigns[:show_category] && task.task_category %>
          <%= render(Ui::BadgeComponent.new(variant: :secondary)) { task.task_category.name } %>
        <% end %>
        <% if local_assigns[:show_category] && task.due_on %>
          <span class="text-subdued"><%= l(task.due_on, format: :short) %></span>
        <% end %>
      </div>
    </div>

    <div class="flex shrink-0 flex-col items-end gap-1">
      <%= render(Ui::DialogComponent.new(close_on_submit: true)) do |dialog| %>
        <% dialog.with_trigger do %>
          <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon,
                html_options: { class: "size-auto p-0.5", aria: { label: t(".edit_aria") } })) { lucide_icon("pencil", css_class: "size-4") } %>
        <% end %>
        <% dialog.with_title { t("tasks.edit.title") } %>
        <%= turbo_frame_tag dom_id(task, :edit), src: edit_task_path(task), loading: :lazy do %>
          <%= render "shared/frame_skeleton", label: t(".edit_loading"), rows: 3 %>
        <% end %>
      <% end %>
      <%= render(Ui::AlertDialogComponent.new(title: t(".delete_confirm"), confirm_label: t(".delete_label"),
            confirm_url: task_path(task), confirm_method: :delete)) do |alert_dialog| %>
        <% alert_dialog.with_trigger do %>
          <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon,
                html_options: { class: "size-auto p-0.5", aria: { label: t(".delete_aria") } })) { lucide_icon("x", css_class: "size-4") } %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
