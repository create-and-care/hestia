<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= form_with model: @task, url: task_path(@task) do |form| %>
    <% if @task.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @task.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "task_title")) do |field| %>
        <% field.with_label { t(".title_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "task[title]", value: @task.title, invalid: @task.errors[:title].any?,
                html_options: { id: "task_title", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "task_description")) do |field| %>
        <% field.with_label { t(".description_label") } %>
        <% field.with_control do %>
          <%= render(Ui::TextareaComponent.new(name: "task[description]", rows: 3, invalid: @task.errors[:description].any?,
                html_options: { id: "task_description" })) { @task.description } %>
        <% end %>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <%= render(Ui::FieldComponent.new(id: "task_emoji")) do |field| %>
          <% field.with_label { t(".emoji_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(name: "task[emoji]", value: @task.emoji, invalid: @task.errors[:emoji].any?,
                  html_options: { id: "task_emoji", maxlength: 4 }) %>
          <% end %>
        <% end %>

        <%= render(Ui::FieldComponent.new(id: "task_due_on")) do |field| %>
          <% field.with_label { t(".due_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "date", name: "task[due_on]", value: @task.due_on, invalid: @task.errors[:due_on].any?,
                  html_options: { id: "task_due_on" }) %>
          <% end %>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <%= render(Ui::FieldComponent.new(id: "task_assignee_id")) do |field| %>
          <% field.with_label { t(".assignee_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "task[assignee_id]",
                  options: [ [ "—", "" ] ] + task_assignee_options,
                  selected: @task.assignee_id, invalid: @task.errors[:assignee_id].any?,
                  html_options: { id: "task_assignee_id" }) %>
          <% end %>
        <% end %>

        <%= render(Ui::FieldComponent.new(id: "task_task_category_id")) do |field| %>
          <% field.with_label { t(".category_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "task[task_category_id]",
                  options: [ [ "—", "" ] ] + task_category_options,
                  selected: @task.task_category_id, invalid: @task.errors[:task_category_id].any?,
                  html_options: { id: "task_task_category_id" }) %>
          <% end %>
        <% end %>
      </div>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
    </div>
  <% end %>

  <section class="mt-8 border-t border-primary pt-6">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("bell", css_class: "size-5") %> <%= t(".reminders_heading") %></h2>
    <div class="mb-3 divide-y divide-primary rounded-lg border border-primary">
      <% @task.task_reminders.order(:remind_at).each do |reminder| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title do %>
            <%= reminder.remind_at.strftime("%d/%m/%Y %H:%M") %>
            <span class="text-subdued">· <%= reminder.user.name.presence || reminder.user.email_address %></span>
            <% if reminder.delivered_at %><span class="text-subdued">· <%= t(".sent") %></span><% end %>
          <% end %>
          <% item.with_trailing do %>
            <%= form_with url: task_task_reminder_path(@task, reminder), method: :delete,
                  data: { turbo_confirm: t(".delete_reminder_confirm") } do %>
              <button type="submit" class="cursor-pointer text-subdued hover:text-destructive" aria-label="<%= t(".delete_reminder_aria") %>">
                <%= lucide_icon("x", css_class: "size-4") %>
              </button>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%= form_with model: TaskReminder.new, url: task_task_reminders_path(@task), class: "flex flex-wrap items-end gap-2" do |form| %>
      <div>
        <%= render(Ui::FieldComponent.new(id: "task_reminder_remind_at")) do |field| %>
          <% field.with_label { t(".remind_at_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "datetime-local", name: "task_reminder[remind_at]",
                  html_options: { id: "task_reminder_remind_at", required: true }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "task_reminder_user_id")) do |field| %>
          <% field.with_label { t(".recipient_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "task_reminder[user_id]", options: task_assignee_options,
                  html_options: { id: "task_reminder_user_id" }) %>
          <% end %>
        <% end %>
      </div>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add_reminder_submit") } %>
    <% end %>
  </section>

  <p class="mt-6 text-sm"><%= link_to t(".back_link"), tasks_path, class: "underline" %></p>
</div>
