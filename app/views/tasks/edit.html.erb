<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:tasks, [ t(".heading"), nil ], module_path: tasks_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= turbo_frame_tag dom_id(@task, :edit) do %>
    <%= render "form_fields", task: @task %>
    <% if turbo_frame_request? %>
      <p class="mt-4 text-sm">
        <%= link_to t(".more_options_link"), edit_task_path(@task), data: { turbo_frame: "_top" }, class: "underline" %>
      </p>
    <% end %>
  <% end %>

  <section class="mt-8 border-t border-primary pt-6">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("bell", css_class: "size-5") %> <%= t(".reminders_heading") %></h2>
    <div class="mb-3 divide-y divide-primary rounded-lg border border-primary">
      <% @task.task_reminders.order(:remind_at).each do |reminder| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title do %>
            <%= l(reminder.remind_at, format: :numeric) %>
            <span class="text-subdued">· <%= reminder.user.name.presence || reminder.user.email_address %></span>
            <% if reminder.delivered_at %><span class="text-subdued">· <%= t(".sent") %></span><% end %>
          <% end %>
          <% item.with_trailing do %>
            <%= form_with url: task_task_reminder_path(@task, reminder), method: :delete,
                  data: { turbo_confirm: t(".delete_reminder_confirm") } do %>
              <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit",
                    html_options: { aria: { label: t(".delete_reminder_aria") } })) { lucide_icon("x", css_class: "size-4") } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%= form_with model: TaskReminder.new, url: task_task_reminders_path(@task), class: "flex flex-wrap items-end gap-2" do |form| %>
      <div>
        <%= render(Ui::FieldComponent.new(id: "task_reminder_remind_at")) do |field| %>
          <% field.with_label { t(".remind_at_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "datetime-local", name: "task_reminder[remind_at]",
                  html_options: { id: "task_reminder_remind_at", required: true }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "task_reminder_user_id")) do |field| %>
          <% field.with_label { t(".recipient_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "task_reminder[user_id]", options: task_assignee_options,
                  html_options: { id: "task_reminder_user_id" }) %>
          <% end %>
        <% end %>
      </div>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add_reminder_submit") } %>
    <% end %>
  </section>

  <div class="mt-6"><%= render "conversations/discuss_button", subject: @task %></div>
</div>
