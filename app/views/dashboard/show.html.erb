<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <header class="mb-8 flex items-center justify-between">
    <div>
      <p class="text-sm text-gray-500"><%= t(".active_household") %></p>
      <h1 class="text-2xl font-semibold"><%= @household.name %></h1>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "🗺️ #{t('.roadmap')}", roadmap_path,
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
      <%= link_to "🔔 #{t('.preferences')}", notification_preference_path,
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
      <%= link_to "📱 #{t('.api_tokens')}", api_tokens_path,
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
      <%= button_to t(".sign_out"), session_path, method: :delete,
            class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <nav class="mb-8 flex flex-wrap gap-2">
    <%= link_to "🛒 #{t('.nav.shopping')}", shopping_lists_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "🧊 #{t('.nav.fridge')}", fridge_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "📖 #{t('.nav.recipes')}", recipes_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "✅ #{t('.nav.tasks')}", tasks_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm font-medium hover:bg-gray-50" %>
    <%= link_to "📅 #{t('.nav.calendar')}", calendar_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm font-medium hover:bg-gray-50" %>
  </nav>

  <nav class="mb-8 flex flex-wrap gap-2">
    <%= link_to "📝 #{t('.nav.notes')}", notes_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🎂 #{t('.nav.birthdays')}", contacts_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "📍 #{t('.nav.addresses')}", addresses_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🧰 #{t('.nav.service_providers')}", service_providers_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "💳 #{t('.nav.loyalty')}", loyalty_cards_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🐾 #{t('.nav.pets')}", pets_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🚗 #{t('.nav.vehicles')}", vehicles_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🍷 #{t('.nav.wine_cellar')}", wine_cellars_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🗑 #{t('.nav.waste')}", waste_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "👶 #{t('.nav.baby')}", baby_profiles_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "💬 #{t('.nav.messages')}", conversations_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🍽 #{t('.nav.menu')}", menu_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🔁 #{t('.nav.routines')}", routines_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🌳 #{t('.nav.outdoor')}", exterior_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "💶 #{t('.nav.budget')}", budget_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "📄 #{t('.nav.documents')}", documents_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🎁 #{t('.nav.gifts')}", gift_lists_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "👥 #{t('.nav.circles')}", circles_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🧳 #{t('.nav.trips')}", trips_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= link_to "🧘 #{t('.nav.wellbeing')}", wellbeing_path,
          class: "rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50" %>
  </nav>

  <section class="mb-8 rounded-lg border border-gray-200 p-5">
    <h2 class="mb-1 font-medium"><%= t(".invite_member") %></h2>
    <p class="mb-3 text-sm text-gray-600"><%= t(".invite_description") %></p>
    <code class="rounded-md bg-gray-100 px-3 py-2 text-lg font-semibold tracking-widest"><%= @household.invite_code %></code>
  </section>

  <section class="mb-8">
    <h2 class="mb-3 font-medium"><%= t(".members", count: @memberships.size) %></h2>
    <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @memberships.each do |membership| %>
        <li class="flex items-center justify-between px-4 py-3">
          <div>
            <p class="font-medium"><%= membership.user.name.presence || membership.user.email_address %></p>
            <p class="text-sm text-gray-500"><%= membership.user.email_address %></p>
          </div>
          <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">
            <%= membership.admin? ? t(".admin") : t(".member") %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>

  <% if @other_households.any? %>
    <section class="mb-8">
      <h2 class="mb-3 font-medium"><%= t(".switch_household") %></h2>
      <ul class="space-y-2">
        <% @other_households.each do |household| %>
          <li>
            <%= button_to t(".switch_to", name: household.name), activate_household_path(household), method: :patch,
                  class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="flex gap-4 text-sm">
    <%= link_to t(".create_household"), new_household_path, class: "underline" %>
    <%= link_to t(".join_household"), new_membership_path, class: "underline" %>
  </section>
</div>
