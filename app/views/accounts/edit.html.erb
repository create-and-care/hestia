<% content_for :title, t(".title") %>

<div class="mt-10 max-w-md mx-auto px-4 pb-16">
  <div class="mb-4"><%= render Ui::BreadcrumbComponent.new(items: [ [ t("common.dashboard"), root_path ], [ Current.household.name, household_path(Current.household, tab: "members") ], [ t(".heading"), nil ] ]) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with model: @user, url: account_path, method: :patch do |form| %>
    <% if @user.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "user_name")) do |field| %>
        <% field.with_label { t(".name") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "user[name]", value: @user.name,
                html_options: { id: "user_name", required: true, autocomplete: "name" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "user_email_address")) do |field| %>
        <% field.with_label { t(".email") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "email", name: "user[email_address]", value: @user.email_address,
                html_options: { id: "user_email_address", required: true, autocomplete: "username" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "user_avatar_tint")) do |field| %>
        <% field.with_label { t(".avatar_tint") } %>
        <% field.with_control do %>
          <div class="flex items-center gap-3">
            <%= render Ui::AvatarComponent.new(alt: @user.name.presence || @user.email_address, tint: @user.avatar_tint) %>
            <%= render Ui::NativeSelectComponent.new(name: "user[avatar_tint]", selected: @user.avatar_tint,
                  options: [ [ t(".avatar_tint_auto"), "" ] ] + Ui::AvatarComponent::MODULES.map { |mod| [ t(".avatar_tint_modules.#{mod}"), mod.to_s ] },
                  html_options: { id: "user_avatar_tint" }) %>
          </div>
        <% end %>
      <% end %>

      <div class="border-t border-primary pt-4">
        <p class="mb-1 text-sm font-medium text-primary"><%= t(".password_section") %></p>
        <p class="mb-3 text-xs text-secondary"><%= t(".password_section_description") %></p>

        <div class="space-y-4">
          <%= render(Ui::FieldComponent.new(id: "user_password")) do |field| %>
            <% field.with_label { t(".password") } %>
            <% field.with_control do %>
              <%= render Ui::InputComponent.new(type: "password", name: "user[password]",
                    html_options: { id: "user_password", autocomplete: "new-password", maxlength: 72, minlength: 8 }) %>
            <% end %>
          <% end %>

          <%= render(Ui::FieldComponent.new(id: "user_password_confirmation")) do |field| %>
            <% field.with_label { t(".password_confirmation") } %>
            <% field.with_control do %>
              <%= render Ui::InputComponent.new(type: "password", name: "user[password_confirmation]",
                    html_options: { id: "user_password_confirmation", autocomplete: "new-password", maxlength: 72 }) %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="border-t border-primary pt-4">
        <%= render(Ui::FieldComponent.new(id: "user_current_password")) do |field| %>
          <% field.with_label { t(".current_password") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "password", name: "user[current_password]",
                  html_options: { id: "user_current_password", required: true, autocomplete: "current-password" }) %>
          <% end %>
        <% end %>
        <p class="mt-1 text-xs text-secondary"><%= t(".current_password_hint") %></p>
      </div>

      <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t(".submit") } %>
    </div>
  <% end %>

  <section class="mt-8">
    <h2 class="mb-3 font-medium"><%= t("wellbeing.show.my_profile") %></h2>
    <%= render(Ui::CardComponent.new) do %>
      <%= form_with model: @profile, url: wellbeing_profile_path, method: :patch, class: "grid grid-cols-2 gap-3 sm:grid-cols-3" do |form| %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:height))) do |field| %>
          <% field.with_label { t("wellbeing.show.height_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:height), value: form.object.height, html_options: { id: form.field_id(:height) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:age))) do |field| %>
          <% field.with_label { t("wellbeing.show.age_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:age), value: form.object.age, html_options: { id: form.field_id(:age) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:sex))) do |field| %>
          <% field.with_label { t("wellbeing.show.sex_label") } %>
          <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:sex), options: [ [ "—", "" ] ] + sex_options, selected: form.object.sex, html_options: { id: form.field_id(:sex) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:activity_level))) do |field| %>
          <% field.with_label { t("wellbeing.show.activity_label") } %>
          <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:activity_level), options: [ [ "—", "" ] ] + activity_options, selected: form.object.activity_level, html_options: { id: form.field_id(:activity_level) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:start_weight))) do |field| %>
          <% field.with_label { t("wellbeing.show.start_weight_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:start_weight), value: form.object.start_weight, html_options: { id: form.field_id(:start_weight), step: :any }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:goal_weight))) do |field| %>
          <% field.with_label { t("wellbeing.show.goal_weight_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:goal_weight), value: form.object.goal_weight, placeholder: t("wellbeing.show.goal_weight_placeholder"), html_options: { id: form.field_id(:goal_weight), step: :any }) } %>
        <% end %>
        <div class="col-span-2 sm:col-span-3"><%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, type: "submit")) { t("wellbeing.show.save_profile") } %></div>
      <% end %>
    <% end %>
  </section>

</div>
