<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with model: @household, url: households_path do |form| %>
    <% if @household.errors.any? %>
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-inside list-disc">
          <% @household.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= form.label :name, t(".name_label"), class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :name, required: true, autofocus: true, placeholder: t(".name_placeholder"),
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <%= form.submit t(".submit"), class: "w-full cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-gray-600">
    <%= link_to t(".back"), onboarding_path, class: "underline" %>
  </p>
</div>
