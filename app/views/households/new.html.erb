<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with model: @household, url: households_path do |form| %>
    <% if @household.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @household.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "household_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "household[name]", value: @household.name, placeholder: t(".name_placeholder"),
                html_options: { id: "household_name", required: true, autofocus: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t(".submit") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-secondary">
    <%= link_to t(".back"), onboarding_path, class: "underline" %>
  </p>
</div>
