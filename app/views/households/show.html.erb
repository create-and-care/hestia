<% content_for :title, @household.name %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= render Ui::BreadcrumbComponent.new(items: [ [ t("common.dashboard"), root_path ], [ t(".household"), nil ] ]) %></div>

  <header class="mb-8">
    <p class="text-sm text-secondary"><%= t(".household") %></p>
    <h1 class="text-2xl font-semibold"><%= @household.name %></h1>
  </header>

  <%= render "shared/flash" %>

  <%= render(Ui::TabsComponent.new(default: @default_tab)) do |tabs| %>
    <% tabs.with_tab(label: t(".tabs.general"), value: "general") do %>
      <div class="space-y-8">
        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".invite_code") } %>
          <% card.with_description { t(".invite_code_description") } %>
          <div class="flex items-center gap-2">
            <code class="rounded-md bg-surface-inset px-3 py-2 text-lg font-semibold tracking-widest"><%= @household.invite_code %></code>
            <% if current_membership&.admin? %>
              <%= render(Ui::AlertDialogComponent.new(title: t(".regenerate_code_confirm_title"), description: t(".regenerate_code_confirm_description"),
                    confirm_label: t(".regenerate_code"), confirm_url: regenerate_invite_code_household_path(@household), confirm_variant: :outline)) do |alert_dialog| %>
                <% alert_dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { t(".regenerate_code") } } %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".language") } %>
          <%= render "shared/locale_switcher" %>
        <% end %>

        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".theme_heading") } %>
          <% card.with_description { t(".theme_description") } %>
          <%= render Ui::ThemeToggleComponent.new %>
        <% end %>

        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".time_zone_heading") } %>
          <%= form_with model: @household, url: household_path(@household), method: :patch do |form| %>
            <div class="flex items-end gap-3">
              <div class="flex-1">
                <%= render(Ui::FieldComponent.new(id: "household_time_zone")) do |field| %>
                  <% field.with_label { t(".time_zone_label") } %>
                  <% field.with_control do %>
                    <%= render Ui::NativeSelectComponent.new(name: "household[time_zone]", selected: @household.time_zone,
                          options: ActiveSupport::TimeZone.all.map { |zone| [ zone.to_s, zone.name ] },
                          html_options: { id: "household_time_zone" }) %>
                  <% end %>
                <% end %>
              </div>
              <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".time_zone_submit") } %>
            </div>
          <% end %>
        <% end %>

        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".default_view_heading") } %>
          <% card.with_description { t(".default_view_description") } %>
          <%= form_with model: @household, url: household_path(@household), method: :patch, class: "flex items-end gap-3" do |form| %>
            <%= render Ui::ToggleGroupComponent.new(name: "household[default_view]", items: [
                  [ t(".default_view_list"), "list", @household.default_view == "list" ],
                  [ t(".default_view_grid"), "grid", @household.default_view == "grid" ]
                ]) %>
            <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".default_view_submit") } %>
          <% end %>
        <% end %>

        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".required_meal_types_heading") } %>
          <% card.with_description { t(".required_meal_types_description") } %>
          <%= form_with model: @household, url: household_path(@household), method: :patch, class: "space-y-4" do |form| %>
            <div class="flex flex-wrap gap-4">
              <% MealPlanEntry::MEAL_TYPES.without("free").each do |type| %>
                <div class="flex items-center gap-2 text-sm">
                  <%= render Ui::CheckboxComponent.new(name: "household[required_meal_types][]",
                        checked: @household.required_meal_types.include?(type),
                        id: "required_meal_type_#{type}", html_options: { value: type }) %>
                  <%= render(Ui::LabelComponent.new(for_id: "required_meal_type_#{type}")) { meal_type_label(type) } %>
                </div>
              <% end %>
              <%= hidden_field_tag "household[required_meal_types][]", "" %>
            </div>
            <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".required_meal_types_submit") } %>
          <% end %>
        <% end %>

        <% if current_membership&.admin? %>
          <%= render(Ui::CardComponent.new(class_name: "border-destructive")) do |card| %>
            <% card.with_title { t(".danger_zone") } %>
            <% card.with_description { t(".delete_household_description") } %>
            <%= render(Ui::AlertDialogComponent.new(title: t(".delete_household_confirm_title"), description: t(".delete_household_confirm_description"),
                  confirm_label: t(".delete_household"), confirm_url: household_path(@household), confirm_method: :delete)) do |alert_dialog| %>
              <% alert_dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :destructive, size: :sm)) { t(".delete_household") } } %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% tabs.with_tab(label: t(".tabs.members"), value: "members") do %>
      <div class="space-y-8">
        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".members", count: @memberships.size) } %>
          <ul class="divide-y divide-primary rounded-lg border border-primary">
            <% @memberships.each do |membership| %>
              <li>
                <%= render(Ui::ItemComponent.new) do |item| %>
                  <% item.with_leading { render(Ui::AvatarComponent.new(alt: membership.user.name.presence || membership.user.email_address, tint: membership.user.avatar_tint)) } %>
                  <% item.with_title { membership.user.name.presence || membership.user.email_address } %>
                  <% item.with_description { membership.admin? ? t(".admin") : t(".member") } %>
                  <% if current_membership&.admin? && membership.user != Current.user %>
                    <% item.with_trailing do %>
                      <div class="flex shrink-0 items-center gap-2">
                        <%= form_with url: household_member_path(@household, membership), method: :patch, class: "inline" do %>
                          <input type="hidden" name="role" value="<%= membership.admin? ? "member" : "admin" %>">
                          <%= render(Ui::ButtonComponent.new(type: "submit", variant: :outline, size: :sm)) { membership.admin? ? t(".demote") : t(".promote") } %>
                        <% end %>
                        <%= form_with url: household_member_path(@household, membership), method: :delete, data: { turbo_confirm: t(".remove_member_confirm", name: membership.user.name.presence || membership.user.email_address) } do %>
                          <%= render(Ui::ButtonComponent.new(variant: :destructive, size: :sm, type: "submit")) { t(".remove_member") } %>
                        <% end %>
                      </div>
                    <% end %>
                  <% elsif membership.user == Current.user %>
                    <% item.with_trailing do %>
                      <div class="flex shrink-0 items-center gap-2">
                        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: edit_account_path)) { t(".edit_account") } %>
                        <%= form_with url: household_member_path(@household, membership), method: :delete, data: { turbo_confirm: t(".leave_confirm") } do %>
                          <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".leave") } %>
                        <% end %>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <% if @other_households.any? %>
          <%= render(Ui::CardComponent.new) do |card| %>
            <% card.with_title { t(".switch_household") } %>
            <ul class="space-y-2">
              <% @other_households.each do |household| %>
                <li>
                  <%= render(Ui::ButtonToComponent.new(activate_household_path(household), method: :patch, variant: :outline, size: :sm)) { t(".switch_to", name: household.name) } %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>

        <%= render(Ui::CardComponent.new) do |card| %>
          <% card.with_title { t(".other_households") } %>
          <div class="flex gap-3">
            <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: new_household_path)) { t(".create_household") } %>
            <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: new_membership_path)) { t(".join_household") } %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% tabs.with_tab(label: t(".tabs.notifications"), value: "notifications") do %>
      <%= render(Ui::CardComponent.new) do |card| %>
        <% card.with_title do %>
          <span class="inline-flex items-center gap-1.5"><%= lucide_icon("bell", css_class: "size-5") %> <%= t("notification_preferences.show.title") %></span>
        <% end %>
        <% card.with_description { t("notification_preferences.show.description") } %>

        <%= form_with model: @notification_preference, url: notification_preference_path, method: :patch, class: "space-y-5" do |form| %>
          <div class="flex items-center gap-2">
            <%= render Ui::CheckboxComponent.new(name: "notification_preference[fridge_expiry_enabled]",
                  checked: @notification_preference.fridge_expiry_enabled, id: "notification_preference_fridge_expiry_enabled") %>
            <%= render(Ui::LabelComponent.new(for_id: "notification_preference_fridge_expiry_enabled")) { t("notification_preferences.show.fridge_expiry_enabled") } %>
          </div>

          <%= render(Ui::FieldComponent.new(id: "notification_preference_fridge_expiry_threshold_days")) do |field| %>
            <% field.with_label { t("notification_preferences.show.fridge_expiry_threshold_days") } %>
            <% field.with_control do %>
              <%= render Ui::InputComponent.new(type: "number", name: "notification_preference[fridge_expiry_threshold_days]",
                    value: @notification_preference.fridge_expiry_threshold_days,
                    html_options: { id: "notification_preference_fridge_expiry_threshold_days", min: 0, max: 14, class: "w-24" }) %>
            <% end %>
          <% end %>

          <div class="flex items-center gap-2">
            <%= render Ui::CheckboxComponent.new(name: "notification_preference[birthday_notifications_enabled]",
                  checked: @notification_preference.birthday_notifications_enabled, id: "notification_preference_birthday_notifications_enabled") %>
            <%= render(Ui::LabelComponent.new(for_id: "notification_preference_birthday_notifications_enabled")) { t("notification_preferences.show.birthday_notifications_enabled") } %>
          </div>

          <div class="flex items-center gap-2">
            <%= render Ui::CheckboxComponent.new(name: "notification_preference[plant_care_enabled]",
                  checked: @notification_preference.plant_care_enabled, id: "notification_preference_plant_care_enabled") %>
            <%= render(Ui::LabelComponent.new(for_id: "notification_preference_plant_care_enabled")) { t("notification_preferences.show.plant_care_enabled") } %>
          </div>

          <%= render(Ui::FieldComponent.new(id: "notification_preference_plant_care_threshold_days")) do |field| %>
            <% field.with_label { t("notification_preferences.show.plant_care_threshold_days") } %>
            <% field.with_control do %>
              <%= render Ui::InputComponent.new(type: "number", name: "notification_preference[plant_care_threshold_days]",
                    value: @notification_preference.plant_care_threshold_days,
                    html_options: { id: "notification_preference_plant_care_threshold_days", min: 0, max: 14, class: "w-24" }) %>
            <% end %>
          <% end %>

          <%= render(Ui::ButtonComponent.new(type: "submit")) { t("notification_preferences.show.save") } %>
        <% end %>
      <% end %>
    <% end %>

    <% tabs.with_tab(label: t(".tabs.api"), value: "api") do %>
      <%= render(Ui::CardComponent.new) do |card| %>
        <% card.with_title do %>
          <span class="inline-flex items-center gap-1.5"><%= lucide_icon("smartphone", css_class: "size-5") %> <%= t("api_tokens.index.title") %></span>
        <% end %>
        <% card.with_description { t("api_tokens.index.description") } %>

        <% if flash[:api_token] %>
          <%= render(Ui::AlertComponent.new(variant: :success, class_name: "mb-4")) do |alert| %>
            <% alert.with_title { t("api_tokens.index.token_created_title") } %>
            <p class="mb-2"><%= t("api_tokens.index.token_created_description") %></p>
            <div class="flex items-center gap-2">
              <code id="new_api_token" class="flex-1 truncate rounded-md bg-surface-inset px-3 py-2 font-mono text-sm"><%= flash[:api_token] %></code>
              <%= render(Ui::CopyButtonComponent.new(value: flash[:api_token], label: t("api_tokens.index.copy"),
                    message: t("api_tokens.index.copied"), html_options: { class: "shrink-0" })) %>
            </div>
          <% end %>
        <% end %>

        <% if @api_tokens.any? %>
          <ul class="mb-4 divide-y divide-primary rounded-lg border border-primary">
            <% @api_tokens.each do |token| %>
              <li>
                <%= render(Ui::ItemComponent.new) do |item| %>
                  <% item.with_title { token.name } %>
                  <% item.with_description do %>
                    <%= t("api_tokens.index.created_on") %> <%= l(token.created_at.to_date, format: :numeric) %>
                    <% if token.last_used_at %> · <%= t("api_tokens.index.last_used_on") %> <%= l(token.last_used_at.to_date, format: :numeric) %><% end %>
                    · <%= token.expires_at ? t("api_tokens.index.expires_on", date: l(token.expires_at.to_date, format: :numeric)) : t("api_tokens.index.never_expires") %>
                  <% end %>
                  <% item.with_trailing do %>
                    <%= form_with url: api_token_path(token), method: :delete, data: { turbo_confirm: t("api_tokens.index.revoke_confirm") } do %>
                      <%= render(Ui::ButtonComponent.new(variant: :destructive, size: :sm, type: "submit")) { t("api_tokens.index.revoke") } %>
                    <% end %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="mb-4"><%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t("api_tokens.index.empty") } } %></div>
        <% end %>

        <%= form_with model: @api_token, url: api_tokens_path, class: "flex flex-wrap items-end gap-2" do |form| %>
          <div class="flex-1">
            <%= render(Ui::FieldComponent.new(id: "api_token_name")) do |field| %>
              <% field.with_label { t("api_tokens.index.name_label") } %>
              <% field.with_control do %>
                <%= render Ui::InputComponent.new(name: "api_token[name]", html_options: { id: "api_token_name", required: true }) %>
              <% end %>
            <% end %>
          </div>
          <div class="w-40">
            <%= render(Ui::FieldComponent.new(id: "api_token_expires_in")) do |field| %>
              <% field.with_label { t("api_tokens.index.expires_in_label") } %>
              <% field.with_control do %>
                <%= render Ui::NativeSelectComponent.new(name: "api_token[expires_in]", selected: "90", html_options: { id: "api_token_expires_in" },
                      options: [ [ t("api_tokens.index.expires_in_30"), "30" ], [ t("api_tokens.index.expires_in_90"), "90" ],
                                 [ t("api_tokens.index.expires_in_365"), "365" ] ]) %>
              <% end %>
            <% end %>
          </div>
          <%= render(Ui::ButtonComponent.new(type: "submit")) { t("api_tokens.index.create") } %>
        <% end %>
      <% end %>
    <% end %>

    <% tabs.with_tab(label: t(".tabs.sessions"), value: "sessions") do %>
      <%= render(Ui::CardComponent.new) do |card| %>
        <% card.with_title do %>
          <span class="inline-flex items-center gap-1.5"><%= lucide_icon("smartphone", css_class: "size-5") %> <%= t(".sessions_heading") %></span>
        <% end %>
        <% card.with_description { t(".sessions_description") } %>

        <ul class="divide-y divide-primary rounded-lg border border-primary">
          <% @sessions.each do |session| %>
            <li>
              <%= render(Ui::ItemComponent.new) do |item| %>
                <% item.with_title { session.user_agent.presence || t(".unknown_device") } %>
                <% item.with_description do %>
                  <%= session.ip_address %> · <%= t(".last_active_on") %> <%= l(session.updated_at, format: :numeric) %>
                <% end %>
                <% item.with_trailing do %>
                  <% if session == Current.session %>
                    <%= render(Ui::BadgeComponent.new(variant: :secondary)) { t(".this_device") } %>
                  <% else %>
                    <%= form_with url: active_session_path(session), method: :delete, data: { turbo_confirm: t(".revoke_session_confirm") } do %>
                      <%= render(Ui::ButtonComponent.new(variant: :destructive, size: :sm, type: "submit")) { t(".revoke") } %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <% tabs.with_tab(label: t(".tabs.modules"), value: "modules") do %>
      <%= render(Ui::CardComponent.new) do |card| %>
        <% card.with_title do %>
          <span class="inline-flex items-center gap-1.5"><%= lucide_icon("puzzle", css_class: "size-5") %> <%= t(".modules_heading") %></span>
        <% end %>
        <% card.with_description { t(".modules_description") } %>

        <% unless current_membership&.admin? %>
          <%= render(Ui::AlertComponent.new(variant: :warning, class_name: "mb-4")) { t(".modules_admin_only") } %>
        <% end %>

        <%= form_with model: @household, url: update_modules_household_path(@household), method: :patch, class: "space-y-6" do |form| %>
          <% SidebarHelper::SIDEBAR_GROUPS.each do |group| %>
            <div>
              <h3 class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-secondary"><%= lucide_icon(group[:icon], css_class: "size-4") %> <%= t("sidebar.groups.#{group[:key]}") %></h3>
              <ul class="divide-y divide-primary rounded-lg border border-primary overflow-hidden">
                <% group[:items].each do |icon, nav_key, _path| %>
                  <li>
                    <%= render(Ui::ItemComponent.new) do |item| %>
                      <% item.with_leading { lucide_icon(icon, css_class: "size-4") } %>
                      <% item.with_title { tag.span(t("dashboard.show.nav.#{nav_key}"), id: "module_label_#{nav_key}") } %>
                      <% item.with_trailing do %>
                        <%= render Ui::SwitchComponent.new(
                              name: "household[enabled_modules][]",
                              checked: @household.module_enabled?(nav_key),
                              disabled: !current_membership&.admin?,
                              html_options: { value: nav_key.to_s, aria: { labelledby: "module_label_#{nav_key}" } }
                            ) %>
                      <% end %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <h3 class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-secondary"><%= lucide_icon("waves", css_class: "size-4") %> <%= t(".pool_heading") %></h3>
            <ul class="divide-y divide-primary rounded-lg border border-primary overflow-hidden">
              <li>
                <%= render(Ui::ItemComponent.new) do |item| %>
                  <% item.with_leading { lucide_icon("waves", css_class: "size-4") } %>
                  <% item.with_title { tag.span(t(".pool_label"), id: "module_label_pool") } %>
                  <% item.with_trailing do %>
                    <%= hidden_field_tag "household[pool_enabled]", "0" %>
                    <%= render Ui::SwitchComponent.new(
                          name: "household[pool_enabled]",
                          checked: @household.pool_enabled,
                          disabled: !current_membership&.admin?,
                          html_options: { value: "1", aria: { labelledby: "module_label_pool" } }
                        ) %>
                  <% end %>
                <% end %>
              </li>
            </ul>
            <p class="mt-2 text-xs text-secondary"><%= t(".pool_description") %></p>
          </div>

          <% if current_membership&.admin? %>
            <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".modules_submit") } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% tabs.with_tab(label: t(".tabs.roadmap"), value: "roadmap") do %>
      <%= render "roadmap/content", milestones: @milestones %>
    <% end %>
  <% end %>

</div>
