<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:shopping) %></div>

  <header class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold"><%= t(".heading") %></h1>
    <div class="flex gap-2">
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: products_path)) { t(".catalog_link") } %>
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_shopping_list_path)) { t(".new_list") } %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <% if @shopping_lists.any? %>
    <%# overflow-hidden, or the first/last row's own rounded-md hover background
        sits inside the container's larger rounded-lg corner and the list reads as
        being rounded twice over. Same treatment as the calendar grid. %>
    <div class="overflow-hidden rounded-lg border border-primary divide-y divide-primary">
      <% @shopping_lists.each do |list| %>
        <%= render(Ui::ItemComponent.new(href: shopping_list_path(list))) do |item| %>
          <% item.with_leading { list.icon.presence || lucide_icon("shopping-cart", css_class: "size-4") } %>
          <% item.with_title { list.name } %>
          <% item.with_trailing do %>
            <%# Counted in Ruby over the preloaded items: `items.where(...).count`
                ignores the preload and issues a query per list (PERF-06).
                `.to_a` first, deliberately: Bullet prepends CollectionProxy#count
                with `def count(column_name = nil)` and flags "Need Counter Cache"
                before it ever looks at the block, so the proxy form reported a
                phantom N+1 on a call that runs entirely in memory. A counter
                cache couldn't serve this line anyway — it counts *unchecked*
                items, and a cached column counts all of them. %>
            <span class="text-sm text-secondary"><%= t(".items_count", count: list.items.to_a.count { |item| !item.checked? }) %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".empty") } } %>
  <% end %>
</div>
