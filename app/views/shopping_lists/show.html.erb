<% content_for :title, @shopping_list.name %>
<%= turbo_stream_from @shopping_list %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:shopping, [ @shopping_list.name, nil ], module_path: shopping_lists_path) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold">
      <span><%= @shopping_list.icon.presence || lucide_icon("shopping-cart", css_class: "size-6") %></span>
      <span><%= @shopping_list.name %></span>
    </h1>
    <div class="flex gap-2">
      <% if @shopping_list.items.where(checked: true).any? %>
        <%= form_with url: clear_checked_shopping_list_items_path(@shopping_list), method: :delete,
              data: { turbo_confirm: t(".clear_checked_confirm") } do %>
          <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, type: "submit")) { t(".clear_checked") } %>
        <% end %>
      <% end %>
      <%= render "conversations/discuss_button", subject: @shopping_list %>
      <%# :secondary rather than :outline, with the glyph the rest of the app uses
          for an export. Among a ghost button and a solid destructive one, a
          transparent outline was the palest thing in the header and read as
          disabled — the export works on any list, empty ones included. %>
      <%= render(Ui::ButtonComponent.new(variant: :secondary, size: :sm, icon: "file-text",
            href: shopping_list_path(@shopping_list, format: :pdf),
            html_options: { target: "_blank" })) { t(".export_pdf") } %>
      <%= render(Ui::AlertDialogComponent.new(title: t(".delete_confirm"), confirm_label: t(".delete"),
            confirm_url: shopping_list_path(@shopping_list), confirm_method: :delete)) do |alert_dialog| %>
        <% alert_dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :destructive, size: :sm)) { t(".delete") } } %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <%= render "shopping_list_items/form", shopping_list: @shopping_list, item: @item %>

  <%# One bordered container with hairline separators — the design system's list
      recipe (same as shopping_lists#index and the household module toggles).
      Rows must stay direct children: this element is both the sortable root
      (sortable_controller reads this.element.children) and the target
      ShoppingListItem's broadcasts_to appends new rows to, so grouping them
      into per-rayon boxes would break drag-and-drop and real-time inserts. %>
  <div id="shopping_list_items" class="mt-6 divide-y divide-primary overflow-hidden rounded-lg border border-primary"
       data-controller="sortable" data-sortable-url-value="<%= reorder_shopping_list_items_path(@shopping_list) %>">
    <%= render "shopping_list_items/list", shopping_list: @shopping_list %>
  </div>
</div>
