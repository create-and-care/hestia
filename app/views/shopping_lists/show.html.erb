<% content_for :title, @shopping_list.name %>
<%= turbo_stream_from @shopping_list %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold">
      <span><%= @shopping_list.icon.presence || lucide_icon("shopping-cart", css_class: "size-6") %></span>
      <span><%= @shopping_list.name %></span>
    </h1>
    <div class="flex gap-2">
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: shopping_list_path(@shopping_list, format: :pdf),
            html_options: { target: "_blank" })) { t(".export_pdf") } %>
      <%= form_with url: shopping_list_path(@shopping_list), method: :delete,
            data: { turbo_confirm: t(".delete_confirm") } do %>
        <%= render(Ui::ButtonComponent.new(variant: :destructive, size: :sm, type: "submit")) { t(".delete") } %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <%= render "shopping_list_items/form", shopping_list: @shopping_list, item: @item %>

  <div id="shopping_list_items" class="mt-6 space-y-2"
       data-controller="sortable" data-sortable-url-value="<%= reorder_shopping_list_items_path(@shopping_list) %>">
    <%= render @shopping_list.items %>
  </div>

  <p class="mt-6 text-sm">
    <%= link_to t(".back_link"), shopping_lists_path, class: "underline" %>
  </p>
</div>
