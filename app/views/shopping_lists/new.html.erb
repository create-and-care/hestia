<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <div class="mb-4"><%= module_breadcrumb(:shopping, [ t(".title"), nil ], module_path: shopping_lists_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= form_with model: @shopping_list, url: shopping_lists_path do |form| %>
    <% if @shopping_list.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @shopping_list.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "shopping_list_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "shopping_list[name]", value: @shopping_list.name, placeholder: t(".name_placeholder"),
                html_options: { id: "shopping_list_name", required: true, autofocus: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "shopping_list_icon")) do |field| %>
        <% field.with_label { t(".icon_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "shopping_list[icon]", value: @shopping_list.icon, placeholder: "🛒",
                html_options: { id: "shopping_list_icon", maxlength: 4, class: "w-24" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t(".submit") } %>
    </div>
  <% end %>

</div>
