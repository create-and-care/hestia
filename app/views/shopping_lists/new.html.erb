<% content_for :title, "Nouvelle liste" %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold">Nouvelle liste de courses</h1>

  <%= form_with model: @shopping_list, url: shopping_lists_path do |form| %>
    <% if @shopping_list.errors.any? %>
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-inside list-disc">
          <% @shopping_list.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= form.label :name, "Nom", class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :name, required: true, autofocus: true, placeholder: "Drive du samedi",
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :icon, "Icône (emoji, optionnel)", class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :icon, placeholder: "🛒", maxlength: 4,
              class: "w-24 rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <%= form.submit "Créer la liste", class: "w-full cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-gray-600">
    <%= link_to "← Retour aux listes", shopping_lists_path, class: "underline" %>
  </p>
</div>
