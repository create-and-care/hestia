<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("bell", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex gap-3">
      <%= render(Ui::ButtonComponent.new(variant: :outline, href: household_path(Current.household))) { t(".preferences") } %>
      <%= form_with url: mark_all_read_notifications_path, method: :patch do %>
        <%= render(Ui::ButtonComponent.new(variant: :outline, type: "submit")) { t(".mark_all_read") } %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <% if @notifications.none? %>
    <%= render(Ui::EmptyComponent.new) do |empty| %>
      <% empty.with_icon { lucide_icon("bell", css_class: "size-8") } %>
      <% empty.with_description { t(".none") } %>
    <% end %>
  <% else %>
    <div class="divide-y divide-primary rounded-lg border border-primary">
      <% @notifications.each do |notification| %>
        <%= render "notifications/notification", notification: notification %>
      <% end %>
    </div>
  <% end %>
</div>
