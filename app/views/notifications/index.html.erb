<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-xl px-4">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("bell", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex gap-3 text-sm">
      <%= link_to t(".preferences"), household_path(Current.household), class: "underline" %>
      <%= button_to t(".mark_all_read"), mark_all_read_notifications_path, method: :patch, class: "cursor-pointer underline" %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200">
    <% if @notifications.none? %>
      <li class="px-4 py-6 text-center text-sm text-gray-400"><%= t(".none") %></li>
    <% end %>
    <% @notifications.each do |notification| %>
      <li class="px-3 py-1">
        <%= render "notifications/notification", notification: notification %>
      </li>
    <% end %>
  </ul>
</div>
