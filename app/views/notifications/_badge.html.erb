<% if count.to_i.positive? %>
  <span id="notifications_badge" class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-button-destructive px-1 text-[10px] font-semibold text-inverse">
    <%= count > 9 ? "9+" : count %>
  </span>
<% else %>
  <span id="notifications_badge"></span>
<% end %>
