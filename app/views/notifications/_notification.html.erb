<% path = notification_path(notification) %>
<%= tag.div id: dom_id(notification), class: ("rounded-md bg-surface" unless notification.read?) do %>
  <%= render(Ui::ItemComponent.new) do |item| %>
    <% item.with_leading { notification_icon(notification) } %>
    <% item.with_title do %>
      <%= path ? link_to(notification.title, path, class: "hover:underline") : notification.title %>
      <% if (modules_label = notification_modules_label(notification)) %><span class="font-normal text-secondary"><%= modules_label %></span><% end %>
    <% end %>
    <% item.with_description do %>
      <% if notification.body.present? %><%= notification.body %> · <% end %><%= time_ago_in_words(notification.created_at) %>
      <% if name_notification_household?(notification) %> · <%= notification.household.name %><% end %>
    <% end %>
    <% unless notification.read? %>
      <% item.with_trailing do %>
        <%= button_to mark_read_notification_path(notification), method: :patch,
              class: "cursor-pointer text-subdued hover:text-primary", aria: { label: t(".mark_read") } do %><%= lucide_icon("check", css_class: "size-4") %><% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
