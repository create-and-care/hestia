<%= tag.div id: dom_id(notification), class: "flex items-start gap-2 rounded-md px-2 py-2 text-sm #{'bg-gray-50' unless notification.read?}" do %>
  <span class="shrink-0"><%= notification_icon(notification) %></span>
  <div class="min-w-0 flex-1">
    <p class="font-medium"><%= notification.title %></p>
    <% if notification.body.present? %>
      <p class="truncate text-xs text-gray-500"><%= notification.body %></p>
    <% end %>
    <p class="text-xs text-gray-400"><%= time_ago_in_words(notification.created_at) %></p>
  </div>
  <% unless notification.read? %>
    <%= button_to mark_read_notification_path(notification), method: :patch,
          class: "cursor-pointer shrink-0 text-gray-400 hover:text-gray-900", aria: { label: t(".mark_read") } do %><%= lucide_icon("check", css_class: "size-4") %><% end %>
  <% end %>
<% end %>
