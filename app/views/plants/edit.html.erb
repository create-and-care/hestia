<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:outdoor, [ @plant.name, plant_path(@plant) ], [ t(".title"), nil ], module_path: exterior_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @plant, url: plant_path(@plant), multipart: true do |form| %>
    <% if @plant.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @plant.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "plant_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "plant[name]", value: @plant.name,
                html_options: { id: "plant_name", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "plant_location")) do |field| %>
        <% field.with_label { t(".location_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "plant[location]", value: @plant.location,
                html_options: { id: "plant_location" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "plant_reference_id")) do |field| %>
        <% field.with_label { t(".reference_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "plant[plant_reference_id]",
                options: [ [ t(".reference_blank"), "" ] ] + PlantReference.ordered.map { |reference| [ reference.common_name, reference.id ] },
                selected: @plant.plant_reference_id, html_options: { id: "plant_reference_id" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "plant_notes")) do |field| %>
        <% field.with_label { t(".notes_label") } %>
        <% field.with_control do %>
          <%= render(Ui::TextareaComponent.new(name: "plant[notes]", rows: 3,
                html_options: { id: "plant_notes" })) { @plant.notes } %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "plant_photo")) do |field| %>
        <% field.with_label { t(".photo_label") } %>
        <% field.with_control do %>
          <%= render Ui::FileUploadComponent.new(name: "plant[photo]", accept: "image/*", shape: :square,
                existing_url: (url_for(@plant.photo.variant(resize_to_fill: [ 160, 160 ])) if @plant.photo.attached?),
                html_options: { id: "plant_photo" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".save") } %>
    </div>
  <% end %>

</div>
