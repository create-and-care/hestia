<%= form_with model: conversation, url: url do |form| %>
  <% if conversation.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% conversation.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <%= render(Ui::FieldComponent.new(id: "conversation_name")) do |field| %>
      <% field.with_label { t(".name_label") } %>
      <% field.with_control do %>
        <%= render Ui::InputComponent.new(name: "conversation[name]", value: conversation.name,
              html_options: { id: "conversation_name", required: true }) %>
      <% end %>
    <% end %>

    <div>
      <span class="mb-1 block text-sm font-medium"><%= t(".participants_label") %></span>
      <div class="flex flex-wrap gap-3">
        <% Current.household.users.order(:name).each do |user| %>
          <div class="flex items-center gap-2 text-sm">
            <%= render Ui::CheckboxComponent.new(name: "participant_ids[]", id: "conversation_participant_#{user.id}",
                  checked: conversation.participant_ids.include?(user.id) || user == Current.user,
                  disabled: (user == Current.user && !conversation.persisted?), html_options: { value: user.id }) %>
            <%= render(Ui::LabelComponent.new(for_id: "conversation_participant_#{user.id}")) do %>
              <%= user.name.presence || user.email_address %><%= t(".you_suffix") if user == Current.user %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
  </div>
<% end %>
