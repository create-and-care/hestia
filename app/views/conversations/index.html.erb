<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:messages) %></div>

  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("message-circle", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_conversation_path)) { t(".new_conversation") } %>
  </header>

  <%= render "shared/flash" %>

  <% if @conversations.any? %>
    <div class="divide-y divide-primary rounded-lg border border-primary">
      <% @conversations.each do |conversation| %>
        <% last_message = conversation.messages.max_by(&:created_at) %>
        <%= render(Ui::ItemComponent.new(href: conversation_path(conversation))) do |item| %>
          <% item.with_title do %>
            <span class="inline-flex items-center gap-1.5">
              <% if conversation.unread_for?(Current.user) %>
                <span class="size-1.5 shrink-0 rounded-full bg-button-primary"></span>
                <span class="sr-only"><%= t(".unread") %></span>
              <% end %>
              <%= conversation.name %>
            </span>
          <% end %>
          <% item.with_description do %>
            <% if last_message %>
              <%= truncate(last_message.content, length: 60) %> · <%= time_ago_in_words(last_message.created_at) %>
            <% else %>
              <%= conversation.participants.map { |u| u.name.presence || u.email_address }.join(", ") %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".empty") } } %>
  <% end %>

</div>
