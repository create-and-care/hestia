<% content_for :title, @conversation.name %>
<%= turbo_stream_from @conversation %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <header class="mb-4 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold"><%= @conversation.name %></h1>
      <p class="text-sm text-secondary"><%= @conversation.participants.map { |u| u.name.presence || u.email_address }.join(", ") %></p>
    </div>
    <%= link_to t(".settings"), edit_conversation_path(@conversation), class: "text-sm underline" %>
  </header>

  <%= render "shared/flash" %>

  <%# No prior scroll-to-bottom behavior existed here (plain growing div) — Ui::MessageScrollerComponent
      adds pinned-to-bottom auto-scroll via its own Stimulus controller. The turbo_stream append target
      "messages" is nested inside the component's viewport so appended messages land inside the
      scrollable area (and are still caught by the controller's subtree MutationObserver). %>
  <%= render(Ui::MessageScrollerComponent.new(class_name: "mb-4 h-[60vh] w-full")) do %>
    <div id="messages" class="space-y-2">
      <%= render @conversation.messages.chronological %>
    </div>
  <% end %>

  <%= tag.div id: "new_message" do %>
    <%= form_with model: [ @conversation, @message ], url: conversation_messages_path(@conversation), class: "flex gap-2" do |form| %>
      <%= render Ui::InputComponent.new(name: "message[content]", placeholder: t("conversations.message_placeholder"),
            html_options: { id: "message_content", required: true, autocomplete: "off", class: "flex-1" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t("conversations.send") } %>
    <% end %>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_conversations"), conversations_path, class: "underline" %></p>
</div>
