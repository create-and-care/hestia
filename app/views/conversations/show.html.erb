<% content_for :title, @conversation.name %>
<%= turbo_stream_from @conversation %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:messages, [ @conversation.name, nil ], module_path: conversations_path) %></div>

  <header class="mb-4 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold"><%= @conversation.name %></h1>
      <p class="text-sm text-secondary"><%= @conversation.participants.map { |u| u.name.presence || u.email_address }.join(", ") %></p>
      <% if @conversation.subject %>
        <p class="text-sm text-secondary">
          <%= t(".about_prefix") %> <%= link_to conversation_subject_label(@conversation.subject), conversation_subject_path(@conversation.subject), class: "hover:underline" %>
        </p>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: edit_conversation_path(@conversation))) { t(".settings") } %>
      <%= render(Ui::AlertDialogComponent.new(title: t(".delete_confirm"), confirm_label: t(".delete"),
            confirm_url: conversation_path(@conversation), confirm_method: :delete)) do |alert_dialog| %>
        <% alert_dialog.with_trigger do %>
          <%= render(Ui::ButtonComponent.new(variant: :destructive, size: :sm)) { t(".delete") } %>
        <% end %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <%# No prior scroll-to-bottom behavior existed here (plain growing div) — Ui::MessageScrollerComponent
      adds pinned-to-bottom auto-scroll via its own Stimulus controller. The turbo_stream append target
      "messages" is nested inside the component's viewport so appended messages land inside the
      scrollable area (and are still caught by the controller's subtree MutationObserver). %>
  <%= render(Ui::MessageScrollerComponent.new(class_name: "mb-4 h-[var(--panel-h-sm)] w-full")) do %>
    <div id="messages" class="space-y-2" data-controller="message-role" data-message-role-current-user-id-value="<%= Current.user.id %>">
      <%= render @conversation.messages.chronological.includes(:author, :message_reactions, photo_attachment: :blob) %>
    </div>
  <% end %>

  <%= render "messages/form", conversation: @conversation, message: @message %>
</div>
