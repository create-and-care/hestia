<% content_for :title, "Véhicules" %>
<%= turbo_stream_from Current.household %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">🚗 Véhicules</h1>
    <div class="flex items-center gap-2">
      <%= form_with url: vehicles_path, method: :get do |form| %>
        <%= form.search_field :q, value: @query, placeholder: "Rechercher…",
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <% end %>
      <%= link_to "Nouveau", new_vehicle_path,
            class: "rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <div id="vehicles" class="space-y-2">
    <%= render @vehicles %>
  </div>
  <% if @vehicles.empty? %>
    <p class="mt-4 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">Aucun véhicule.</p>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to "← Tableau de bord", root_path, class: "underline" %></p>
</div>
