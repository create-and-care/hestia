<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:vehicles) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("car", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= form_with url: vehicles_path, method: :get do |form| %>
        <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"),
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_vehicle_path)) { t(".new_vehicle") } %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <div id="vehicles" class="space-y-2">
    <%= render @vehicles %>
  </div>
  <% if @vehicles.empty? %>
    <div class="mt-4">
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".empty") } %>
      <% end %>
    </div>
  <% end %>

</div>
