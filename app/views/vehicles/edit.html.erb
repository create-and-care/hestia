<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-xl px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>
  <%= render "form", vehicle: @vehicle, url: vehicle_path(@vehicle) %>
  <p class="mt-6 text-sm"><%= link_to t(".back_to_vehicle"), vehicle_path(@vehicle), class: "underline" %></p>
</div>
