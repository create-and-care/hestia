<% content_for :title, @vehicle.name %>
<%= turbo_stream_from @vehicle %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:vehicles, [ @vehicle.name, nil ], module_path: vehicles_path) %></div>

  <header class="mb-4 flex items-start justify-between gap-4">
    <div class="flex items-start gap-4">
      <% if @vehicle.photo.attached? %>
        <div class="size-16 shrink-0">
          <%= render(Ui::AspectRatioComponent.new(ratio: 1)) do %>
            <%= image_tag @vehicle.photo.variant(resize_to_fill: [ 128, 128 ]), alt: "", loading: :lazy, class: "size-full rounded-lg object-cover" %>
          <% end %>
        </div>
      <% end %>
      <div>
        <h1 class="flex items-center gap-2 text-2xl font-semibold">
          <% unless @vehicle.photo.attached? %><%= lucide_icon("car", css_class: "size-6") %><% end %>
          <%= @vehicle.name %>
        </h1>
        <p class="text-sm text-secondary">
          <%= [ vehicle_type_label(@vehicle.vehicle_type), @vehicle.manufacturer, @vehicle.plate, @vehicle.year, @vehicle.energy ].reject(&:blank?).join(" · ") %>
        </p>
        <p class="mt-2">
          <%= render(Ui::BadgeComponent.new(variant: inspection_badge_variant(@vehicle.inspection_status))) do %>
            <%= t(".inspection_prefix") %> <%= inspection_label(@vehicle.inspection_status) %>
            <% if @vehicle.inspection_expires_on %> (<%= @vehicle.inspection_expires_on.strftime("%d/%m/%Y") %>)<% end %>
          <% end %>
        </p>
      </div>
    </div>
    <div class="flex gap-2 text-sm">
      <%= link_to t(".edit"), edit_vehicle_path(@vehicle), class: "underline" %>
      <%= button_to t(".delete"), vehicle_path(@vehicle), method: :delete,
            form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "cursor-pointer text-destructive underline" %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <section class="mt-6">
    <h2 class="mb-2 font-medium"><%= t(".maintenance_history") %></h2>
    <% if @vehicle.vehicle_maintenance_entries.chronological.any? %>
      <div id="vehicle_maintenance_entries" class="mb-3 divide-y divide-primary rounded-lg border border-primary">
        <%= render @vehicle.vehicle_maintenance_entries.chronological %>
      </div>
    <% else %>
      <div id="vehicle_maintenance_entries" class="mb-3">
        <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_entries") } } %>
      </div>
    <% end %>

    <%= form_with model: @entry, url: vehicle_maintenance_entries_path(@vehicle), class: "flex flex-wrap items-end gap-2",
          data: { controller: "maintenance-entry-type", action: "submit->maintenance-entry-type#beforeSubmit" } do |form| %>
      <div>
        <label for="vehicle_maintenance_entry_entry_type" class="sr-only"><%= t(".entry_type_label") %></label>
        <%= render Ui::NativeSelectComponent.new(name: "vehicle_maintenance_entry[entry_type]", options: maintenance_entry_type_options,
              html_options: { id: "vehicle_maintenance_entry_entry_type", data: { maintenance_entry_type_target: "select", action: "change->maintenance-entry-type#sync" } }) %>
      </div>
      <%= render Ui::InputComponent.new(type: "text", name: "vehicle_maintenance_entry[entry_type]", placeholder: t(".entry_type_custom_placeholder"),
            html_options: { id: "vehicle_maintenance_entry_entry_type_custom", class: "hidden flex-1", data: { maintenance_entry_type_target: "custom" } }) %>
      <div>
        <label for="vehicle_maintenance_entry_done_on" class="sr-only"><%= t(".done_on_label") %></label>
        <%= render Ui::InputComponent.new(type: "date", name: "vehicle_maintenance_entry[done_on]", value: @entry.done_on,
              html_options: { id: "vehicle_maintenance_entry_done_on" }) %>
      </div>
      <div>
        <label for="vehicle_maintenance_entry_cost" class="sr-only"><%= t(".cost_label") %></label>
        <%= render Ui::InputComponent.new(type: "number", name: "vehicle_maintenance_entry[cost]", value: @entry.cost, placeholder: "€",
              html_options: { id: "vehicle_maintenance_entry_cost", step: "any", class: "w-20" }) %>
      </div>
      <div>
        <label for="vehicle_maintenance_entry_service_provider_id" class="sr-only"><%= t(".provider_label") %></label>
        <%= render Ui::NativeSelectComponent.new(name: "vehicle_maintenance_entry[service_provider_id]",
              options: [ [ t(".no_provider_option"), "" ] ] + @service_providers.map { |provider| [ provider.name, provider.id ] },
              html_options: { id: "vehicle_maintenance_entry_service_provider_id" }) %>
      </div>
      <div class="w-full">
        <label for="vehicle_maintenance_entry_description" class="sr-only"><%= t(".description_label") %></label>
        <%= render(Ui::TextareaComponent.new(name: "vehicle_maintenance_entry[description]", rows: 1, placeholder: t(".description_placeholder"),
              html_options: { id: "vehicle_maintenance_entry_description" })) %>
      </div>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add") } %>
    <% end %>
  </section>

  <section class="mt-6">
    <h2 class="mb-2 font-medium"><%= t(".documents_heading") %></h2>
    <% if @vehicle.documents.ordered.any? %>
      <div class="mb-3 divide-y divide-primary rounded-lg border border-primary">
        <% @vehicle.documents.ordered.with_attached_file.each do |document| %>
          <%= render(Ui::ItemComponent.new) do |item| %>
            <% item.with_title { render "documents/preview_trigger", document: document } %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_documents") } } %>
    <% end %>
    <p class="text-sm"><%= link_to t(".manage_documents_link"), documents_path, class: "underline" %></p>
  </section>

</div>
