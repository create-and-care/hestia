<%= form_with model: vehicle, url: url do |form| %>
  <% if vehicle.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% vehicle.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= render(Ui::FieldComponent.new(id: "vehicle_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "text", name: "vehicle[name]", value: vehicle.name,
                html_options: { id: "vehicle_name", required: true }) %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "vehicle_vehicle_type")) do |field| %>
        <% field.with_label { t(".type_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "vehicle[vehicle_type]", options: vehicle_type_options,
                selected: vehicle.vehicle_type, html_options: { id: "vehicle_vehicle_type" }) %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "vehicle_manufacturer")) do |field| %>
        <% field.with_label { t(".manufacturer_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "text", name: "vehicle[manufacturer]", value: vehicle.manufacturer,
                html_options: { id: "vehicle_manufacturer" }) %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "vehicle_plate")) do |field| %>
        <% field.with_label { t(".plate_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "text", name: "vehicle[plate]", value: vehicle.plate,
                html_options: { id: "vehicle_plate" }) %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "vehicle_year")) do |field| %>
        <% field.with_label { t(".year_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "vehicle[year]", value: vehicle.year,
                html_options: { id: "vehicle_year" }) %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "vehicle_energy")) do |field| %>
        <% field.with_label { t(".energy_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "text", name: "vehicle[energy]", value: vehicle.energy, placeholder: t(".energy_placeholder"),
                html_options: { id: "vehicle_energy" }) %>
        <% end %>
      <% end %>
    </div>
    <div class="sm:col-span-2">
      <%= render(Ui::FieldComponent.new(id: "vehicle_inspection_expires_on")) do |field| %>
        <% field.with_label { t(".inspection_expires_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "vehicle[inspection_expires_on]", value: vehicle.inspection_expires_on,
                html_options: { id: "vehicle_inspection_expires_on" }) %>
        <% end %>
      <% end %>
    </div>
    <div class="sm:col-span-2">
      <%= render(Ui::FieldComponent.new(id: "vehicle_photo")) do |field| %>
        <% field.with_label { t(".photo_label") } %>
        <% field.with_control do %>
          <% if vehicle.photo.attached? %>
            <div class="mb-2 max-w-40">
              <%= render(Ui::AspectRatioComponent.new) do %>
                <%= image_tag vehicle.photo.variant(resize_to_fill: [ 160, 90 ]), alt: "", class: "size-full rounded-md object-cover" %>
              <% end %>
            </div>
          <% end %>
          <%= form.file_field :photo, accept: "image/*", id: "vehicle_photo", class: "block text-sm text-secondary" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit", html_options: { class: "mt-4" })) { t(".submit") } %>
<% end %>
