<%= form_with model: vehicle, url: url do |form| %>
  <% if vehicle.errors.any? %>
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-inside list-disc">
        <% vehicle.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :name, t(".name_label"), class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :name, required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :vehicle_type, t(".type_label"), class: "mb-1 block text-sm font-medium" %>
      <%= form.select :vehicle_type, vehicle_type_options, {}, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :manufacturer, t(".manufacturer_label"), class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :manufacturer, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :plate, t(".plate_label"), class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :plate, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :year, t(".year_label"), class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :year, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :energy, t(".energy_label"), class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :energy, placeholder: t(".energy_placeholder"), class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :inspection_expires_on, t(".inspection_expires_label"), class: "mb-1 block text-sm font-medium" %>
      <%= form.date_field :inspection_expires_on, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
  </div>

  <%= form.submit t(".submit"), class: "mt-4 cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
<% end %>
