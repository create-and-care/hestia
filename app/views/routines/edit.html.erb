<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-md px-4">
  <div class="mb-4"><%= module_breadcrumb(:routines, [ t(".title"), nil ], module_path: routines_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= turbo_frame_tag dom_id(@routine, :edit) do %>
    <%= render "form_fields", routine: @routine %>
  <% end %>
</div>
