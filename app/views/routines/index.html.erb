<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:routines) %></div>

  <h1 class="mb-4 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("repeat", css_class: "size-6") %> <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <% if @lists.any? %>
    <nav class="mb-4 flex flex-wrap gap-2 text-sm">
      <%= link_to t(".all"), routines_path, class: "rounded-full px-3 py-0.5 #{@list ? 'bg-gray-100' : 'bg-gray-900 text-white'}" %>
      <% @lists.each do |list| %>
        <%= link_to list, routines_path(list: list), class: "rounded-full px-3 py-0.5 #{@list == list ? 'bg-gray-900 text-white' : 'bg-gray-100'}" %>
      <% end %>
    </nav>
  <% end %>

  <div id="routines" class="space-y-2">
    <%= render @routines %>
  </div>
  <% if @routines.empty? %>
    <p class="mt-4 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500"><%= t(".empty") %></p>
  <% end %>

  <section class="mt-6 rounded-lg border border-gray-200 p-4">
    <h2 class="mb-2 font-medium"><%= t(".new_routine") %></h2>
    <%= form_with model: @routine, url: routines_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= form.text_field :emoji, placeholder: "🧹", maxlength: 4, class: "w-14 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.text_field :name, required: true, placeholder: t(".name_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.select :frequency, routine_frequency_options, {}, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.number_field :interval, value: 1, min: 1, class: "w-16 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.text_field :list_name, placeholder: t(".list_placeholder"), class: "w-32 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.select :assignee_id, routine_member_options, { include_blank: "—" }, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".add"), class: "cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>
  </section>

</div>
