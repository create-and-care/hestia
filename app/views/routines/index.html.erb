<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:routines) %></div>

  <h1 class="mb-4 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("repeat", css_class: "size-6") %> <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <% if @lists.any? %>
    <nav class="mb-4 flex flex-wrap gap-2 text-sm">
      <%= render(Ui::BadgeComponent.new(variant: @list ? :secondary : :default)) { link_to t(".all"), routines_path } %>
      <% @lists.each do |list| %>
        <%= render(Ui::BadgeComponent.new(variant: @list == list ? :default : :secondary)) { link_to list, routines_path(list: list) } %>
      <% end %>
    </nav>
  <% end %>

  <div id="routines" class="space-y-2">
    <%= render @routines %>
  </div>
  <% if @routines.empty? %>
    <div class="mt-4">
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".empty") } } %>
    </div>
  <% end %>

  <%= render(Ui::CardComponent.new(class_name: "mt-6")) do |card| %>
    <% card.with_title { t(".new_routine") } %>
    <%= form_with model: @routine, url: routines_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= render Ui::InputComponent.new(name: "routine[emoji]", value: @routine.emoji, placeholder: "🧹",
            html_options: { id: "routine_emoji", maxlength: 4, class: "w-14" }) %>
      <%= render Ui::InputComponent.new(name: "routine[name]", value: @routine.name, placeholder: t(".name_placeholder"),
            html_options: { id: "routine_name", required: true, class: "flex-1" }) %>
      <%= render Ui::NativeSelectComponent.new(name: "routine[frequency]", options: routine_frequency_options,
            selected: @routine.frequency, html_options: { id: "routine_frequency" }) %>
      <%= render Ui::InputComponent.new(type: "number", name: "routine[interval]", value: 1,
            html_options: { id: "routine_interval", min: 1, class: "w-16" }) %>
      <%= render Ui::InputComponent.new(name: "routine[list_name]", value: @routine.list_name, placeholder: t(".list_placeholder"),
            html_options: { id: "routine_list_name", class: "w-32" }) %>
      <%= render Ui::NativeSelectComponent.new(name: "routine[assignee_id]",
            options: [ [ "—", "" ] ] + routine_member_options, selected: @routine.assignee_id,
            html_options: { id: "routine_assignee_id" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".add") } %>
    <% end %>
  <% end %>

</div>
