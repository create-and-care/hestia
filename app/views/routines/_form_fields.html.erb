<%= form_with model: routine, url: routine_path(routine) do |form| %>
  <% if routine.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% routine.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <%= render(Ui::FieldComponent.new(id: "#{dom_id(routine)}_name")) do |field| %>
      <% field.with_label { t("routines.edit.name_label") } %>
      <% field.with_control do %>
        <%= render Ui::InputComponent.new(name: "routine[name]", value: routine.name, invalid: routine.errors[:name].any?,
              html_options: { id: "#{dom_id(routine)}_name", required: true }) %>
      <% end %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: "#{dom_id(routine)}_description")) do |field| %>
      <% field.with_label { t("routines.edit.description_label") } %>
      <% field.with_control do %>
        <%= render(Ui::TextareaComponent.new(name: "routine[description]", rows: 2,
              html_options: { id: "#{dom_id(routine)}_description" })) { routine.description } %>
      <% end %>
    <% end %>

    <div class="grid grid-cols-2 gap-4">
      <%= render(Ui::FieldComponent.new(id: "#{dom_id(routine)}_list_name")) do |field| %>
        <% field.with_label { t("routines.edit.list_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "routine[list_name]", value: routine.list_name,
                html_options: { id: "#{dom_id(routine)}_list_name" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "#{dom_id(routine)}_frequency")) do |field| %>
        <% field.with_label { t("routines.edit.frequency_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "routine[frequency]", options: routine_frequency_options,
                selected: routine.frequency, html_options: { id: "#{dom_id(routine)}_frequency" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "#{dom_id(routine)}_interval")) do |field| %>
        <% field.with_label { t("routines.edit.interval_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "routine[interval]", value: routine.interval,
                html_options: { id: "#{dom_id(routine)}_interval", min: 1 }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "#{dom_id(routine)}_next_due_on")) do |field| %>
        <% field.with_label { t("routines.edit.next_due_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "routine[next_due_on]", value: routine.next_due_on,
                html_options: { id: "#{dom_id(routine)}_next_due_on" }) %>
        <% end %>
      <% end %>
    </div>

    <%= render(Ui::FieldComponent.new(id: "#{dom_id(routine)}_assignee_id")) do |field| %>
      <% field.with_label { t("routines.edit.assignee_label") } %>
      <% field.with_control do %>
        <%= render Ui::NativeSelectComponent.new(name: "routine[assignee_id]",
              options: [ [ "—", "" ] ] + routine_member_options, selected: routine.assignee_id,
              html_options: { id: "#{dom_id(routine)}_assignee_id" }) %>
      <% end %>
    <% end %>

    <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t("routines.edit.save") } %>
  </div>
<% end %>
