<%= tag.div id: dom_id(routine), class: "rounded-lg border #{routine.overdue? ? "border-destructive bg-destructive/10" : "border-primary"}" do %>
  <%= render(Ui::ItemComponent.new) do |item| %>
    <% item.with_title do %><%= "#{routine.emoji} " if routine.emoji.present? %><%= routine.name %><% end %>
    <% item.with_description do %>
      <%= routine_frequency_label(routine.frequency) %><%= " ×#{routine.interval}" if routine.interval.to_i > 1 %>
      <% if routine.next_due_on %>· <%= t(".next_due") %> : <%= routine.next_due_on.strftime("%d/%m/%Y") %><% end %>
      <% if routine.overdue? %><span class="font-medium text-destructive">· <%= t(".overdue") %></span><% end %>
      <% if routine.assignee %>· <%= routine.assignee.name.presence || routine.assignee.email_address %><% end %>
      <% if routine.list_name.present? %>· <%= routine.list_name %><% end %>
    <% end %>
    <% item.with_trailing do %>
      <div class="flex items-center gap-2">
        <%= render(Ui::ButtonToComponent.new(complete_routine_path(routine), method: :post)) {
              safe_join([ lucide_icon("check", css_class: "size-4"), t(".done") ], " ") } %>
        <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: routine_path(routine),
              html_options: { aria: { label: t(".history_aria") } })) { lucide_icon("clock", css_class: "size-4") } %>
        <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: edit_routine_path(routine),
              html_options: { aria: { label: t(".edit_aria") } })) { lucide_icon("pencil", css_class: "size-4") } %>
        <%= form_with url: routine_path(routine), method: :delete, data: { turbo_confirm: t(".delete_confirm") } do %>
          <%= render(Ui::ButtonComponent.new(type: "submit", variant: :ghost, size: :icon,
                html_options: { class: "text-subdued hover:text-destructive", aria: { label: t(".delete_aria") } })) { lucide_icon("x", css_class: "size-4") } %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
