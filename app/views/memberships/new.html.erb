<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with url: membership_path, method: :post do |form| %>
    <div class="space-y-4">
      <div>
        <%= form.label :invite_code, t(".invite_code_label"), class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :invite_code, required: true, autofocus: true, value: params[:invite_code],
              placeholder: t(".invite_code_placeholder"),
              class: "w-full rounded-md border border-gray-300 px-3 py-2 uppercase tracking-widest" %>
      </div>

      <%= form.submit t(".submit"), class: "w-full cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-gray-600">
    <%= link_to t(".back"), onboarding_path, class: "underline" %>
  </p>
</div>
