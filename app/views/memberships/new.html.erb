<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with url: membership_path, method: :post do %>
    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "invite_code")) do |field| %>
        <% field.with_label { t(".invite_code_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "invite_code", value: params[:invite_code], placeholder: t(".invite_code_placeholder"),
                html_options: { id: "invite_code", required: true, autofocus: true, class: "uppercase tracking-widest" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t(".submit") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-secondary">
    <%= link_to t(".back"), onboarding_path, class: "underline" %>
  </p>
</div>
