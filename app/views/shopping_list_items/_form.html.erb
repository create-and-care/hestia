<%= tag.div id: "new_shopping_list_item" do %>
  <%= form_with model: item, url: shopping_list_items_path(shopping_list),
        data: { controller: "barcode-lookup", barcode_lookup_url_value: lookup_products_path,
                barcode_lookup_searching_text_value: t(".barcode_searching"),
                barcode_lookup_not_found_text_value: t(".barcode_not_found"),
                barcode_lookup_unavailable_text_value: t(".barcode_unavailable"),
                barcode_lookup_found_text_value: t(".barcode_found_prefix") } do |form| %>
    <div class="flex flex-wrap items-end gap-2 rounded-lg border border-primary p-3">
      <div class="w-36">
        <%= render Ui::LabelComponent.new { t(".barcode_label") } %>
        <div class="mt-1 flex gap-1">
          <%= render Ui::InputComponent.new(placeholder: t(".barcode_placeholder"),
                html_options: { autocomplete: "off", data: { barcode_lookup_target: "barcode" } }) %>
          <%= render(Ui::ButtonComponent.new(type: "button", variant: :outline, size: :icon,
                html_options: { data: { action: "click->barcode-lookup#lookup" } })) { lucide_icon("search", css_class: "size-4") } %>
        </div>
      </div>
      <div class="min-w-40 flex-1">
        <%= render(Ui::FieldComponent.new(id: "shopping_list_item_name")) do |field| %>
          <% field.with_label { t(".name_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(name: "shopping_list_item[name]", value: item.name,
                  placeholder: t(".name_placeholder"),
                  html_options: { id: "shopping_list_item_name", required: true, autofocus: true, autocomplete: "off",
                                  data: { barcode_lookup_target: "name" } }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-20">
        <%= render(Ui::FieldComponent.new(id: "shopping_list_item_quantity")) do |field| %>
          <% field.with_label { t(".quantity_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "number", name: "shopping_list_item[quantity]", value: item.quantity,
                  html_options: { id: "shopping_list_item_quantity", step: "any", min: 0 }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-24">
        <%= render(Ui::FieldComponent.new(id: "shopping_list_item_unit")) do |field| %>
          <% field.with_label { t(".unit_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(name: "shopping_list_item[unit]", value: item.unit,
                  placeholder: t(".unit_placeholder"),
                  html_options: { id: "shopping_list_item_unit" }) %>
          <% end %>
        <% end %>
      </div>
      <div class="w-40">
        <%= render(Ui::FieldComponent.new(id: "shopping_list_item_rayon")) do |field| %>
          <% field.with_label { t(".rayon_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "shopping_list_item[rayon]",
                  options: [ [ t(".rayon_blank"), "" ] ] + rayon_select_options,
                  selected: item.rayon, html_options: { id: "shopping_list_item_rayon", data: { barcode_lookup_target: "rayon" } }) %>
          <% end %>
        <% end %>
      </div>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
      <p class="w-full text-xs text-subdued" data-barcode-lookup-target="status"></p>
    </div>
  <% end %>
<% end %>
