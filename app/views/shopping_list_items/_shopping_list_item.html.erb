<%= tag.div id: dom_id(shopping_list_item), data: { sortable_id: shopping_list_item.id },
      class: "rounded-lg border border-primary #{'opacity-50' if shopping_list_item.checked}" do %>
  <%= render(Ui::ItemComponent.new) do |item| %>
    <% item.with_leading do %>
      <div class="flex items-center gap-2">
        <span data-sortable-handle class="cursor-grab select-none text-subdued hover:text-secondary" title="<%= t('.move_title') %>"><%= lucide_icon("grip-vertical", css_class: "size-4") %></span>
        <div class="flex flex-col">
          <%= button_to move_up_shopping_list_item_path(shopping_list_item.shopping_list, shopping_list_item), method: :patch,
                class: "-mb-1 cursor-pointer text-subdued hover:text-primary", aria: { label: t(".move_up_aria") } do %><%= lucide_icon("chevron-up", css_class: "size-3") %><% end %>
          <%= button_to move_down_shopping_list_item_path(shopping_list_item.shopping_list, shopping_list_item), method: :patch,
                class: "cursor-pointer text-subdued hover:text-primary", aria: { label: t(".move_down_aria") } do %><%= lucide_icon("chevron-down", css_class: "size-3") %><% end %>
        </div>
        <%= button_to toggle_shopping_list_item_path(shopping_list_item.shopping_list, shopping_list_item),
              method: :patch, class: "shrink-0 cursor-pointer",
              aria: { label: shopping_list_item.checked ? t(".uncheck_aria") : t(".check_aria") } do %>
          <span class="flex size-5 items-center justify-center rounded border <%= shopping_list_item.checked ? "border-button-primary bg-button-primary text-inverse" : "border-primary" %>">
            <%= lucide_icon("check", css_class: "size-3.5") if shopping_list_item.checked %>
          </span>
        <% end %>
      </div>
    <% end %>

    <% item.with_title do %>
      <span class="<%= "line-through text-subdued" if shopping_list_item.checked %>">
        <%= shopping_list_item.name %>
        <% if shopping_list_item.quantity.present? %>
          <span class="text-sm text-secondary">
            — <%= shopping_list_item.quantity.to_s.sub(/\.0+\z/, "") %> <%= shopping_list_item.unit %>
          </span>
        <% end %>
      </span>
    <% end %>

    <% item.with_trailing do %>
      <div class="flex shrink-0 items-center gap-2">
        <% if shopping_list_item.checked %>
          <%= form_with url: move_to_fridge_shopping_list_item_path(shopping_list_item.shopping_list, shopping_list_item),
                method: :post, class: "flex items-center gap-1" do %>
            <input type="date" name="expires_on" value="<%= Date.current %>" title="<%= t(".expires_on_title") %>" aria-label="<%= t(".expires_on_title") %>"
                   class="h-7 w-28 rounded border border-primary bg-container px-1 text-xs text-primary">
            <button type="submit" class="shrink-0 cursor-pointer text-subdued hover:text-primary"
                    title="<%= t(".move_to_fridge_title") %>" aria-label="<%= t(".move_to_fridge_title") %>">
              <%= lucide_icon("refrigerator", css_class: "size-4") %>
            </button>
          <% end %>
        <% end %>

        <%= button_to shopping_list_item_path(shopping_list_item.shopping_list, shopping_list_item),
              method: :delete, class: "shrink-0 cursor-pointer text-subdued hover:text-destructive",
              form: { data: { turbo_confirm: t(".delete_confirm") } }, aria: { label: t(".delete_aria") } do %>
          <%= lucide_icon("x", css_class: "size-4") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
