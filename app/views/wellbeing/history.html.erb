<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:wellbeing, [ t(".title"), nil ], module_path: wellbeing_path) %></div>

  <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold">
    <%= lucide_icon("heart-pulse", css_class: "size-6") %> <%= t(".title") %>
  </h1>

  <%= render "shared/flash" %>

  <%= render(Ui::TabsComponent.new(default: @tab)) do |tabs| %>
    <% tabs.with_tab(label: t(".weight_tab"), value: "weight") do %>
      <% if @weight_entries.any? %>
        <ul class="mb-4 divide-y divide-primary text-sm">
          <% @weight_entries.each do |entry| %>
            <li class="py-2"><%= l(entry.recorded_on, format: :numeric) %> — <%= entry.weight %> kg</li>
          <% end %>
        </ul>
        <% if @weight_total_pages > 1 %>
          <div class="flex justify-center">
            <%= render Ui::PaginationComponent.new(current: @weight_page, total: @weight_total_pages,
                  path: ->(page) { history_wellbeing_path(weight_page: page, workout_page: @workout_page, tab: "weight") }) %>
          </div>
        <% end %>
      <% else %>
        <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".weight_empty") } } %>
      <% end %>
    <% end %>

    <% tabs.with_tab(label: t(".workouts_tab"), value: "workouts") do %>
      <% if @workout_entries.any? %>
        <ul class="mb-4 divide-y divide-primary text-sm">
          <% @workout_entries.each do |entry| %>
            <li class="py-2"><%= l(entry.done_on, format: :numeric) %> — <%= entry.exercise %><% if entry.duration_minutes %> (<%= entry.duration_minutes %> min)<% end %></li>
          <% end %>
        </ul>
        <% if @workout_total_pages > 1 %>
          <div class="flex justify-center">
            <%= render Ui::PaginationComponent.new(current: @workout_page, total: @workout_total_pages,
                  path: ->(page) { history_wellbeing_path(workout_page: page, weight_page: @weight_page, tab: "workouts") }) %>
          </div>
        <% end %>
      <% else %>
        <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".workouts_empty") } } %>
      <% end %>
    <% end %>
  <% end %>
</div>
