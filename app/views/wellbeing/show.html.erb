<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:wellbeing) %></div>

  <h1 class="mb-1 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("heart-pulse", css_class: "size-6") %> <%= t(".title") %></h1>
  <p class="mb-6 text-xs text-gray-400"><%= t(".privacy_note") %></p>

  <%= render "shared/flash" %>

  <section class="mb-8">
    <%= render(Ui::CardComponent.new) do %>
      <h2 class="mb-3 font-medium"><%= t(".my_profile") %></h2>
      <%= form_with model: @profile, url: wellbeing_profile_path, method: :patch, class: "grid grid-cols-2 gap-3 sm:grid-cols-3" do |form| %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:height))) do |field| %>
          <% field.with_label { t(".height_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:height), value: form.object.height, html_options: { id: form.field_id(:height) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:age))) do |field| %>
          <% field.with_label { t(".age_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:age), value: form.object.age, html_options: { id: form.field_id(:age) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:sex))) do |field| %>
          <% field.with_label { t(".sex_label") } %>
          <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:sex), options: [ [ "—", "" ] ] + sex_options, selected: form.object.sex, html_options: { id: form.field_id(:sex) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:activity_level))) do |field| %>
          <% field.with_label { t(".activity_label") } %>
          <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:activity_level), options: [ [ "—", "" ] ] + activity_options, selected: form.object.activity_level, html_options: { id: form.field_id(:activity_level) }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:start_weight))) do |field| %>
          <% field.with_label { t(".start_weight_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:start_weight), value: form.object.start_weight, html_options: { id: form.field_id(:start_weight), step: :any }) } %>
        <% end %>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:goal_weight))) do |field| %>
          <% field.with_label { t(".goal_weight_label") } %>
          <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:goal_weight), value: form.object.goal_weight, html_options: { id: form.field_id(:goal_weight), step: :any }) } %>
        <% end %>
        <div class="col-span-2 sm:col-span-3"><%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, type: "submit")) { t(".save_profile") } %></div>
      <% end %>
      <% if @latest_weight && @profile.bmi(@latest_weight) %>
        <p class="mt-3 text-sm"><%= t(".bmi_prefix") %> <span class="font-semibold"><%= @profile.bmi(@latest_weight) %></span> <%= t(".bmi_suffix", weight: @latest_weight) %></p>
      <% end %>
    <% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("scale", css_class: "size-5") %> <%= t(".weight") %></h2>
    <%= render(Ui::CardComponent.new) do %>
      <ul class="mb-2 divide-y divide-gray-100 text-sm">
        <% @weight_entries.reverse.first(15).each do |entry| %>
          <li>
            <%= render(Ui::ItemComponent.new) do |item| %>
              <% item.with_title { "#{entry.recorded_on.strftime('%d/%m/%Y')} — #{entry.weight} kg" } %>
              <% item.with_trailing do %>
                <%= form_with url: weight_entry_path(entry), method: :delete do %>
                  <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit")) { "×" } %>
                <% end %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= form_with model: @weight_entry, url: weight_entries_path, class: "flex flex-wrap items-end gap-2" do |form| %>
        <div class="w-24">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:weight))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:weight), value: form.object.weight, placeholder: t(".weight_placeholder"), html_options: { id: form.field_id(:weight), step: :any, required: true }) } %>
          <% end %>
        </div>
        <div>
          <%= render(Ui::FieldComponent.new(id: form.field_id(:recorded_on))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:recorded_on), value: form.object.recorded_on, html_options: { id: form.field_id(:recorded_on) }) } %>
          <% end %>
        </div>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add") } %>
      <% end %>
    <% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("dumbbell", css_class: "size-5") %> <%= t(".workouts") %></h2>
    <%= render(Ui::CardComponent.new) do %>
      <ul class="mb-2 divide-y divide-gray-100 text-sm">
        <% @workout_entries.first(15).each do |entry| %>
          <li>
            <%= render(Ui::ItemComponent.new) do |item| %>
              <% item.with_title do %>
                <%= entry.done_on.strftime("%d/%m") %> — <%= entry.exercise %><% if entry.duration_minutes %> (<%= entry.duration_minutes %> min)<% end %>
              <% end %>
              <% item.with_trailing do %>
                <%= form_with url: workout_entry_path(entry), method: :delete do %>
                  <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit")) { "×" } %>
                <% end %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= form_with model: @workout_entry, url: workout_entries_path, class: "flex flex-wrap items-end gap-2" do |form| %>
        <div class="flex-1">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:exercise))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:exercise), value: form.object.exercise, placeholder: t(".exercise_placeholder"), html_options: { id: form.field_id(:exercise), required: true }) } %>
          <% end %>
        </div>
        <div class="w-20">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:duration_minutes))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:duration_minutes), value: form.object.duration_minutes, placeholder: t(".duration_placeholder"), html_options: { id: form.field_id(:duration_minutes) }) } %>
          <% end %>
        </div>
        <div>
          <%= render(Ui::FieldComponent.new(id: form.field_id(:done_on))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:done_on), value: form.object.done_on, html_options: { id: form.field_id(:done_on) }) } %>
          <% end %>
        </div>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add") } %>
      <% end %>
    <% end %>
  </section>

</div>
