<% content_for :title, "Design system — Hestia" %>

<div class="min-h-screen bg-surface">
  <header class="border-b border-primary bg-container px-8 py-6">
    <h1 class="text-2xl font-semibold text-primary">Hestia design system</h1>
    <p class="text-sm text-secondary mt-1">Tokens Tailwind v4 + composants ViewComponent + Stimulus.</p>
  </header>

  <main class="mx-auto max-w-5xl px-8 py-10 space-y-16">

    <%# ───────────────────────── Inputs & forms ───────────────────────── %>
    <section class="space-y-6">
      <h2 class="text-lg font-semibold text-primary border-b border-primary pb-2">Inputs &amp; forms</h2>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Button</h3>
        <div class="flex flex-wrap items-center gap-3">
          <%= render Ui::ButtonComponent.new { "Default" } %>
          <%= render Ui::ButtonComponent.new(variant: :secondary) { "Secondary" } %>
          <%= render Ui::ButtonComponent.new(variant: :outline) { "Outline" } %>
          <%= render Ui::ButtonComponent.new(variant: :ghost) { "Ghost" } %>
          <%= render Ui::ButtonComponent.new(variant: :destructive) { "Destructive" } %>
          <%= render Ui::ButtonComponent.new(variant: :link) { "Link" } %>
          <%= render Ui::ButtonComponent.new(size: :sm) { "Small" } %>
          <%= render Ui::ButtonComponent.new(disabled: true) { "Disabled" } %>
        </div>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Button group</h3>
        <%= render Ui::ButtonGroupComponent.new do %>
          <%= render Ui::ButtonComponent.new(variant: :outline) { "Day" } %>
          <%= render Ui::ButtonComponent.new(variant: :outline) { "Week" } %>
          <%= render Ui::ButtonComponent.new(variant: :outline) { "Month" } %>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-6">
        <%= render(Ui::FieldComponent.new(id: "name")) do |field| %>
          <% field.with_label { "Name" } %>
          <% field.with_control { render Ui::InputComponent.new(name: "name", placeholder: "Ada Lovelace", html_options: { id: "name" }) } %>
          <% field.with_description { "Your full name." } %>
        <% end %>

        <%= render(Ui::FieldComponent.new(id: "email")) do |field| %>
          <% field.with_label { "Email" } %>
          <% field.with_control { render Ui::InputComponent.new(type: "email", name: "email", placeholder: "ada@example.com", invalid: true, html_options: { id: "email" }) } %>
          <% field.with_error { "Email is invalid." } %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Input group</h3>
        <%= render(Ui::InputGroupComponent.new) do |group| %>
          <% group.with_leading { "@" } %>
          <%= render Ui::InputComponent.new(name: "handle", placeholder: "username") %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Textarea</h3>
        <%= render Ui::TextareaComponent.new(name: "message", placeholder: "Write your message…") %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Native select</h3>
        <%= render Ui::NativeSelectComponent.new(name: "country", options: [ "France", "Belgique", "Suisse" ]) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Select (custom)</h3>
        <%= render Ui::SelectComponent.new(name: "framework", options: [ [ "Rails", "rails" ], [ "Next.js", "next" ], [ "Laravel", "laravel" ] ], selected: "rails") %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Combobox</h3>
        <%= render Ui::ComboboxComponent.new(name: "timezone", options: [ [ "Paris", "paris" ], [ "London", "london" ], [ "New York", "nyc" ], [ "Tokyo", "tokyo" ] ]) %>
      </div>

      <div class="flex flex-wrap items-center gap-8">
        <div class="flex items-center gap-2">
          <%= render Ui::CheckboxComponent.new(id: "terms") %>
          <%= render(Ui::LabelComponent.new(for_id: "terms")) { "Accept terms" } %>
        </div>
        <div class="flex items-center gap-2">
          <%= render Ui::SwitchComponent.new(id: "notifications", checked: true) %>
          <%= render(Ui::LabelComponent.new(for_id: "notifications")) { "Notifications" } %>
        </div>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Radio group</h3>
        <%= render Ui::RadioGroupComponent.new(name: "plan", options: [ [ "Free", "free" ], [ "Pro", "pro" ], [ "Team", "team" ] ], selected: "pro") %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Toggle &amp; toggle group</h3>
        <div class="flex items-center gap-4">
          <%= render(Ui::ToggleComponent.new) { "B" } %>
          <%= render Ui::ToggleGroupComponent.new(items: [ [ "Left", "left", false ], [ "Center", "center", true ], [ "Right", "right", false ] ]) %>
        </div>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Slider</h3>
        <%= render Ui::SliderComponent.new(name: "volume", value: 40) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Input OTP</h3>
        <%= render Ui::InputOtpComponent.new(name: "otp") %>
      </div>
    </section>

    <%# ───────────────────────── Overlays & menus ───────────────────────── %>
    <section class="space-y-6">
      <h2 class="text-lg font-semibold text-primary border-b border-primary pb-2">Overlays &amp; menus</h2>

      <div class="flex flex-wrap items-center gap-4">
        <%= render(Ui::DialogComponent.new) do |dialog| %>
          <% dialog.with_trigger { render(Ui::ButtonComponent.new) { "Open dialog" } } %>
          <% dialog.with_title { "Edit profile" } %>
          <% dialog.with_description { "Make changes to your profile here." } %>
          <% dialog.with_footer { render(Ui::ButtonComponent.new) { "Save" } } %>
          Profile form goes here.
        <% end %>

        <%= render(Ui::AlertDialogComponent.new(title: "Are you absolutely sure?", description: "This action cannot be undone.")) do |alert_dialog| %>
          <% alert_dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :destructive)) { "Delete account" } } %>
        <% end %>

        <%= render(Ui::SheetComponent.new(side: :right)) do |sheet| %>
          <% sheet.with_trigger { render(Ui::ButtonComponent.new(variant: :outline)) { "Open sheet" } } %>
          <% sheet.with_title { "Settings" } %>
          Sheet content slides in from the side.
        <% end %>

        <%= render(Ui::DrawerComponent.new) do |drawer| %>
          <% drawer.with_trigger { render(Ui::ButtonComponent.new(variant: :outline)) { "Open drawer" } } %>
          <% drawer.with_title { "Quick actions" } %>
          Drawer content slides up from the bottom.
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <%= render(Ui::PopoverComponent.new) do |popover| %>
          <% popover.with_trigger { render(Ui::ButtonComponent.new(variant: :outline)) { "Open popover" } } %>
          Place content for the popover here.
        <% end %>

        <%= render(Ui::TooltipComponent.new) do |tooltip| %>
          <% tooltip.with_trigger { render(Ui::ButtonComponent.new(variant: :outline)) { "Hover me" } } %>
          Add to library
        <% end %>

        <%= render(Ui::HoverCardComponent.new) do |hover_card| %>
          <% hover_card.with_trigger { render(Ui::ButtonComponent.new(variant: :link)) { "@hestia" } } %>
          <div class="flex gap-3">
            <%= render Ui::AvatarComponent.new(alt: "Hestia") %>
            <div>
              <p class="font-medium text-primary">Hestia</p>
              <p class="text-secondary">Personal finance, simplified.</p>
            </div>
          </div>
        <% end %>

        <%= render Ui::DropdownMenuComponent.new(items: [ [ "Profile", "profile" ], [ "Billing", "billing" ], :separator, [ "Log out", "logout" ] ]) do |menu| %>
          <% menu.with_trigger { render(Ui::ButtonComponent.new(variant: :outline)) { "Open menu" } } %>
        <% end %>

        <%= render Ui::MenubarComponent.new(menus: [
          [ "File", [ [ "New", "new" ], [ "Open", "open" ], :separator, [ "Save", "save" ] ] ],
          [ "Edit", [ [ "Undo", "undo" ], [ "Redo", "redo" ] ] ]
        ]) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Context menu (right-click)</h3>
        <%= render(Ui::ContextMenuComponent.new(items: [ [ "Reload", "reload" ], [ "Save page as…", "save" ], :separator, [ "Inspect", "inspect" ] ])) do %>
          <div class="flex h-24 w-full items-center justify-center rounded-md border border-dashed border-primary text-sm text-secondary">
            Right-click here
          </div>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Navigation menu</h3>
        <%= render(Ui::NavigationMenuComponent.new) do |nav| %>
          <% nav.with_menu(label: "Product", key: "product") do %>
            <p class="text-sm font-medium text-primary mb-1">Product</p>
            <p class="text-sm text-secondary">Budgets, accounts, and reports.</p>
          <% end %>
          <% nav.with_menu(label: "Resources", key: "resources") do %>
            <p class="text-sm font-medium text-primary mb-1">Resources</p>
            <p class="text-sm text-secondary">Guides, blog, and changelog.</p>
          <% end %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Command palette</h3>
        <%= render Ui::CommandComponent.new(groups: [
          [ "Suggestions", [ [ "Calendar", "calendar" ], [ "Search emoji", "emoji" ] ] ],
          [ "Settings", [ [ "Profile", "profile" ], [ "Billing", "billing" ] ] ]
        ]) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Sonner (toast)</h3>
        <button type="button" onclick='window.dispatchEvent(new CustomEvent("toast:show", { detail: { title: "Event created", description: "Friday, June 26 at 10:00 AM", variant: "success" } }))'
          class="inline-flex h-9 items-center rounded-md px-4 text-sm font-medium text-primary bg-button-secondary hover:bg-button-secondary-hover">
          Show toast
        </button>
      </div>
    </section>

    <%# ───────────────────────── Navigation ───────────────────────── %>
    <section class="space-y-6">
      <h2 class="text-lg font-semibold text-primary border-b border-primary pb-2">Navigation</h2>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Tabs</h3>
        <%= render(Ui::TabsComponent.new(default: "overview")) do |tabs| %>
          <% tabs.with_tab(label: "Overview", value: "overview") { "Overview content." } %>
          <% tabs.with_tab(label: "Analytics", value: "analytics") { "Analytics content." } %>
          <% tabs.with_tab(label: "Settings", value: "settings") { "Settings content." } %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Breadcrumb</h3>
        <%= render Ui::BreadcrumbComponent.new(items: [ [ "Home", "/" ], [ "Settings", "/settings" ], [ "Profile", nil ] ]) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Pagination</h3>
        <%= render Ui::PaginationComponent.new(current: 3, total: 8, path: ->(page) { "?page=#{page}" }) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Sidebar</h3>
        <%= render(Ui::SidebarComponent.new) do |sidebar| %>
          <% sidebar.with_header { tag.span("Hestia", class: "font-semibold text-primary") } %>
          <%= render(Ui::ItemComponent.new(href: "#")) { |item| item.with_title { "Dashboard" } } %>
          <%= render(Ui::ItemComponent.new(href: "#")) { |item| item.with_title { "Budgets" } } %>
          <%= render(Ui::ItemComponent.new(href: "#")) { |item| item.with_title { "Settings" } } %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Carousel</h3>
        <%= render(Ui::CarouselComponent.new) do |carousel| %>
          <% [ "Slide 1", "Slide 2", "Slide 3" ].each do |label| %>
            <% carousel.with_slide do %>
              <div class="flex h-40 items-center justify-center rounded-lg border border-primary bg-surface text-secondary"><%= label %></div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>

    <%# ───────────────────────── Data display ───────────────────────── %>
    <section class="space-y-6">
      <h2 class="text-lg font-semibold text-primary border-b border-primary pb-2">Data display</h2>

      <div class="flex flex-wrap items-center gap-4">
        <%= render Ui::AvatarComponent.new(alt: "Ada Lovelace") %>
        <%= render Ui::BadgeComponent.new { "New" } %>
        <%= render Ui::BadgeComponent.new(variant: :success) { "Active" } %>
        <%= render Ui::BadgeComponent.new(variant: :destructive) { "Overdue" } %>
        <%= render(Ui::KbdComponent.new) { "⌘K" } %>
      </div>

      <%= render(Ui::CardComponent.new) do |card| %>
        <% card.with_title { "Monthly budget" } %>
        <% card.with_description { "Track how much you have left to spend." } %>
        <% card.with_footer { render(Ui::ButtonComponent.new(size: :sm)) { "View details" } } %>
        <%= render Ui::ProgressComponent.new(value: 64) %>
      <% end %>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Table</h3>
        <%= render Ui::TableComponent.new(
          headers: [ "Name", "Status", "Amount" ],
          rows: [ [ "Rent", render(Ui::BadgeComponent.new(variant: :success)) { "Paid" }, "€950" ],
                  [ "Internet", render(Ui::BadgeComponent.new(variant: :warning)) { "Due" }, "€35" ] ]
        ) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Chart</h3>
        <%= render Ui::ChartComponent.new(data: [ [ "Jan", 42 ], [ "Feb", 73 ], [ "Mar", 55 ], [ "Apr", 90 ], [ "May", 61 ] ]) %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Calendar</h3>
        <%= render Ui::CalendarComponent.new %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Item</h3>
        <%= render(Ui::ItemComponent.new(href: "#")) do |item| %>
          <% item.with_leading { render Ui::AvatarComponent.new(alt: "Grace Hopper") } %>
          <% item.with_title { "Grace Hopper" } %>
          <% item.with_description { "grace@hestia.app" } %>
          <% item.with_trailing { render Ui::BadgeComponent.new(variant: :outline) { "Admin" } } %>
        <% end %>
      </div>
    </section>

    <%# ───────────────────────── Feedback & layout ───────────────────────── %>
    <section class="space-y-6">
      <h2 class="text-lg font-semibold text-primary border-b border-primary pb-2">Feedback &amp; layout</h2>

      <div class="space-y-3">
        <%= render(Ui::AlertComponent.new) { "Heads up — this is a default alert." } %>
        <%= render(Ui::AlertComponent.new(variant: :destructive)) { "Something went wrong." } %>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <%= render Ui::SpinnerComponent.new %>
        <%= render Ui::SkeletonComponent.new(class_name: "h-4 w-48") %>
        <div class="flex items-center gap-2">
          <%= render Ui::SeparatorComponent.new %>
        </div>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Empty state</h3>
        <%= render(Ui::EmptyComponent.new) do |empty| %>
          <% empty.with_title { "No transactions yet" } %>
          <% empty.with_description { "Connect a bank account to start tracking your spending." } %>
          <% empty.with_action { render(Ui::ButtonComponent.new) { "Connect account" } } %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Aspect ratio</h3>
        <div class="w-64">
          <%= render(Ui::AspectRatioComponent.new) do %>
            <div class="flex size-full items-center justify-center rounded-md bg-surface-inset text-secondary text-sm">16:9</div>
          <% end %>
        </div>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Scroll area</h3>
        <%= render(Ui::ScrollAreaComponent.new(class_name: "h-32 w-64 rounded-md border border-primary p-3")) do %>
          <% 10.times do |i| %><p class="text-sm text-secondary py-1">Item <%= i + 1 %></p><% end %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Accordion</h3>
        <%= render(Ui::AccordionComponent.new) do |accordion| %>
          <% accordion.with_item(title: "Is it accessible?", key: "a1") { "Yes, it adheres to standard ARIA patterns." } %>
          <% accordion.with_item(title: "Is it styled?", key: "a2") { "Yes, with the Hestia design tokens." } %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Collapsible</h3>
        <%= render(Ui::CollapsibleComponent.new) do |collapsible| %>
          <% collapsible.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { "Toggle details" } } %>
          Additional details revealed on toggle.
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Resizable</h3>
        <%= render(Ui::ResizableComponent.new) do |resizable| %>
          <% resizable.with_first { "Left pane" } %>
          <% resizable.with_second { "Right pane" } %>
        <% end %>
      </div>

      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary">Direction</h3>
        <%= render(Ui::DirectionComponent.new(dir: :rtl)) do %>
          <p class="text-sm text-primary">هذا النص من اليمين إلى اليسار.</p>
        <% end %>
      </div>
    </section>

  </main>
</div>
