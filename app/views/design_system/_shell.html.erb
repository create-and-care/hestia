<%# The 256px sidebar used to be rendered at every width, so at 390px the page
    was 470px wide and scrolled sideways — the largest overflow_page finding in
    visual:check, on the very pages that document how not to do this (DS-07).
    It now follows the app's own pattern: hidden below md, with the same nav
    relocated into a drawer behind a top bar. %>
<div class="flex min-h-screen">
  <%= render(Ui::SidebarComponent.new(class_name: "shrink-0 max-md:hidden")) do |sidebar| %>
    <% sidebar.with_header do %>
      <%= link_to "Hestia · Design system", design_system_path,
            class: "flex min-h-9 items-center text-sm font-semibold text-primary" %>
    <% end %>

    <%= render "design_system/nav" %>
  <% end %>

  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between border-b border-primary px-4 py-3 md:justify-end md:px-8">
      <div class="md:hidden">
      <%= render(Ui::DrawerComponent.new(side: :left, close_on_visit: true)) do |drawer| %>
        <% drawer.with_trigger do %>
          <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm,
                html_options: { aria: { label: "Ouvrir la navigation" } })) do %>
            <%= lucide_icon("menu", css_class: "size-5") %>
          <% end %>
        <% end %>

        <nav class="flex h-full flex-col gap-1 overflow-y-auto p-4">
          <%= link_to "Hestia · Design system", design_system_path,
                class: "flex min-h-9 items-center text-sm font-semibold text-primary" %>
          <%= render "design_system/nav" %>
        </nav>
      <% end %>
      </div>

      <%= render Ui::ThemeToggleComponent.new %>
    </div>
    <main class="mx-auto max-w-3xl px-4 py-10 md:px-8">
      <%= yield %>
    </main>
  </div>
</div>
