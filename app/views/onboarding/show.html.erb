<% content_for :title, "Bienvenue" %>

<div class="mx-auto mt-16 max-w-lg px-4">
  <h1 class="mb-2 text-2xl font-semibold">Configurons votre foyer</h1>
  <p class="mb-6 text-gray-600">Créez un nouveau foyer, ou rejoignez-en un avec un code d'invitation.</p>

  <%= render "shared/flash" %>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= link_to new_household_path, class: "block rounded-lg border border-gray-200 p-5 hover:border-gray-400" do %>
      <h2 class="mb-1 font-medium">Créer un foyer</h2>
      <p class="text-sm text-gray-600">Vous serez l'administrateur et pourrez inviter d'autres membres.</p>
    <% end %>

    <%= link_to new_membership_path, class: "block rounded-lg border border-gray-200 p-5 hover:border-gray-400" do %>
      <h2 class="mb-1 font-medium">Rejoindre un foyer</h2>
      <p class="text-sm text-gray-600">Saisissez le code d'invitation partagé par un membre.</p>
    <% end %>
  </div>

  <p class="mt-6 text-sm text-gray-600">
    <%= button_to "Se déconnecter", session_path, method: :delete, class: "cursor-pointer underline" %>
  </p>
</div>