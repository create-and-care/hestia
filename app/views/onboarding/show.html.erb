<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-lg px-4">
  <h1 class="mb-2 text-2xl font-semibold"><%= t(".heading") %></h1>
  <p class="mb-6 text-gray-600"><%= t(".description") %></p>

  <%= render "shared/flash" %>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= link_to new_household_path, class: "block rounded-lg border border-gray-200 p-5 hover:border-gray-400" do %>
      <h2 class="mb-1 font-medium"><%= t(".create_household") %></h2>
      <p class="text-sm text-gray-600"><%= t(".create_household_description") %></p>
    <% end %>

    <%= link_to new_membership_path, class: "block rounded-lg border border-gray-200 p-5 hover:border-gray-400" do %>
      <h2 class="mb-1 font-medium"><%= t(".join_household") %></h2>
      <p class="text-sm text-gray-600"><%= t(".join_household_description") %></p>
    <% end %>
  </div>

  <p class="mt-6 text-sm text-gray-600">
    <%= button_to t(".sign_out"), session_path, method: :delete, class: "cursor-pointer underline" %>
  </p>
</div>
