<div class="space-y-8">
  <p class="text-sm text-secondary">
    <%= t("roadmap.show.description") %>
  </p>

  <section>
    <h2 class="mb-3 font-medium"><%= t("roadmap.show.progress_heading") %></h2>
    <ul class="divide-y divide-primary rounded-lg border border-primary">
      <% phases.each do |phase| %>
        <% badge_variant, badge_label = case phase[:status]
           when :done then [ :success, t("roadmap.show.status.done") ]
           when :partial then [ :warning, t("roadmap.show.status.partial") ]
           else [ :secondary, t("roadmap.show.status.todo") ]
           end %>
        <li class="flex items-start justify-between gap-4 px-4 py-3">
          <div>
            <p class="font-medium"><%= phase[:name] %></p>
            <p class="text-sm text-secondary"><%= phase[:detail] %></p>
          </div>
          <%= render(Ui::BadgeComponent.new(variant: badge_variant, html_options: { class: "mt-0.5 shrink-0" })) { badge_label } %>
        </li>
      <% end %>
    </ul>
  </section>

  <section>
    <h2 class="mb-1 font-medium"><%= t("roadmap.show.improvements_heading") %></h2>
    <p class="mb-3 text-sm text-secondary">
      <%= t("roadmap.show.improvements_description") %>
    </p>

    <%= render(Ui::AccordionComponent.new(multiple: true)) do |accordion| %>
      <% improvements.each do |group| %>
        <% group_title = capture do %>
          <span class="flex flex-1 items-center justify-between pr-2">
            <span><span class="mr-1"><%= group[:emoji] %></span><%= group[:category] %></span>
            <span class="text-sm text-secondary"><%= pluralize(group[:items].size, "item") %></span>
          </span>
        <% end %>
        <% accordion.with_item(title: group_title, key: group[:category].parameterize) do %>
          <ul class="space-y-2 px-4 text-sm text-secondary">
            <% group[:items].each do |item| %>
              <li class="flex gap-2">
                <span class="text-subdued">—</span>
                <span><%= item %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
