<%# Vertical timeline: past waves first (oldest to newest), an "Aujourd'hui"/"Today"
    divider, then upcoming work in intent order (no committed date yet). Two independent
    <ol>s (rather than one) so each gets its own connecting line — the divider sits
    between them undisturbed instead of a single line running behind it. %>
<% done_milestones, upcoming_milestones = milestones.partition { |milestone| milestone[:status] == :done } %>

<div class="space-y-8">
  <p class="text-sm text-secondary"><%= t("roadmap.show.description") %></p>

  <% if done_milestones.any? %>
    <div class="relative">
      <div class="absolute left-5 top-5 bottom-5 w-px bg-border-primary" aria-hidden="true"></div>

      <ol class="relative space-y-10">
        <% done_milestones.each do |milestone| %>
          <li class="relative pl-14">
            <span class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-full border border-success/30 bg-surface-inset text-success">
              <%= lucide_icon(milestone[:icon], css_class: "size-5") %>
            </span>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-2">
              <%= render(Ui::BadgeComponent.new(variant: :success)) { t("roadmap.show.status.done") } %>
            </div>

            <h3 class="mt-1 font-medium"><%= milestone[:title] %></h3>

            <ul class="mt-2 space-y-1.5 text-sm text-secondary">
              <% milestone[:items].each do |item| %>
                <li class="flex gap-2">
                  <span class="mt-2 size-1 shrink-0 rounded-full bg-subdued" aria-hidden="true"></span>
                  <span><%= item %></span>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% if done_milestones.any? && upcoming_milestones.any? %>
    <div class="flex items-center gap-3" role="separator">
      <span class="h-px flex-1 bg-border-primary"></span>
      <span class="text-xs font-medium uppercase tracking-wide text-subdued"><%= t("roadmap.show.today") %></span>
      <span class="h-px flex-1 bg-border-primary"></span>
    </div>
  <% end %>

  <% if upcoming_milestones.any? %>
    <div class="relative">
      <div class="absolute left-5 top-5 bottom-5 w-px border-l border-dashed border-primary" aria-hidden="true"></div>

      <ol class="relative space-y-10">
        <% upcoming_milestones.each do |milestone| %>
          <li class="relative pl-14">
            <span class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-full border border-primary bg-surface-inset text-subdued">
              <%= lucide_icon(milestone[:icon], css_class: "size-5") %>
            </span>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-2">
              <%= render(Ui::BadgeComponent.new(variant: :secondary)) { t("roadmap.show.status.upcoming") } %>
            </div>

            <h3 class="mt-1 font-medium"><%= milestone[:title] %></h3>

            <ul class="mt-2 space-y-1.5 text-sm text-secondary">
              <% milestone[:items].each do |item| %>
                <li class="flex gap-2">
                  <span class="mt-2 size-1 shrink-0 rounded-full bg-subdued" aria-hidden="true"></span>
                  <span><%= item %></span>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>
</div>
