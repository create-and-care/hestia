<%# Vertical timeline, read from what's next down to what shipped: upcoming work
    first, split into V1 (launch-blocking or strongly recommended before other
    households self-host) and V2 (feature depth that can wait), then an
    "Aujourd'hui"/"Today" divider, then past deliveries newest-first. A roadmap
    is consulted for where the project is going; the archive is the part you
    scroll to, not the part you scroll past. Each block gets its own connecting
    line via "roadmap/timeline" — a divider sits between them undisturbed
    instead of a single line running behind it. %>
<% done_milestones, upcoming_milestones = milestones.partition { |milestone| milestone[:status] == :done } %>
<% done_milestones = done_milestones.reverse %>
<% v1_milestones, v2_milestones = upcoming_milestones.partition { |milestone| milestone[:release] == :v1 } %>

<div class="space-y-8">
  <p class="text-sm text-secondary"><%= t("roadmap.show.description") %></p>

  <% if v1_milestones.any? %>
    <%= render "roadmap/divider", label: t("roadmap.show.release.v1") %>
    <%= render "roadmap/timeline", milestones: v1_milestones, done: false %>
  <% end %>

  <% if v2_milestones.any? %>
    <%= render "roadmap/divider", label: t("roadmap.show.release.v2") %>
    <%= render "roadmap/timeline", milestones: v2_milestones, done: false %>
  <% end %>

  <% if upcoming_milestones.any? && done_milestones.any? %>
    <%= render "roadmap/divider", label: t("roadmap.show.today") %>
  <% end %>

  <% if done_milestones.any? %>
    <%= render "roadmap/timeline", milestones: done_milestones, done: true %>
  <% end %>
</div>
