<% content_for :title, @list.name %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:gifts, [ @list.name, nil ], module_path: gift_lists_path) %></div>

  <header class="mb-4 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold">
      <%= lucide_icon("gift", css_class: "size-6") %> <%= @list.name %>
      <span class="text-sm text-subdued">(<%= perspective_label(@list.perspective) %><%= " · #{@list.theme}" if @list.theme.present? %>)</span>
      <% if @list.restricted? %><%= render(Ui::BadgeComponent.new(variant: :secondary)) { t(".restricted_badge") } %><% end %>
    </h1>
    <div class="flex items-center gap-2">
      <% if @list.created_by_id.nil? || @list.created_by_id == Current.user.id %>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: edit_gift_list_path(@list))) { t(".edit") } %>
      <% end %>
      <%= render(Ui::AlertDialogComponent.new(title: t(".delete_confirm"), confirm_label: t(".delete"),
            confirm_url: gift_list_path(@list), confirm_method: :delete)) do |alert_dialog| %>
        <% alert_dialog.with_trigger do %>
          <%= render(Ui::ButtonComponent.new(variant: :destructive, size: :sm)) { t(".delete") } %>
        <% end %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <% if @list.perspective == "receive" %>
    <%= render(Ui::CardComponent.new(class_name: "mb-6")) do |card| %>
      <% card.with_title { t(".public_sharing") } %>
      <% if @list.shared? %>
        <p class="mb-2 text-sm text-secondary"><%= t(".share_link_description") %></p>
        <div class="flex items-center gap-2">
          <code class="block flex-1 rounded bg-surface-inset px-3 py-2 text-sm break-all"><%= public_gift_list_url(@list.gift_list_share.token) %></code>
          <%= render(Ui::CopyButtonComponent.new(value: public_gift_list_url(@list.gift_list_share.token), label: t("circles.copy_code"),
                html_options: { class: "shrink-0" })) %>
        </div>
        <%= form_with url: gift_list_share_path(@list), method: :delete, class: "mt-2" do %>
          <%= render(Ui::ButtonComponent.new(type: "submit", variant: :ghost, size: :sm)) { t(".disable_link") } %>
        <% end %>
      <% else %>
        <%= form_with url: gift_list_share_path(@list), method: :post do %>
          <%= render(Ui::ButtonComponent.new(type: "submit", variant: :outline, size: :sm)) { t(".enable_link") } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <section class="mb-6">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="font-medium"><%= t(".ideas") %></h2>
      <%= render(Ui::DialogComponent.new) do |dialog| %>
        <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { t(".add") } } %>
        <% dialog.with_title { t(".idea_placeholder") } %>
        <%= render "gift_ideas/form", list: @list, idea: @idea %>
      <% end %>
    </div>
    <% if @ideas.any? %>
      <ul class="mb-3 space-y-2">
        <% @ideas.each do |idea| %>
          <li class="rounded-lg border border-primary px-3 py-2 text-sm">
            <div class="flex items-center justify-between gap-2">
              <span>
                <span class="font-medium"><%= idea.name %></span>
                <% if idea.price %>· <%= number_to_currency(idea.price, unit: "€", format: "%n %u") %><% end %>
                <% if (idea_url = safe_url(idea.url)) %>· <%= link_to t(".link_label"), idea_url, target: "_blank", rel: "noopener", class: "underline" %><% end %>
              </span>
              <div class="flex shrink-0 items-center gap-2">
                <%= form_with url: gift_list_gift_idea_path(@list, idea), method: :patch, class: "inline" do %>
                  <input type="hidden" name="gift_idea[status]" value="<%= idea.status == "wanted" ? "bought" : "wanted" %>">
                  <%= render(Ui::ButtonComponent.new(type: "submit", variant: idea.status == "bought" ? :secondary : :outline, size: :sm)) { gift_status_label(idea.status) } %>
                <% end %>
                <%= form_with url: gift_list_gift_idea_path(@list, idea), method: :delete, class: "inline",
                      data: { turbo_confirm: t(".delete_idea_confirm") } do %>
                  <%= render(Ui::ButtonComponent.new(type: "submit", variant: :ghost, size: :icon, html_options: { "aria-label": t(".delete_idea") })) { "×" } %>
                <% end %>
              </div>
            </div>
            <% if idea.photo.attached? %>
              <%= image_tag idea.photo.variant(resize_to_limit: [ 200, 200 ]), alt: "", class: "mt-2 max-h-32 w-auto rounded-md object-cover" %>
            <% end %>
            <% if idea.comment.present? %><p class="mt-1 text-secondary"><%= idea.comment %></p><% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_ideas") } } %>
    <% end %>
  </section>
</div>
