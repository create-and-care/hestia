<% content_for :title, @list.name %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <header class="mb-4 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("gift", css_class: "size-6") %> <%= @list.name %> <span class="text-sm text-gray-400">(<%= perspective_label(@list.perspective) %>)</span></h1>
    <%= button_to t(".delete"), gift_list_path(@list), method: :delete,
          form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "cursor-pointer text-sm text-red-600 underline" %>
  </header>

  <%= render "shared/flash" %>

  <% if @list.perspective == "receive" %>
    <%= render(Ui::CardComponent.new(class_name: "mb-6")) do |card| %>
      <% card.with_title { t(".public_sharing") } %>
      <% if @list.shared? %>
        <p class="mb-2 text-sm text-gray-600"><%= t(".share_link_description") %></p>
        <code class="block rounded bg-gray-100 px-3 py-2 text-sm break-all"><%= public_gift_list_url(@list.gift_list_share.token) %></code>
        <%= button_to t(".disable_link"), gift_list_share_path(@list), method: :delete, class: "mt-2 cursor-pointer text-sm text-red-600 underline" %>
      <% else %>
        <%= button_to t(".enable_link"), gift_list_share_path(@list), method: :post,
              class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
      <% end %>
    <% end %>
  <% end %>

  <section class="mb-6">
    <h2 class="mb-2 font-medium"><%= t(".ideas") %></h2>
    <ul class="mb-3 space-y-2">
      <% @list.gift_ideas.ordered.each do |idea| %>
        <li class="flex items-center justify-between rounded-lg border border-gray-200 px-3 py-2 text-sm">
          <span>
            <span class="font-medium"><%= idea.name %></span>
            <% if idea.price %>· <%= number_to_currency(idea.price, unit: "€", format: "%n %u") %><% end %>
            <% if (idea_url = safe_url(idea.url)) %>· <%= link_to t(".link_label"), idea_url, target: "_blank", rel: "noopener", class: "underline" %><% end %>
            <%= render(Ui::BadgeComponent.new(variant: :secondary, html_options: { class: "ml-1" })) { gift_status_label(idea.status) } %>
          </span>
          <%= button_to "×", gift_list_gift_idea_path(@list, idea), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" %>
        </li>
      <% end %>
    </ul>
    <%= form_with model: [ @list, @idea ], url: gift_list_gift_ideas_path(@list), class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= render Ui::InputComponent.new(name: "gift_idea[name]", value: @idea.name, placeholder: t(".idea_placeholder"),
            html_options: { id: "gift_idea_name", required: true, class: "flex-1" }) %>
      <%= render Ui::InputComponent.new(type: "number", name: "gift_idea[price]", value: @idea.price, placeholder: "€",
            html_options: { id: "gift_idea_price", step: "any", class: "w-20" }) %>
      <%= render Ui::InputComponent.new(type: "url", name: "gift_idea[url]", value: @idea.url, placeholder: t(".link_placeholder"),
            html_options: { id: "gift_idea_url", class: "w-40" }) %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add") } %>
    <% end %>
  </section>

  <p class="text-sm"><%= link_to t(".back_to_gifts"), gift_lists_path, class: "underline" %></p>
</div>
