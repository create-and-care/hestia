<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:gifts) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("gift", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= render(Ui::DialogComponent.new) do |dialog| %>
      <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :default, size: :sm)) { t(".new_list") } } %>
      <% dialog.with_title { t(".new_list") } %>
      <%= render "form", list: @list %>
    <% end %>
  </header>

  <%= render "shared/flash" %>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("package", css_class: "size-5") %> <%= t(".receive") %></h2>
    <div class="mb-2 divide-y divide-primary rounded-lg border border-primary">
      <% @receive_lists.each do |list| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title { link_to list.name, gift_list_path(list), class: "hover:underline" } %>
          <% if list.shared? %>
            <% item.with_trailing do %>
              <span class="inline-flex items-center gap-1 text-xs text-subdued"><%= lucide_icon("link", css_class: "size-3.5") %> <%= t(".shared_badge") %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% if @receive_lists.empty? %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_list") } } %>
    <% elsif @receive_limited %>
      <div class="mt-2"><%= link_to t(".see_more"), gift_lists_path(receive_all: 1, give_all: params[:give_all]), class: "text-sm underline" %></div>
    <% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("gift", css_class: "size-5") %> <%= t(".give") %></h2>
    <div class="mb-2 divide-y divide-primary rounded-lg border border-primary">
      <% @give_lists.each do |list| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title { link_to list.name, gift_list_path(list), class: "hover:underline" } %>
          <% if list.contact %>
            <% item.with_trailing do %>
              <span class="text-xs text-subdued"><%= t(".for_contact") %> <%= list.contact.name %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% if @give_lists.empty? %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_list") } } %>
    <% elsif @give_limited %>
      <div class="mt-2"><%= link_to t(".see_more"), gift_lists_path(give_all: 1, receive_all: params[:receive_all]), class: "text-sm underline" %></div>
    <% end %>
  </section>

</div>
