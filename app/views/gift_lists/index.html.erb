<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:gifts) %></div>

  <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("gift", css_class: "size-6") %> <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("package", css_class: "size-5") %> <%= t(".receive") %></h2>
    <div class="mb-2 divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @receive_lists.each do |list| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title { link_to list.name, gift_list_path(list), class: "hover:underline" } %>
          <% if list.shared? %>
            <% item.with_trailing do %>
              <span class="inline-flex items-center gap-1 text-xs text-gray-400"><%= lucide_icon("link", css_class: "size-3.5") %> <%= t(".shared_badge") %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% if @receive_lists.empty? %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_list") } } %>
    <% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("gift", css_class: "size-5") %> <%= t(".give") %></h2>
    <div class="mb-2 divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @give_lists.each do |list| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title { link_to list.name, gift_list_path(list), class: "hover:underline" } %>
          <% if list.contact %>
            <% item.with_trailing do %>
              <span class="text-xs text-gray-400"><%= t(".for_contact") %> <%= list.contact.name %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% if @give_lists.empty? %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_list") } } %>
    <% end %>
  </section>

  <%= render(Ui::CardComponent.new) do |card| %>
    <% card.with_title { t(".new_list") } %>
    <%= form_with model: @list, url: gift_lists_path, class: "flex flex-wrap items-end gap-2", data: { controller: "field-visibility", field_visibility_show_when_value: [ "give" ].to_json } do |form| %>
      <%= render Ui::InputComponent.new(name: "gift_list[name]", value: @list.name, placeholder: t(".name_placeholder"),
            html_options: { id: "gift_list_name", required: true, class: "flex-1" }) %>
      <%= render Ui::NativeSelectComponent.new(name: "gift_list[perspective]",
            options: [ [ t(".receive"), "receive" ], [ t(".give"), "give" ] ],
            selected: @list.perspective, html_options: { id: "gift_list_perspective", class: "!w-auto", data: { field_visibility_target: "trigger", action: "change->field-visibility#refresh" } }) %>
      <div data-field-visibility-target="field">
        <%= render Ui::NativeSelectComponent.new(name: "gift_list[contact_id]",
              options: [ [ t(".recipient_placeholder"), "" ] ] + contact_options,
              selected: @list.contact_id, html_options: { id: "gift_list_contact_id", class: "!w-auto" }) %>
      </div>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".create") } %>
    <% end %>
  <% end %>

</div>
