<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-2xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:gifts) %></div>

  <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("gift", css_class: "size-6") %> <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("package", css_class: "size-5") %> <%= t(".receive") %></h2>
    <ul class="mb-2 divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @receive_lists.each do |list| %>
        <li class="flex items-center justify-between px-4 py-2">
          <%= link_to list.name, gift_list_path(list), class: "font-medium hover:underline" %>
          <span class="inline-flex items-center gap-1 text-xs text-gray-400"><% if list.shared? %><%= lucide_icon("link", css_class: "size-3.5") %> <%= t(".shared_badge") %><% end %></span>
        </li>
      <% end %>
    </ul>
    <% if @receive_lists.empty? %><p class="text-sm text-gray-500"><%= t(".no_list") %></p><% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("gift", css_class: "size-5") %> <%= t(".give") %></h2>
    <ul class="mb-2 divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @give_lists.each do |list| %>
        <li class="flex items-center justify-between px-4 py-2">
          <%= link_to list.name, gift_list_path(list), class: "font-medium hover:underline" %>
          <% if list.contact %><span class="text-xs text-gray-400"><%= t(".for_contact") %> <%= list.contact.name %></span><% end %>
        </li>
      <% end %>
    </ul>
    <% if @give_lists.empty? %><p class="text-sm text-gray-500"><%= t(".no_list") %></p><% end %>
  </section>

  <section class="rounded-lg border border-gray-200 p-4">
    <h2 class="mb-2 font-medium"><%= t(".new_list") %></h2>
    <%= form_with model: @list, url: gift_lists_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: t(".name_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.select :perspective, [ [ t(".receive"), "receive" ], [ t(".give"), "give" ] ], {}, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.select :contact_id, contact_options, { include_blank: t(".recipient_placeholder") }, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".create"), class: "cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>
  </section>

</div>
