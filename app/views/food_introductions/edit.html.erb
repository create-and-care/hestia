<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:baby, [ @baby.name, baby_profile_path(@baby) ], [ t(".title"), nil ], module_path: baby_profiles_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @introduction, url: baby_profile_food_introduction_path(@baby, @introduction) do %>
    <% if @introduction.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @introduction.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "food_introduction_food")) do |field| %>
        <% field.with_label { t(".food_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "text", name: "food_introduction[food]", value: @introduction.food,
                html_options: { id: "food_introduction_food", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "food_introduction_introduced_on")) do |field| %>
        <% field.with_label { t(".introduced_on_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "food_introduction[introduced_on]", value: @introduction.introduced_on,
                html_options: { id: "food_introduction_introduced_on" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "food_introduction_acceptance")) do |field| %>
        <% field.with_label { t(".acceptance_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "food_introduction[acceptance]",
                options: [ [ t("baby_profiles.show.acceptance_blank"), "" ] ] + t("baby_profiles.show.acceptance_options").map { |v| [ v, v ] },
                selected: @introduction.acceptance, html_options: { id: "food_introduction_acceptance" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    </div>
  <% end %>

</div>
