<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4">
    <% if @project.trip %>
      <%= module_breadcrumb(:trips, [ @project.trip.name, trip_path(@project.trip) ], [ @project.name, shared_project_path(@project) ], [ t(".title"), nil ], module_path: trips_path) %>
    <% else %>
      <%= module_breadcrumb(:budget, [ t("shared_projects.index.title"), shared_projects_path ], [ @project.name, shared_project_path(@project) ], [ t(".title"), nil ], module_path: budget_path) %>
    <% end %>
  </div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @expense, url: shared_project_shared_expense_path(@project, @expense) do |form| %>
    <% if @expense.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @expense.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "shared_expense_amount")) do |field| %>
        <% field.with_label { t(".amount_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "shared_expense[amount]", value: @expense.amount,
                html_options: { id: "shared_expense_amount", step: :any, required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "shared_expense_description")) do |field| %>
        <% field.with_label { t(".description_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "shared_expense[description]", value: @expense.description,
                html_options: { id: "shared_expense_description" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "shared_expense_spent_on")) do |field| %>
        <% field.with_label { t(".spent_on_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "shared_expense[spent_on]", value: @expense.spent_on,
                html_options: { id: "shared_expense_spent_on" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "shared_expense_shared_project_participant_id")) do |field| %>
        <% field.with_label { t(".payer_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "shared_expense[shared_project_participant_id]",
                options: [ [ t(".payer_blank"), "" ] ] + @project.shared_project_participants.map { |participant| [ participant.name, participant.id ] },
                selected: @expense.shared_project_participant_id, html_options: { id: "shared_expense_shared_project_participant_id" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".save") } %>
    </div>
  <% end %>

</div>
