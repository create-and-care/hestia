<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:pets, [ @pet.name, pet_path(@pet) ], [ t(".title"), nil ], module_path: pets_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @treatment, url: pet_treatment_path(@pet, @treatment) do %>
    <% if @treatment.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @treatment.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "pet_treatment_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "pet_treatment[name]", value: @treatment.name,
                html_options: { id: "pet_treatment_name", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pet_treatment_frequency")) do |field| %>
        <% field.with_label { t(".frequency_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "pet_treatment[frequency]", value: @treatment.frequency,
                html_options: { id: "pet_treatment_frequency" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pet_treatment_quantity")) do |field| %>
        <% field.with_label { t(".quantity_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "pet_treatment[quantity]", value: @treatment.quantity,
                html_options: { id: "pet_treatment_quantity" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pet_treatment_last_done_on")) do |field| %>
        <% field.with_label { t(".last_done_on_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "pet_treatment[last_done_on]", value: @treatment.last_done_on,
                html_options: { id: "pet_treatment_last_done_on" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pet_treatment_price")) do |field| %>
        <% field.with_label { t(".price_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "pet_treatment[price]", value: @treatment.price,
                html_options: { id: "pet_treatment_price", step: "0.01", min: 0 }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    </div>
  <% end %>

</div>
