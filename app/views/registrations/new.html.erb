<% content_for :title, "Inscription" %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold">Créer un compte Hestia</h1>

  <%= render "shared/flash" %>

  <%= form_with model: @user, url: registration_path do |form| %>
    <% if @user.errors.any? %>
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-inside list-disc">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= form.label :name, "Nom", class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name",
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :email_address, "Adresse e-mail", class: "mb-1 block text-sm font-medium" %>
        <%= form.email_field :email_address, required: true, autocomplete: "username",
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :password, "Mot de passe", class: "mb-1 block text-sm font-medium" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirmer le mot de passe", class: "mb-1 block text-sm font-medium" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <%= form.submit "S'inscrire", class: "w-full cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-gray-600">
    Déjà un compte ? <%= link_to "Se connecter", new_session_path, class: "font-medium text-gray-900 underline" %>
  </p>
</div>