<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:outdoor, [ t(".title"), nil ], module_path: exterior_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @pool, url: pool_path(@pool) do |form| %>
    <% if @pool.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @pool.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "pool_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "pool[name]", value: @pool.name,
                html_options: { id: "pool_name", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pool_treatment_type")) do |field| %>
        <% field.with_label { t(".treatment_type_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "pool[treatment_type]", options: treatment_options,
                selected: @pool.treatment_type, html_options: { id: "pool_treatment_type" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pool_service_provider_id")) do |field| %>
        <% field.with_label { t(".service_provider_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "pool[service_provider_id]",
                options: [ [ t(".no_service_provider"), "" ] ] + @service_providers.map { |provider| [ provider.name, provider.id ] },
                selected: @pool.service_provider_id, html_options: { id: "pool_service_provider_id" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".save") } %>
    </div>
  <% end %>

</div>
