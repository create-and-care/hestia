<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:waste, [ t(".title"), nil ], module_path: waste_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @event, url: waste_collection_event_path(@event) do %>
    <% if @event.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @event.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "waste_collection_event_waste_type")) do |field| %>
        <% field.with_label { t(".waste_type_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "waste_collection_event[waste_type]", options: waste_type_options,
                selected: @event.waste_type, html_options: { id: "waste_collection_event_waste_type" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "waste_collection_event_collected_on")) do |field| %>
        <% field.with_label { t(".collected_on_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "waste_collection_event[collected_on]", value: @event.collected_on,
                html_options: { id: "waste_collection_event_collected_on", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    </div>
  <% end %>

</div>
