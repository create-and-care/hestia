<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "cave" %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:wine_cellar) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("wine", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= form_with url: wine_cellars_path, method: :get do |form| %>
      <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"),
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
    <% end %>
  </header>

  <%= render "shared/flash" %>

  <%= form_with model: @cellar, url: wine_cellars_path, class: "mb-6 flex gap-2" do |form| %>
    <%= form.text_field :name, required: true, placeholder: t(".new_cellar_placeholder"),
          class: "flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm" %>
    <%= form.submit t(".create_cellar"), class: "cursor-pointer rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
  <% end %>

  <% if @query.present? %>
    <h2 class="mb-2 font-medium"><%= t(".results_for", query: @query) %></h2>
    <div class="space-y-2"><%= render @results %></div>
    <% if @results.empty? %><p class="text-sm text-gray-500"><%= t(".no_bottles_found") %></p><% end %>
  <% else %>
    <% if @cellars.empty? %>
      <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500"><%= t(".empty") %></p>
    <% end %>
    <% @cellars.each do |cellar| %>
      <section class="mb-6 rounded-lg border border-gray-200 p-4">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="font-medium"><%= cellar.name %> <span class="text-sm text-gray-400">(<%= t(".in_stock_count", count: cellar.bottles.in_stock.size) %>)</span></h2>
          <%= button_to t(".delete_cellar"), wine_cellar_path(cellar), method: :delete,
                form: { data: { turbo_confirm: t(".delete_cellar_confirm") } },
                class: "cursor-pointer text-xs text-red-600 hover:underline" %>
        </div>

        <div class="mb-3 space-y-2"><%= render cellar.bottles.ordered %></div>

        <%= form_with model: @bottle, url: bottles_path, class: "flex flex-wrap items-end gap-2" do |form| %>
          <%= form.hidden_field :wine_cellar_id, value: cellar.id %>
          <%= form.text_field :name, required: true, placeholder: t(".bottle_name_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.number_field :vintage, placeholder: t(".vintage_placeholder"), class: "w-24 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.text_field :region, placeholder: t(".region_placeholder"), class: "w-28 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.select :wine_type, wine_type_options, { include_blank: t(".type_blank") }, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.submit t(".add"), class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
        <% end %>
      </section>
    <% end %>
  <% end %>

</div>
