<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "cave" %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:wine_cellar) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("wine", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= form_with url: wine_cellars_path, method: :get do %>
      <label for="wine_cellars_q" class="sr-only"><%= t(".search_placeholder") %></label>
      <%= render Ui::InputComponent.new(type: "search", name: "q", value: @query, placeholder: t(".search_placeholder"),
            html_options: { id: "wine_cellars_q" }) %>
    <% end %>
  </header>

  <%= render "shared/flash" %>

  <%= form_with model: @cellar, url: wine_cellars_path, class: "mb-6 flex gap-2" do %>
    <label for="wine_cellar_name" class="sr-only"><%= t(".new_cellar_placeholder") %></label>
    <%= render Ui::InputComponent.new(name: "wine_cellar[name]", value: @cellar.name, placeholder: t(".new_cellar_placeholder"),
          html_options: { id: "wine_cellar_name", required: true, class: "flex-1" }) %>
    <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".create_cellar") } %>
  <% end %>

  <% if @query.present? %>
    <h2 class="mb-2 font-medium"><%= t(".results_for", query: @query) %></h2>
    <div class="space-y-2"><%= render partial: "bottles/bottle", collection: @results, as: :bottle, locals: { show_cellar: true } %></div>
    <% if @results.empty? %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_bottles_found") } } %>
    <% end %>
    <% if @results_total_pages > 1 %>
      <div class="mt-6 flex justify-center">
        <%= render Ui::PaginationComponent.new(current: @results_page, total: @results_total_pages,
              path: ->(page) { wine_cellars_path(q: @query, page: page) }) %>
      </div>
    <% end %>
  <% else %>
    <% if @cellars.empty? %>
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".empty") } } %>
    <% end %>
    <div id="wine_cellars">
    <% @cellars.each do |cellar| %>
      <%= render(Ui::CardComponent.new(class_name: "mb-6")) do %>
        <div class="mb-3 flex items-center justify-between">
          <h2 class="font-medium"><%= cellar.name %> <span class="text-sm text-secondary">(<%= t(".in_stock_count", count: cellar.bottles.count { |bottle| bottle.in_stock }) %>)</span></h2>
          <%= render(Ui::ButtonToComponent.new(wine_cellar_path(cellar), method: :delete, variant: :ghost, size: :sm,
                html_options: { form: { data: { turbo_confirm: t(".delete_cellar_confirm") } } })) { t(".delete_cellar") } %>
        </div>

        <div class="mb-3 space-y-2"><%= render partial: "bottles/bottle", collection: cellar.bottles.sort_by(&:name), as: :bottle %></div>

        <%= form_with model: @bottle, url: bottles_path, class: "flex flex-wrap items-end gap-2" do |form| %>
          <%= form.hidden_field :wine_cellar_id, value: cellar.id %>
          <div>
            <label for="bottle_name_<%= cellar.id %>" class="sr-only"><%= t(".bottle_name_placeholder") %></label>
            <%= render Ui::InputComponent.new(name: "bottle[name]", value: @bottle.name, placeholder: t(".bottle_name_placeholder"),
                  html_options: { id: "bottle_name_#{cellar.id}", required: true, class: "flex-1" }) %>
          </div>
          <div>
            <label for="bottle_vintage_<%= cellar.id %>" class="sr-only"><%= t(".vintage_placeholder") %></label>
            <%= render Ui::InputComponent.new(type: "number", name: "bottle[vintage]", value: @bottle.vintage, placeholder: t(".vintage_placeholder"),
                  html_options: { id: "bottle_vintage_#{cellar.id}", class: "w-24" }) %>
          </div>
          <div>
            <label for="bottle_region_<%= cellar.id %>" class="sr-only"><%= t(".region_placeholder") %></label>
            <%= render Ui::InputComponent.new(name: "bottle[region]", value: @bottle.region, placeholder: t(".region_placeholder"),
                  html_options: { id: "bottle_region_#{cellar.id}", class: "w-28" }) %>
          </div>
          <div>
            <label for="bottle_wine_type_<%= cellar.id %>" class="sr-only"><%= t(".wine_type_label") %></label>
            <%= render Ui::NativeSelectComponent.new(name: "bottle[wine_type]", options: [ [ t(".type_blank"), "" ] ] + wine_type_options,
                  selected: @bottle.wine_type, html_options: { id: "bottle_wine_type_#{cellar.id}" }) %>
          </div>
          <%= render(Ui::ButtonComponent.new(variant: :outline, type: "submit")) { t(".add") } %>
        <% end %>
      <% end %>
    <% end %>
    </div>
    <% if @total_pages > 1 %>
      <div class="mt-6 flex justify-center">
        <%= render Ui::PaginationComponent.new(current: @page, total: @total_pages,
              path: ->(page) { wine_cellars_path(page: page) }) %>
      </div>
    <% end %>
  <% end %>

</div>
