<% content_for :title, "Cave à vin" %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "cave" %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">🍷 Cave à vin</h1>
    <%= form_with url: wine_cellars_path, method: :get do |form| %>
      <%= form.search_field :q, value: @query, placeholder: "Rechercher une bouteille…",
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
    <% end %>
  </header>

  <%= render "shared/flash" %>

  <%= form_with model: @cellar, url: wine_cellars_path, class: "mb-6 flex gap-2" do |form| %>
    <%= form.text_field :name, required: true, placeholder: "Nouvelle cave (région, type…)",
          class: "flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm" %>
    <%= form.submit "Créer la cave", class: "cursor-pointer rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
  <% end %>

  <% if @query.present? %>
    <h2 class="mb-2 font-medium">Résultats pour « <%= @query %> »</h2>
    <div class="space-y-2"><%= render @results %></div>
    <% if @results.empty? %><p class="text-sm text-gray-500">Aucune bouteille trouvée.</p><% end %>
  <% else %>
    <% if @cellars.empty? %>
      <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">Créez une première cave pour commencer.</p>
    <% end %>
    <% @cellars.each do |cellar| %>
      <section class="mb-6 rounded-lg border border-gray-200 p-4">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="font-medium"><%= cellar.name %> <span class="text-sm text-gray-400">(<%= cellar.bottles.in_stock.size %> en stock)</span></h2>
          <%= button_to "Supprimer la cave", wine_cellar_path(cellar), method: :delete,
                form: { data: { turbo_confirm: "Supprimer cette cave et ses bouteilles ?" } },
                class: "cursor-pointer text-xs text-red-600 hover:underline" %>
        </div>

        <div class="mb-3 space-y-2"><%= render cellar.bottles.ordered %></div>

        <%= form_with model: @bottle, url: bottles_path, class: "flex flex-wrap items-end gap-2" do |form| %>
          <%= form.hidden_field :wine_cellar_id, value: cellar.id %>
          <%= form.text_field :name, required: true, placeholder: "Nom", class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.number_field :vintage, placeholder: "Millésime", class: "w-24 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.text_field :region, placeholder: "Région", class: "w-28 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.select :wine_type, wine_type_options, { include_blank: "Type" }, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
          <%= form.submit "Ajouter", class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to "← Tableau de bord", root_path, class: "underline" %></p>
</div>
