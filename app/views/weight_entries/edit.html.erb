<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @entry, url: weight_entry_path(@entry) do |form| %>
    <% if @entry.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @entry.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: form.field_id(:weight))) do |field| %>
        <% field.with_label { t(".weight_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: form.field_name(:weight), value: form.object.weight,
                html_options: { id: form.field_id(:weight), step: :any, required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: form.field_id(:recorded_on))) do |field| %>
        <% field.with_label { t(".recorded_on_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: form.field_name(:recorded_on), value: form.object.recorded_on,
                html_options: { id: form.field_id(:recorded_on), required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".save") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_wellbeing"), wellbeing_path, class: "underline" %></p>
</div>
