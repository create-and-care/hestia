<%= tag.div id: dom_id(address), class: "flex flex-wrap items-center gap-3 rounded-lg border border-gray-200 px-3 py-2" do %>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <span class="font-medium"><%= address.name %></span>
      <%= render(Ui::BadgeComponent.new(variant: :secondary)) { address_type_label(address.address_type) } %>
      <% if address.rating %><span class="text-xs text-yellow-600"><%= "★" * address.rating %></span><% end %>
    </div>
    <% if address.full_address.present? %>
      <p class="text-sm text-gray-500"><%= address.full_address %></p>
    <% end %>
  </div>

  <div class="flex shrink-0 items-center gap-2 text-sm">
    <% if address.phone.present? %>
      <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: "tel:#{address.phone}",
            html_options: { title: address.phone })) { lucide_icon("phone", css_class: "size-4") } %>
    <% end %>
    <% if address.maps_url %>
      <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: address.maps_url,
            html_options: { target: "_blank", rel: "noopener", title: t(".directions") })) { lucide_icon("map", css_class: "size-4") } %>
    <% end %>
    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: edit_address_path(address))) { lucide_icon("pencil", css_class: "size-4") } %>
    <%= button_to address_path(address), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
  </div>
<% end %>
