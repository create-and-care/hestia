<%= tag.div id: dom_id(address), class: "flex flex-wrap items-center gap-3 rounded-lg border border-primary px-3 py-2" do %>
  <% if address.photo.attached? %>
    <div class="size-12 shrink-0">
      <%= render(Ui::AspectRatioComponent.new) do %>
        <%= image_tag address.photo.variant(resize_to_fill: [ 48, 48 ]), alt: "", class: "size-full rounded-md object-cover" %>
      <% end %>
    </div>
  <% end %>

  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <span class="font-medium"><%= address.name %></span>
      <%= render(Ui::BadgeComponent.new(variant: :secondary)) { address_type_label(address.address_type) } %>
      <% if address.rating %><span class="text-xs text-warning"><%= "★" * address.rating %></span><% end %>
    </div>
    <% if address.full_address.present? %>
      <p class="text-sm text-secondary"><%= address.full_address %></p>
    <% end %>
  </div>

  <div class="flex shrink-0 items-center gap-2 text-sm">
    <% if address.phone.present? %>
      <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: "tel:#{address.phone}",
            html_options: { title: address.phone, aria: { label: t(".call_aria", phone: address.phone) } })) { lucide_icon("phone", css_class: "size-4") } %>
    <% end %>
    <% if address.maps_url %>
      <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: address.maps_url,
            html_options: { target: "_blank", rel: "noopener", title: t(".directions"), aria: { label: t(".directions") } })) { lucide_icon("map", css_class: "size-4") } %>
    <% end %>
    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: edit_address_path(address),
          html_options: { aria: { label: t(".edit_aria", name: address.name) } })) { lucide_icon("pencil", css_class: "size-4") } %>
    <%= button_to address_path(address), method: :delete, class: "cursor-pointer text-subdued hover:text-destructive",
          aria: { label: t(".delete_aria", name: address.name) },
          form: { data: { turbo_confirm: t(".delete_confirm", name: address.name) } } do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
  </div>
<% end %>
