<%= tag.div id: dom_id(address), class: "flex flex-wrap items-center gap-3 rounded-lg border border-gray-200 px-3 py-2" do %>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <span class="font-medium"><%= address.name %></span>
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600"><%= address_type_label(address.address_type) %></span>
      <% if address.rating %><span class="text-xs text-yellow-600"><%= "★" * address.rating %></span><% end %>
    </div>
    <% if address.full_address.present? %>
      <p class="text-sm text-gray-500"><%= address.full_address %></p>
    <% end %>
  </div>

  <div class="flex shrink-0 items-center gap-2 text-sm">
    <% if address.phone.present? %>
      <%= link_to "📞", "tel:#{address.phone}", class: "hover:opacity-70", title: address.phone %>
    <% end %>
    <% if address.maps_url %>
      <%= link_to "🗺", address.maps_url, target: "_blank", rel: "noopener", class: "hover:opacity-70", title: t(".directions") %>
    <% end %>
    <%= link_to "✎", edit_address_path(address), class: "text-gray-400 hover:text-gray-900" %>
    <%= button_to "✕", address_path(address), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" %>
  </div>
<% end %>
