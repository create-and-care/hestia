<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:addresses) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("map-pin", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex flex-wrap items-center gap-2">
      <%= form_with url: addresses_path, method: :get, class: "flex items-center gap-1" do |form| %>
        <%= form.select :address_type, address_type_options, { include_blank: t(".all_types"), selected: @type },
              class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
        <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"),
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
        <%= form.submit t(".search_submit"), class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_address_path)) { t(".new_address") } %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <div id="addresses" class="space-y-2">
    <%= render @addresses %>
  </div>
  <% if @addresses.empty? %>
    <div class="mt-4">
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".none") } %>
      <% end %>
    </div>
  <% end %>

</div>
