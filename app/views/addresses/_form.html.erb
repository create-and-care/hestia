<%= form_with model: address, url: url,
      data: { controller: "geocode-lookup", geocode_lookup_url_value: search_addresses_path,
              geocode_lookup_searching_text_value: t(".searching"),
              geocode_lookup_no_results_text_value: t(".no_results"),
              geocode_lookup_unavailable_text_value: t(".unavailable") } do |form| %>
  <% if address.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% address.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="mb-4 rounded-md border border-primary bg-surface-inset p-3">
    <label for="address_online_search" class="mb-1 block text-xs font-medium text-secondary"><%= t(".online_search_label") %></label>
    <div class="flex gap-1">
      <%= render Ui::InputComponent.new(type: "text", placeholder: t(".place_name_placeholder"),
            html_options: { id: "address_online_search", autocomplete: "off",
                            data: { geocode_lookup_target: "query", action: "keydown.enter->geocode-lookup#onKeydown" } }) %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, type: "button",
            html_options: { data: { action: "click->geocode-lookup#search" } })) { lucide_icon("search", css_class: "size-4") } %>
    </div>
    <div id="address_online_search_results" data-geocode-lookup-target="results" role="listbox" aria-label="<%= t(".results_aria") %>" class="mt-1" aria-live="polite"></div>
    <p class="mt-1 text-xs text-subdued"><%= t(".manual_entry_hint") %></p>
  </div>

  <div class="space-y-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= render(Ui::FieldComponent.new(id: "address_name")) do |field| %>
          <% field.with_label { t(".name_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "text", name: "address[name]", value: address.name,
                  html_options: { id: "address_name", required: true, data: { geocode_lookup_target: "name" } }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "address_address_type")) do |field| %>
          <% field.with_label { t(".type_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "address[address_type]", options: address_type_options,
                  selected: address.address_type, html_options: { id: "address_address_type" }) %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "address_full_address")) do |field| %>
        <% field.with_label { t(".full_address_label") } %>
        <% field.with_control do %>
          <%= render(Ui::TextareaComponent.new(name: "address[full_address]", rows: 2,
                html_options: { id: "address_full_address", data: { geocode_lookup_target: "fullAddress" } })) { address.full_address } %>
        <% end %>
      <% end %>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div>
        <%= render(Ui::FieldComponent.new(id: "address_phone")) do |field| %>
          <% field.with_label { t(".phone_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "tel", name: "address[phone]", value: address.phone,
                  html_options: { id: "address_phone" }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "address_rating")) do |field| %>
          <% field.with_label { t(".rating_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "number", name: "address[rating]", value: address.rating,
                  html_options: { id: "address_rating", min: 1, max: 5 }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "address_latitude")) do |field| %>
          <% field.with_label { t(".latitude_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "number", name: "address[latitude]", value: address.latitude,
                  html_options: { id: "address_latitude", step: "any", data: { geocode_lookup_target: "latitude" } }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "address_longitude")) do |field| %>
          <% field.with_label { t(".longitude_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "number", name: "address[longitude]", value: address.longitude,
                  html_options: { id: "address_longitude", step: "any", data: { geocode_lookup_target: "longitude" } }) %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= render(Ui::FieldComponent.new(id: "address_photo")) do |field| %>
      <% field.with_label { t(".photo_label") } %>
      <% field.with_control do %>
        <% if address.photo.attached? %>
          <div class="mb-2 max-w-40">
            <%= render(Ui::AspectRatioComponent.new) do %>
              <%= image_tag address.photo.variant(resize_to_fill: [ 160, 90 ]), alt: "", class: "size-full object-cover" %>
            <% end %>
          </div>
        <% end %>
        <%= form.file_field :photo, accept: "image/*", id: "address_photo", class: "block text-sm text-secondary" %>
      <% end %>
    <% end %>

    <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".save") } %>
  </div>
<% end %>
