<% content_for :title, @circle.name %>
<%= turbo_stream_from @circle %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <header class="mb-4">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("users", css_class: "size-6") %> <%= @circle.name %></h1>
    <p class="text-sm text-secondary">
      <% if @circle.theme.present? %><%= @circle.theme %> · <% end %>
      <%= @circle.members.map { |m| m.name.presence || m.email_address }.join(", ") %>
    </p>
  </header>

  <%= render "shared/flash" %>

  <%= render(Ui::CardComponent.new(class_name: "mb-6")) do %>
    <p class="text-sm text-secondary"><%= t(".invite_code_label") %></p>
    <code class="rounded bg-surface-inset px-3 py-1 font-semibold tracking-widest"><%= @circle.invite_code %></code>
  <% end %>

  <%= tag.div id: "new_circle_post" do %>
    <%= form_with model: [ @circle, @post ], url: circle_posts_path(@circle), class: "mb-6 flex gap-2" do |form| %>
      <%= render Ui::TextareaComponent.new(name: "circle_post[body]", rows: 2, placeholder: t("circles.post_placeholder"),
            html_options: { id: "circle_post_body", required: true, class: "flex-1" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t("circles.publish") } %>
    <% end %>
  <% end %>

  <div id="circle_posts" class="space-y-3">
    <%= render @posts %>
  </div>

  <p class="mt-6 text-sm"><%= link_to t("circles.back_to_circles"), circles_path, class: "underline" %></p>
</div>
