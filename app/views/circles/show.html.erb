<% content_for :title, @circle.name %>
<%= turbo_stream_from @circle %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:circles, [ @circle.name, nil ], module_path: circles_path) %></div>

  <header class="mb-4 flex items-start justify-between">
    <div>
      <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("users", css_class: "size-6") %> <%= @circle.name %></h1>
      <div class="mt-1 flex -space-x-2">
        <% @circle.members.each do |member| %>
          <%= render(Ui::AvatarComponent.new(alt: member.name.presence || member.email_address, size: :sm)) %>
        <% end %>
      </div>
      <p class="mt-1 text-sm text-secondary">
        <% if @circle.theme.present? %><%= @circle.theme %> · <% end %>
        <%= @circle.members.map { |m| m.name.presence || m.email_address }.join(", ") %>
      </p>
    </div>
    <% if @my_membership&.role == "admin" %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: edit_circle_path(@circle))) { t(".settings") } %>
    <% end %>
  </header>

  <%= render "shared/flash" %>

  <%= render(Ui::CardComponent.new(class_name: "mb-6")) do %>
    <p class="text-sm text-secondary"><%= t(".invite_code_label") %></p>
    <div class="flex items-center gap-2">
      <code id="circle_invite_code" class="rounded bg-surface-inset px-3 py-1 font-semibold tracking-widest"><%= @circle.invite_code %></code>
      <%= render(Ui::CopyButtonComponent.new(value: @circle.invite_code, label: t("circles.copy_code"))) %>
    </div>
  <% end %>

  <%= render "circle_posts/form", circle: @circle, post: @post %>

  <%= turbo_frame_tag "circle_posts_page" do %>
    <% if @posts.any? %>
      <div id="circle_posts" class="space-y-3">
        <%= render @posts %>
      </div>
      <% if @has_more %>
        <div class="mt-3 text-center">
          <%= link_to t(".load_more"), circle_path(@circle, page: @page + 1), class: "text-sm text-secondary underline" %>
        </div>
      <% end %>
    <% else %>
      <div id="circle_posts">
        <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".empty_posts") } } %>
      </div>
    <% end %>
  <% end %>

  <% if @my_membership %>
    <div class="mt-6 flex justify-end">
      <%= render(Ui::ButtonToComponent.new(circle_member_path(@circle, @my_membership), method: :delete, variant: :outline, size: :sm,
            html_options: { class: "text-destructive", form: { data: { turbo_confirm: t(".leave_confirm") } } })) { t(".leave") } %>
    </div>
  <% end %>
</div>
