<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:circles) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("users", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: new_circle_membership_path)) { t(".join_circle") } %>
      <%= render(Ui::DialogComponent.new) do |dialog| %>
        <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :default, size: :sm)) { t(".new_circle") } } %>
        <% dialog.with_title { t(".new_circle") } %>
        <%= render "form", circle: @circle %>
      <% end %>
      <% if @circles.any? %>
        <%= render Ui::ViewToggleComponent.new(mode: @view_mode, path_for: ->(mode) { circles_path(view: mode) }) %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <% if @circles.any? %>
    <div class="mb-6 <%= Ui::ViewToggleComponent.container_classes(@view_mode) %>">
      <% @circles.each do |circle| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title { link_to circle.name, circle_path(circle), class: "hover:underline" } %>
          <% item.with_description do %>
            <% if circle.theme.present? %>· <%= circle.theme %> <% end %>· <%= t(".members", count: circle.members.size) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="mb-6">
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".empty") } } %>
    </div>
  <% end %>

</div>
