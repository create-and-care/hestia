<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:circles) %></div>

  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("users", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= link_to t(".join_circle"), new_circle_membership_path, class: "text-sm underline" %>
  </header>

  <%= render "shared/flash" %>

  <% if @circles.any? %>
    <div class="mb-6 divide-y divide-gray-100 rounded-lg border border-primary">
      <% @circles.each do |circle| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title { link_to circle.name, circle_path(circle), class: "hover:underline" } %>
          <% item.with_description do %>
            <% if circle.theme.present? %>· <%= circle.theme %> <% end %>· <%= t(".members", count: circle.members.size) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="mb-6">
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".empty") } } %>
    </div>
  <% end %>

  <%= render(Ui::CardComponent.new) do |card| %>
    <% card.with_title { t(".new_circle") } %>
    <%= form_with model: @circle, url: circles_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= render Ui::InputComponent.new(name: "circle[name]", placeholder: t(".name_placeholder"),
            html_options: { id: "circle_name", required: true, class: "flex-1" }) %>
      <%= render Ui::InputComponent.new(name: "circle[theme]", placeholder: t(".theme_placeholder"),
            html_options: { id: "circle_theme", class: "w-32" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".create") } %>
    <% end %>
  <% end %>

</div>
