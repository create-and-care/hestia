<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-2xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:circles) %></div>

  <header class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold">👥 <%= t(".title") %></h1>
    <%= link_to t(".join_circle"), new_circle_membership_path, class: "text-sm underline" %>
  </header>

  <%= render "shared/flash" %>

  <% if @circles.any? %>
    <ul class="mb-6 divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @circles.each do |circle| %>
        <li class="px-4 py-3">
          <%= link_to circle.name, circle_path(circle), class: "font-medium hover:underline" %>
          <% if circle.theme.present? %><span class="text-sm text-gray-400">· <%= circle.theme %></span><% end %>
          <span class="text-xs text-gray-400">· <%= t(".members", count: circle.members.size) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-6 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500"><%= t(".empty") %></p>
  <% end %>

  <section class="rounded-lg border border-gray-200 p-4">
    <h2 class="mb-2 font-medium"><%= t(".new_circle") %></h2>
    <%= form_with model: @circle, url: circles_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: t(".name_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.text_field :theme, placeholder: t(".theme_placeholder"), class: "w-32 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".create"), class: "cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>
  </section>

</div>
