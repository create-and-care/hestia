<% content_for :title, "Cercles" %>

<div class="mx-auto mt-10 max-w-2xl px-4">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold">👥 Cercles</h1>
    <%= link_to "Rejoindre un cercle", new_circle_membership_path, class: "text-sm underline" %>
  </header>

  <%= render "shared/flash" %>

  <% if @circles.any? %>
    <ul class="mb-6 divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @circles.each do |circle| %>
        <li class="px-4 py-3">
          <%= link_to circle.name, circle_path(circle), class: "font-medium hover:underline" %>
          <% if circle.theme.present? %><span class="text-sm text-gray-400">· <%= circle.theme %></span><% end %>
          <span class="text-xs text-gray-400">· <%= pluralize(circle.members.size, "membre") %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-6 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">Vous n'êtes membre d'aucun cercle.</p>
  <% end %>

  <section class="rounded-lg border border-gray-200 p-4">
    <h2 class="mb-2 font-medium">Créer un cercle</h2>
    <%= form_with model: @circle, url: circles_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: "Nom (famille élargie, amis…)", class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.text_field :theme, placeholder: "Thème", class: "w-32 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit "Créer", class: "cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>
  </section>

  <p class="mt-6 text-sm"><%= link_to "← Tableau de bord", root_path, class: "underline" %></p>
</div>
