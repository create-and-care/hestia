<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hestia" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hestia">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Applies the persisted theme (light/dark/system) before first paint to avoid a flash.
        Kept in sync afterwards by app/javascript/controllers/theme_controller.js. %>
    <script>
      (function () {
        var stored = localStorage.getItem("theme") || "system";
        var isDark = stored === "dark" || (stored === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-surface text-primary">
    <% if Current.user %>
      <div class="fixed top-3 right-3 z-40 flex items-center gap-1">
        <%= render "shared/notifications" %>
      </div>
    <% end %>

    <% if Current.household %>
      <div class="flex min-h-screen">
        <%= render "shared/app_sidebar" %>
        <div class="min-w-0 flex-1 bg-white"><%= yield %></div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>

    <%= render(Ui::SonnerComponent.new) %>
  </body>
</html>
