<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hestia" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hestia">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Applies the persisted theme (light/dark/system) before first paint to avoid a flash.
        Kept in sync afterwards by app/javascript/controllers/theme_controller.js.
        The nonce is what keeps this inline script running under the CSP — without
        it, script-src :self blocks it and the flash comes back. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        var stored = localStorage.getItem("theme") || "system";
        var isDark = stored === "dark" || (stored === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-surface text-primary">
    <%# Mounted first so the sonner Stimulus controller registers its
        "toast:show" listener before any flash partial further down the
        page connects and dispatches one — otherwise the event fires with
        no listener attached and the toast is silently dropped. %>
    <%= render(Ui::SonnerComponent.new) %>

    <% if Current.user %>
      <%# Below md this sits inside the mobile nav bar's 56px band (see
          shared/_app_sidebar); above md it floats exactly as before. Stays a
          single instance either way — it carries its own turbo_stream_from
          subscription and a fixed "notifications_badge" id, so duplicating it
          would double-subscribe and break Turbo Stream targeting. %>
      <div class="fixed right-3 top-0 z-40 flex h-14 items-center gap-1 md:top-3 md:h-auto">
        <%= render "shared/notifications" %>
      </div>
    <% end %>

    <% if Current.household %>
      <div class="flex min-h-screen">
        <%= render "shared/app_sidebar" %>
        <div class="min-w-0 flex-1 pb-16 pt-14 md:pt-0"><%= yield %></div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
