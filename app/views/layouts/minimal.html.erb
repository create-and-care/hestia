<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hestia" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Same anti-FOUC script as layouts/application, same CSP nonce requirement. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        var stored = localStorage.getItem("theme") || "system";
        var isDark = stored === "dark" || (stored === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-surface text-primary">
    <%# Mounted first so the sonner Stimulus controller registers its
        "toast:show" listener before any flash partial further down the
        page connects and dispatches one — otherwise the event fires with
        no listener attached and the toast is silently dropped. %>
    <%= render(Ui::SonnerComponent.new) %>

    <%# Stands in for the browser's confirm() on every data-turbo-confirm in the
        app — see the partial. Mounted beside the toast viewport for the same
        reason: it has to exist before anything can ask it to open. %>
    <%= render "shared/confirm_dialog" %>
    <%= yield %>
  </body>
</html>
