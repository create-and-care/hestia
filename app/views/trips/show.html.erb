<% content_for :title, @trip.name %>

<div class="mx-auto mt-10 max-w-2xl px-4">
  <header class="mb-6 flex items-start justify-between">
    <div>
      <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("luggage", css_class: "size-6") %> <%= @trip.name %></h1>
      <% if @trip.starts_on %><p class="text-sm text-gray-500"><%= @trip.starts_on.strftime("%d/%m/%Y") %><%= " → #{@trip.ends_on.strftime('%d/%m/%Y')}" if @trip.ends_on %></p><% end %>
    </div>
    <%= button_to t(".delete_trip"), trip_path(@trip), method: :delete,
          form: { data: { turbo_confirm: t(".delete_trip_confirm") } },
          class: "cursor-pointer text-sm text-red-600 underline" %>
  </header>

  <%= render "shared/flash" %>

  <section class="mb-6">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("shopping-cart", css_class: "size-5") %> <%= t(".shopping_lists") %></h2>
    <ul class="mb-2 text-sm">
      <% @trip.shopping_lists.order(:name).each do |list| %>
        <li class="flex items-center justify-between rounded border border-gray-200 px-3 py-1.5">
          <%= link_to shopping_list_path(list), class: "inline-flex items-center gap-1.5 hover:underline" do %><%= list.icon.presence || lucide_icon("shopping-cart", css_class: "size-4") %> <%= list.name %><% end %>
          <%= button_to trip_shopping_list_path(@trip, list), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
        </li>
      <% end %>
    </ul>
    <%= form_with model: @shopping_list, url: trip_shopping_lists_path(@trip), class: "flex gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: t(".shopping_list_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".add"), class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("notebook-pen", css_class: "size-5") %> <%= t(".notes") %></h2>
    <ul class="mb-2 text-sm">
      <% @trip.notes.order(created_at: :desc).each do |note| %>
        <li class="flex items-center justify-between rounded border border-gray-200 px-3 py-1.5">
          <span><span class="font-medium"><%= note.title %></span> <span class="text-gray-400"><%= truncate(note.content, length: 60) %></span></span>
          <%= button_to trip_note_path(@trip, note), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
        </li>
      <% end %>
    </ul>
    <%= form_with model: @note, url: trip_notes_path(@trip), class: "flex flex-wrap gap-2" do |form| %>
      <%= form.text_field :title, required: true, placeholder: t(".note_title_placeholder"), class: "w-32 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.text_field :content, placeholder: t(".note_content_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".add"), class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("square-check", css_class: "size-5") %> <%= t(".tasks") %></h2>
    <ul class="mb-2 text-sm">
      <% @trip.tasks.order(:due_on).each do |task| %>
        <li class="flex items-center justify-between rounded border border-gray-200 px-3 py-1.5">
          <span><%= "#{task.emoji} " if task.emoji.present? %><%= task.title %></span>
          <%= button_to trip_task_path(@trip, task), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
        </li>
      <% end %>
    </ul>
    <%= form_with model: @task, url: trip_tasks_path(@trip), class: "flex flex-wrap gap-2" do |form| %>
      <%= form.text_field :title, required: true, placeholder: t(".task_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.date_field :due_on, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".add"), class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("map-pin", css_class: "size-5") %> <%= t(".addresses") %></h2>
    <ul class="mb-2 text-sm">
      <% @trip.addresses.order(:name).each do |address| %>
        <li class="flex items-center justify-between rounded border border-gray-200 px-3 py-1.5">
          <span><span class="font-medium"><%= address.name %></span> <span class="text-gray-400"><%= address.full_address %></span></span>
          <%= button_to trip_address_path(@trip, address), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
        </li>
      <% end %>
    </ul>
    <%= form_with model: @address, url: trip_addresses_path(@trip), class: "flex flex-wrap gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: t(".address_name_placeholder"), class: "w-32 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.text_field :full_address, placeholder: t(".address_full_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".add"), class: "cursor-pointer rounded-md border border-gray-300 px-2 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </section>

  <p class="text-sm"><%= link_to t(".back_to_trips"), trips_path, class: "underline" %></p>
</div>
