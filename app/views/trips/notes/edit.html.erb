<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:trips, [ @trip.name, trip_path(@trip) ], [ t(".title"), nil ], module_path: trips_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <%= form_with model: @note, url: trip_note_path(@trip, @note), class: "flex flex-col gap-4" do |form| %>
    <%= render(Ui::FieldComponent.new(id: form.field_id(:title))) do |field| %>
      <% field.with_label { t(".title_label") } %>
      <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:title), value: form.object.title, html_options: { id: form.field_id(:title), required: true }) } %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: form.field_id(:content))) do |field| %>
      <% field.with_label { t(".content_label") } %>
      <% field.with_control { render Ui::TextareaComponent.new(name: form.field_name(:content), html_options: { id: form.field_id(:content) }) { form.object.content } } %>
    <% end %>

    <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
  <% end %>

</div>
