<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-2xl px-4">
  <h1 class="mb-6 text-2xl font-semibold">🧳 <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <% if @trips.any? %>
    <ul class="mb-6 divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @trips.each do |trip| %>
        <li class="flex items-center justify-between px-4 py-3">
          <%= link_to trip.name, trip_path(trip), class: "font-medium hover:underline" %>
          <% if trip.starts_on %><span class="text-sm text-gray-400"><%= trip.starts_on.strftime("%d/%m/%y") %><%= " → #{trip.ends_on.strftime("%d/%m/%y")}" if trip.ends_on %></span><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-6 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500"><%= t(".empty") %></p>
  <% end %>

  <section class="rounded-lg border border-gray-200 p-4">
    <h2 class="mb-2 font-medium"><%= t(".new_trip") %></h2>
    <%= form_with model: @trip, url: trips_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: t(".name_placeholder"), class: "flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.date_field :starts_on, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.date_field :ends_on, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".create"), class: "cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    <% end %>
    <p class="mt-2 text-xs text-gray-400"><%= t(".hint") %></p>
  </section>

  <p class="mt-6 text-sm"><%= link_to t("common.back_to_dashboard"), root_path, class: "underline" %></p>
</div>
