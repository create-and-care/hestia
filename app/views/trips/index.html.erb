<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:trips) %></div>

  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("luggage", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= render(Ui::DialogComponent.new) do |dialog| %>
      <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :default, size: :sm)) { t(".new_trip") } } %>
      <% dialog.with_title { t(".new_trip") } %>
      <%= render "form", trip: @trip %>
    <% end %>
  </header>

  <%= render "shared/flash" %>

  <% if @trips.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @trips.each do |trip| %>
        <%= link_to trip_path(trip), class: "block" do %>
          <%= render(Ui::CardComponent.new(class_name: "h-full transition-colors hover:bg-surface-hover")) do %>
            <p class="flex items-center gap-1.5 font-medium"><%= lucide_icon("luggage", css_class: "size-4 shrink-0") %> <%= trip.name %></p>
            <% if trip.starts_on %>
              <p class="mt-1 text-sm text-subdued"><%= l(trip.starts_on, format: :numeric_compact) %><%= " → #{l(trip.ends_on, format: :numeric_compact)}" if trip.ends_on %></p>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="mb-6">
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".empty") } %>
      <% end %>
    </div>
  <% end %>

</div>
