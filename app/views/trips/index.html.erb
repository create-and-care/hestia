<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:trips) %></div>

  <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("luggage", css_class: "size-6") %> <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <% if @trips.any? %>
    <%= render(Ui::CardComponent.new(class_name: "mb-6")) do %>
      <ul class="divide-y divide-gray-100">
        <% @trips.each do |trip| %>
          <li>
            <%= render(Ui::ItemComponent.new) do |item| %>
              <% item.with_title { link_to trip.name, trip_path(trip), class: "hover:underline" } %>
              <% if trip.starts_on %>
                <% item.with_trailing do %>
                  <span class="text-sm text-gray-400"><%= trip.starts_on.strftime("%d/%m/%y") %><%= " → #{trip.ends_on.strftime("%d/%m/%y")}" if trip.ends_on %></span>
                <% end %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <div class="mb-6">
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".empty") } %>
      <% end %>
    </div>
  <% end %>

  <%= render(Ui::CardComponent.new) do %>
    <h2 class="mb-2 font-medium"><%= t(".new_trip") %></h2>
    <%= form_with model: @trip, url: trips_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <div class="flex-1">
        <%= render(Ui::FieldComponent.new(id: form.field_id(:name))) do |field| %>
          <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:name), value: form.object.name, placeholder: t(".name_placeholder"), html_options: { id: form.field_id(:name), required: true }) } %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:starts_on))) do |field| %>
          <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:starts_on), value: form.object.starts_on, html_options: { id: form.field_id(:starts_on) }) } %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:ends_on))) do |field| %>
          <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:ends_on), value: form.object.ends_on, html_options: { id: form.field_id(:ends_on) }) } %>
        <% end %>
      </div>
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, type: "submit")) { t(".create") } %>
    <% end %>
    <p class="mt-2 text-xs text-gray-400"><%= t(".hint") %></p>
  <% end %>

</div>
