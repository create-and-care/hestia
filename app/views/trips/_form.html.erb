<%= form_with model: trip, url: trips_path, class: "flex flex-col gap-3" do |form| %>
  <%= render(Ui::FieldComponent.new(id: form.field_id(:name))) do |field| %>
    <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:name), value: form.object.name, placeholder: t("trips.index.name_placeholder"), html_options: { id: form.field_id(:name), required: true }) } %>
  <% end %>
  <div class="flex gap-2">
    <div class="flex-1">
      <%= render(Ui::FieldComponent.new(id: form.field_id(:starts_on))) do |field| %>
        <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:starts_on), value: form.object.starts_on, html_options: { id: form.field_id(:starts_on) }) } %>
      <% end %>
    </div>
    <div class="flex-1">
      <%= render(Ui::FieldComponent.new(id: form.field_id(:ends_on))) do |field| %>
        <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:ends_on), value: form.object.ends_on, html_options: { id: form.field_id(:ends_on) }) } %>
      <% end %>
    </div>
  </div>
  <p class="text-xs text-subdued"><%= t("trips.index.hint") %></p>
  <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t("trips.index.create") } %>
<% end %>
