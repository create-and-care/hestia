<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:trips, [ @trip.name, trip_path(@trip) ], [ t(".title"), nil ], module_path: trips_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <%= form_with model: @task, url: trip_task_path(@trip, @task), class: "flex flex-col gap-4" do |form| %>
    <%= render(Ui::FieldComponent.new(id: form.field_id(:title))) do |field| %>
      <% field.with_label { t(".title_label") } %>
      <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:title), value: form.object.title, html_options: { id: form.field_id(:title), required: true }) } %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: form.field_id(:emoji))) do |field| %>
      <% field.with_label { t(".emoji_label") } %>
      <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:emoji), value: form.object.emoji, html_options: { id: form.field_id(:emoji) }) } %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: form.field_id(:due_on))) do |field| %>
      <% field.with_label { t(".due_on_label") } %>
      <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:due_on), value: form.object.due_on, html_options: { id: form.field_id(:due_on) }) } %>
    <% end %>

    <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
  <% end %>

</div>
