<%= form_with model: template, url: url do |form| %>
  <% if template.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% template.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-end gap-2">
    <div class="flex-1">
      <%= render(Ui::FieldComponent.new(id: form.field_id(:name))) do |field| %>
        <% field.with_label { t("workout_templates.form.name_label") } %>
        <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:name), value: form.object.name, placeholder: t("workout_templates.form.name_placeholder"), html_options: { id: form.field_id(:name), required: true }) } %>
      <% end %>
    </div>
    <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, type: "submit")) { t("workout_templates.form.save") } %>
  </div>
<% end %>
