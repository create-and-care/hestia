<%= render(Ui::DialogComponent.new(full_width_trigger: true)) do |dialog| %>
  <% dialog.with_trigger do %>
    <%= render Ui::ButtonComponent.new(variant: :outline, html_options: { class: "w-full justify-start gap-2 text-secondary", data: { action: "keydown@window->dialog#open" } }) do %>
      <%= lucide_icon("search", css_class: "size-4 shrink-0") %>
      <span class="flex-1 truncate text-left"><%= t("search.button_label") %></span>
      <kbd class="hidden shrink-0 rounded border border-primary px-1.5 py-0.5 text-xs text-subdued sm:inline">⌘K</kbd>
    <% end %>
  <% end %>

  <div data-controller="search-palette" class="-m-6 -mt-4">
    <%= form_with url: search_path, method: :get, data: { turbo_frame: "global_search_results", action: "input->search-palette#submit keydown->search-palette#onKeydown" } do %>
      <div class="[&_input]:focus-visible:ring-0">
        <%= render Ui::InputComponent.new(type: "search", name: "q", placeholder: t("search.placeholder"),
              html_options: { autocomplete: "off", autofocus: true, data: { search_palette_target: "input" },
                              class: "border-0 border-b rounded-none" }) %>
      </div>
    <% end %>
    <div class="max-h-80 overflow-auto p-2">
      <%= turbo_frame_tag "global_search_results", data: { action: "turbo:frame-load->search-palette#onFrameLoad" } %>
    </div>
  </div>
<% end %>
