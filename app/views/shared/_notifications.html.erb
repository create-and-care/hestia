<%= turbo_stream_from Current.user, :notifications %>

<div class="overflow-hidden rounded-full border border-primary bg-surface-inset">
<%= render Ui::PopoverComponent.new(placement: "bottom-end") do |popover| %>
  <% popover.with_trigger do %>
    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, html_options: { class: "relative", aria: { label: t(".title") } })) do %>
      <%= lucide_icon("bell", css_class: "size-5") %>
      <%= render "notifications/badge", count: Current.user.notifications.unread.count %>
    <% end %>
  <% end %>

  <div class="flex items-center justify-between border-primary pb-2">
    <h2 class="text-sm font-medium"><%= t(".title") %></h2>
    <%= button_to t(".mark_all_read"), mark_all_read_notifications_path, method: :patch,
          class: "cursor-pointer text-xs text-secondary transition-colors hover:text-primary" %>
  </div>
  <div id="notifications_list" class="max-h-80 divide-y divide-primary overflow-y-auto">
    <% notifications = recent_notifications(10) %>
    <% if notifications.none? %>
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".none") } %>
      <% end %>
    <% end %>
    <% notifications.each do |notification| %>
      <%= render "notifications/notification", notification: notification %>
    <% end %>
  </div>
  <%# Explicit color: the popover paints bg-container but carries no .on-tone, so
      a bare <a> fell through to `--link` from @layer base — the one raw blue,
      underlined link left in the app chrome. %>
  <%= link_to t(".see_all"), notifications_path,
        class: "mt-2 block text-center text-xs text-secondary no-underline transition-colors hover:text-primary hover:no-underline" %>
<% end %>
  </div>