<%# Persistent desktop sidebar (>= md, collapsible to a 64px rail) below which
    the same nav content relocates into a Ui::DrawerComponent — see the mobile
    top bar right below. Both mounts render "shared/sidebar_nav" etc, so the
    nav markup itself exists exactly once; only the wrapper differs. %>
<%= render(Ui::SidebarComponent.new(class_name: "sticky top-0 h-screen shrink-0 max-md:hidden")) do |sidebar| %>
  <% sidebar.with_header { render "shared/sidebar_brand" } %>
  <% sidebar.with_toolbar do %>
    <div class="flex items-center gap-2">
      <div class="flex-1"><%= render "shared/search_dialog" %></div>
      <% if Current.household.module_enabled?("notes") %><%= render "shared/quick_capture_dialog" %><% end %>
    </div>
  <% end %>

  <%= render "shared/sidebar_nav" %>

  <% sidebar.with_footer { render "shared/sidebar_user_card" } %>
<% end %>

<div class="fixed inset-x-0 top-0 z-sticky flex h-14 items-center justify-between border-b border-primary bg-surface px-2 md:hidden">
  <%= render(Ui::DrawerComponent.new(side: :left, close_on_visit: true)) do |drawer| %>
    <% drawer.with_trigger do %>
      <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: { aria: { label: t("sidebar.open_nav") } })) do %>
        <%= lucide_icon("menu", css_class: "size-5") %>
      <% end %>
    <% end %>

    <%# The drawer's own dialog is bg-container, so the cards would be white on
        white — this wrapper restores the tinted ground they are drawn against.
        -m-6 cancels the dialog's own p-6 gutter and the height adds it back, so
        the ground reaches all four edges instead of floating as an inset panel;
        p-3 then matches the desktop aside's padding. %>
    <div data-controller="sidebar" class="-m-6 flex h-[calc(100%+3rem)] flex-col gap-3 bg-surface p-3">
      <%= render "shared/sidebar_brand" %>
      <div class="flex items-center gap-2">
        <div class="flex-1"><%= render "shared/search_dialog", frame_id: "global_search_results_mobile", keyboard_shortcut: false %></div>
        <% if Current.household.module_enabled?("notes") %><%= render "shared/quick_capture_dialog", panel_id: "quick_capture_panel_mobile" %><% end %>
      </div>
      <nav class="flex-1 min-h-0 overflow-y-auto">
        <%= render "shared/sidebar_nav", preload: false %>
      </nav>
      <div class="shrink-0"><%= render "shared/sidebar_user_card" %></div>
    </div>
  <% end %>

  <p class="pointer-events-none text-sm font-semibold text-primary"><%= Hestia %></p>
  <div class="w-9" aria-hidden="true"></div>
</div>
