<%= render(Ui::SidebarComponent.new(class_name: "sticky top-0 h-screen shrink-0")) do |sidebar| %>
  <% sidebar.with_header do %>
    <div class="flex min-w-0 items-center gap-2 group-data-[collapsed=true]:hidden">
      <%= image_tag "logo.png", alt: Hestia.to_s, class: "size-7 shrink-0 rounded-md object-cover" %>
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-primary"><%= Hestia %></p>
      </div>
    </div>
  <% end %>

  <div class="group-data-[collapsed=true]:hidden">
    <%= render "shared/search_dialog" %>
  </div>

  <%= render(Ui::SidebarItemComponent.new(icon: "layout-dashboard", label: t("sidebar.home"), href: root_path, active: current_page?(root_path))) %>

  <% sidebar_groups.each do |group| %>
    <div class="flex flex-col gap-0.5" data-sidebar-target="group">
      <button type="button" data-action="click->sidebar#toggleGroup" aria-expanded="<%= group[:open] %>"
        class="flex w-full items-center gap-3 rounded-md p-2 text-sm font-medium text-secondary hover:bg-surface-hover">
        <span class="shrink-0" aria-hidden="true"><%= lucide_icon(group[:icon], css_class: "size-5") %></span>
        <span class="flex-1 truncate text-left group-data-[collapsed=true]:hidden"><%= group[:label] %></span>
        <svg data-sidebar-target="groupChevron" class="size-4 shrink-0 transition-transform group-data-[collapsed=true]:hidden <%= "rotate-180" if group[:open] %>" viewBox="0 0 24 24" fill="none">
          <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div data-sidebar-target="groupPanel" class="ml-2 flex flex-col gap-0.5 border-l border-primary pl-3 group-data-[collapsed=true]:ml-0 group-data-[collapsed=true]:border-l-0 group-data-[collapsed=true]:pl-0" <%= "hidden" unless group[:open] %>>
        <% group[:items].each do |item| %>
          <%= render(Ui::SidebarItemComponent.new(icon: item[:icon], label: item[:label], href: item[:path], active: item[:active])) do |sidebar_item| %>
            <% if item[:unread] %>
              <% sidebar_item.with_trailing do %>
                <span class="block size-1.5 rounded-full bg-button-primary" aria-hidden="true"></span>
                <span class="sr-only"><%= t("sidebar.unread") %></span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% sidebar.with_footer do %>
    <div class="flex flex-col gap-0.5 border-t border-primary pt-3">
      <%= render(Ui::SidebarItemComponent.new(icon: "settings", label: t("sidebar.footer.settings"), href: household_path(Current.household))) %>

      <div class="mt-2 flex items-center gap-2 rounded-md border border-primary p-2 group-data-[collapsed=true]:hidden">
        <%= render Ui::AvatarComponent.new(alt: Current.user.name.presence || Current.user.email_address, size: :sm) %>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium text-primary"><%= Current.user.name.presence || Current.user.email_address %></p>
          <p class="truncate text-xs text-secondary"><%= Current.user.email_address %></p>
        </div>
        <%= button_to session_path, method: :delete, class: "shrink-0 cursor-pointer rounded-md p-1.5 text-secondary hover:bg-surface-hover", title: t("sidebar.footer.sign_out") do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="sr-only"><%= t("sidebar.footer.sign_out") %></span>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
