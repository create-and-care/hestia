<%= render(Ui::SidebarComponent.new(class_name: "sticky top-0 h-screen shrink-0")) do |sidebar| %>
  <% sidebar.with_header do %>
    <div data-sidebar-target="label" class="flex min-w-0 items-center gap-2">
      <%= render Ui::AvatarComponent.new(alt: Current.household.name, size: :sm) %>
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-primary"><%= Current.household.name %></p>
        <p class="truncate text-xs text-secondary"><%= Current.user.email_address %></p>
      </div>
    </div>
  <% end %>

  <div data-sidebar-target="label">
    <input type="search" autocomplete="off" data-sidebar-target="searchInput" data-action="input->sidebar#filter"
      placeholder="<%= t("sidebar.search_placeholder") %>"
      class="w-full rounded-md border border-primary bg-container px-3 py-1.5 text-sm text-primary placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary">
  </div>

  <%= link_to root_path, class: "flex items-center gap-3 rounded-md p-2 text-sm #{current_page?(root_path) ? "bg-surface-hover font-medium text-primary" : "text-primary hover:bg-surface-hover"}", data: { sidebar_target: "item" } do %>
    <span class="relative shrink-0 text-lg leading-none" aria-hidden="true">
      🏠
      <% if current_page?(root_path) %><span class="absolute -right-0.5 -top-0.5 size-1.5 rounded-full bg-button-primary"></span><% end %>
    </span>
    <span data-sidebar-target="label" class="truncate"><%= t("sidebar.home") %></span>
  <% end %>

  <% sidebar_groups.each do |group| %>
    <div class="flex flex-col gap-0.5" data-sidebar-target="group">
      <button type="button" data-action="click->sidebar#toggleGroup" aria-expanded="<%= group[:open] %>"
        class="flex w-full items-center gap-3 rounded-md p-2 text-sm font-medium text-secondary hover:bg-surface-hover">
        <span class="shrink-0 text-lg leading-none" aria-hidden="true"><%= group[:emoji] %></span>
        <span data-sidebar-target="label" class="flex-1 truncate text-left"><%= group[:label] %></span>
        <svg data-sidebar-target="label groupChevron" class="size-4 shrink-0 transition-transform <%= "rotate-180" if group[:open] %>" viewBox="0 0 24 24" fill="none">
          <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div data-sidebar-target="label groupPanel" class="ml-2 flex flex-col gap-0.5 border-l border-primary pl-3" <%= "hidden" unless group[:open] %>>
        <% group[:items].each do |item| %>
          <%= link_to item[:path], class: "flex items-center gap-3 rounded-md p-2 text-sm #{item[:active] ? "bg-surface-hover font-medium text-primary" : "text-primary hover:bg-surface-hover"}", data: { sidebar_target: "item" } do %>
            <span class="relative shrink-0 text-base leading-none" aria-hidden="true">
              <%= item[:emoji] %>
              <% if item[:active] %><span class="absolute -right-0.5 -top-0.5 size-1.5 rounded-full bg-button-primary"></span><% end %>
            </span>
            <span class="truncate"><%= item[:label] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <p data-sidebar-target="empty" hidden class="px-2 py-1.5 text-xs text-secondary"><%= t("sidebar.no_results") %></p>

  <% sidebar.with_footer do %>
    <div class="flex flex-col gap-0.5 border-t border-primary pt-3">
      <%= link_to household_path(Current.household), class: "flex items-center gap-3 rounded-md p-2 text-sm text-primary hover:bg-surface-hover" do %>
        <span class="shrink-0 text-lg leading-none" aria-hidden="true">⚙️</span>
        <span data-sidebar-target="label" class="truncate"><%= t("sidebar.footer.settings") %></span>
      <% end %>

      <div data-sidebar-target="label" class="mt-2 flex items-center gap-2 rounded-md border border-primary p-2">
        <%= render Ui::AvatarComponent.new(alt: Current.user.name.presence || Current.user.email_address, size: :sm) %>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium text-primary"><%= Current.user.name.presence || Current.user.email_address %></p>
          <p class="truncate text-xs text-secondary"><%= Current.user.email_address %></p>
        </div>
        <%= button_to session_path, method: :delete, class: "shrink-0 cursor-pointer rounded-md p-1.5 text-secondary hover:bg-surface-hover", title: t("sidebar.footer.sign_out") do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="sr-only"><%= t("sidebar.footer.sign_out") %></span>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
