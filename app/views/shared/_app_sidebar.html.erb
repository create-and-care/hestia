<%# Persistent desktop sidebar (>= md, collapsible to a 64px rail) below which
    the same nav content relocates into a Ui::DrawerComponent — see the mobile
    top bar right below. Both mounts render "shared/sidebar_nav" etc, so the
    nav markup itself exists exactly once; only the wrapper differs. %>
<%= render(Ui::SidebarComponent.new(class_name: "sticky top-0 h-screen shrink-0 max-md:hidden")) do |sidebar| %>
  <% sidebar.with_header { render "shared/sidebar_brand" } %>

  <%= render "shared/sidebar_nav" %>

  <% sidebar.with_footer { render "shared/sidebar_user_card" } %>
<% end %>

<div class="fixed inset-x-0 top-0 z-30 flex h-14 items-center justify-between border-b border-primary bg-surface px-2 md:hidden">
  <%= render(Ui::DrawerComponent.new(side: :left, close_on_visit: true)) do |drawer| %>
    <% drawer.with_trigger do %>
      <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm, html_options: { aria: { label: t("sidebar.open_nav") } })) do %>
        <%= lucide_icon("menu", css_class: "size-5") %>
      <% end %>
    <% end %>

    <div data-controller="sidebar" class="flex h-full flex-col gap-4 p-4">
      <%= render "shared/sidebar_brand" %>
      <nav class="flex-1 min-h-0 flex flex-col gap-1 overflow-y-auto">
        <%= render "shared/sidebar_nav", frame_id: "global_search_results_mobile", keyboard_shortcut: false %>
      </nav>
      <%= render "shared/sidebar_user_card" %>
    </div>
  <% end %>

  <p class="pointer-events-none text-sm font-semibold text-primary"><%= Hestia %></p>
  <div class="w-9" aria-hidden="true"></div>
</div>
