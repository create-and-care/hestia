<div class="flex items-center rounded-full border border-gray-200 bg-white text-xs" aria-label="<%= t("common.language") %>">
  <% I18n.available_locales.each do |locale| %>
    <%= button_to locale.to_s.upcase, locale_path(locale: locale), method: :patch,
          class: "cursor-pointer rounded-full px-2 py-1 #{"font-semibold text-gray-900" if Current.user.locale == locale.to_s} #{"text-gray-400 hover:text-gray-700" unless Current.user.locale == locale.to_s}" %>
  <% end %>
</div>
