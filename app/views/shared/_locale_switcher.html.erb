<div class="flex items-center rounded-full bg-white text-xs" aria-label="<%= t("common.language") %>">
  <%= form_with url: locale_path, method: :patch, data: { controller: "form", action: "select:select->form#submit" } do %>
    <%= render Ui::SelectComponent.new(
      name: "locale",
      options: I18n.available_locales.map { |locale| [locale.to_s.upcase, locale.to_s] },
      selected: Current.user.locale
    ) %>
  <% end %>
</div>
