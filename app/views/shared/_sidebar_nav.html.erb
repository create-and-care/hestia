<%
  # Shared by the persistent desktop aside and the mobile nav drawer — see
  # shared/_app_sidebar — so this renders exactly once per breakpoint rather
  # than being hand-copied.
  #
  # Both mounts of this partial are in the DOM at once below `md`, and Turbo's
  # preloader only skips a URL it has *already* cached — two copies of the same
  # link fire two concurrent requests before either lands. So the eager preload
  # belongs to the desktop mount only; the drawer opts out.
  preload = local_assigns.fetch(:preload, true)
%>
<%# The dashboard is the hub every module page comes back to, and the only
    destination reachable from every other page, so it is the one row where a
    single background fetch buys an instant visit from anywhere in the app. %>
<div class="<%= sidebar_card_class("flex flex-col gap-0.5") %>">
  <%= render(Ui::SidebarItemComponent.new(variant: :plain, icon: "layout-dashboard", label: t("sidebar.home"), href: root_path, active: current_page?(root_path), preload: preload)) %>
  <%= render(Ui::SidebarItemComponent.new(variant: :plain, icon: "sunrise", label: t("sidebar.today"), href: today_path, active: current_page?(today_path))) %>

  <% sidebar_groups.each do |group| %>
    <div class="flex flex-col gap-0.5" data-sidebar-target="group">
      <button type="button" data-action="click->sidebar#toggleGroup" aria-expanded="<%= group[:open] %>"
        class="flex h-10 w-full cursor-pointer items-center gap-3 rounded-md px-3 text-sm font-medium text-primary transition-colors hover:bg-surface-hover group-data-[collapsed=true]:justify-center <%= "bg-item-active" if group[:open] %>">
        <span class="shrink-0 text-secondary" aria-hidden="true"><%= lucide_icon(group[:icon], css_class: "size-4") %></span>
        <span class="min-w-0 flex-1 truncate text-left group-data-[collapsed=true]:hidden"><%= group[:label] %></span>
        <span data-sidebar-target="groupChevron" class="shrink-0 text-secondary transition-transform group-data-[collapsed=true]:hidden <%= "rotate-90" if group[:open] %>" aria-hidden="true"><%= lucide_icon("chevron-right", css_class: "size-4") %></span>
      </button>

      <%# Hidden outright in the 64px rail rather than shrunk into it: :sub rows
          carry no glyph, so a rail copy of this panel would be a column of
          blank rows. The group's own icon above stays as the rail affordance. %>
      <div data-sidebar-target="groupPanel" class="ml-4 flex flex-col gap-0.5 border-l border-primary pl-2 group-data-[collapsed=true]:hidden" <%= "hidden" unless group[:open] %>>
        <% group[:items].each do |item| %>
          <%= render(Ui::SidebarItemComponent.new(variant: :sub, label: item[:label], href: item[:path], active: item[:active])) do |sidebar_item| %>
            <% if item[:unread] %>
              <% sidebar_item.with_trailing do %>
                <span class="block size-1.5 rounded-full bg-button-primary" aria-hidden="true"></span>
                <span class="sr-only"><%= t("sidebar.unread") %></span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
