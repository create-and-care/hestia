<%# The design system's answer to `data: { turbo_confirm: "…" }`.
    Turbo's default confirm is the browser's own confirm(), which ignores the
    theme, ignores the brand, and cannot be styled — and 59 call sites across
    the app reach it. Rather than rewrite all 59 into Ui::AlertDialogComponent,
    one dialog is mounted per page and confirm_controller hands it to
    Turbo.config.forms.confirm, so every existing and future turbo_confirm gets
    the design-system dialog for free.

    Deliberately mirrors AlertDialogComponent's markup — same <dialog>, same
    center POSITION_CLASSES, same footer, role="alertdialog" — because it is
    the same thing, only driven from JS instead of from a trigger slot. %>
<div data-controller="confirm">
  <%# id, so page-level tests counting their own alert dialogs can exclude the
      one the layout mounts on every page. %>
  <dialog id="global_confirm_dialog" data-confirm-target="dialog" role="alertdialog" data-state="closed"
    data-action="click->confirm#onBackdrop cancel->confirm#onCancel close->confirm#onClose"
    <%# max-w-md spelled out rather than taken from the component: a confirmation
        is a sentence and a pair of buttons, and should stay that width whatever
        the default dialog width becomes. %>
    class="<%= Ui::DialogComponent::POSITION_CLASSES.fetch(:center) %> max-w-md
           p-0 bg-container shadow-border-lg duration-200
           data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95
           data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95">
    <div class="flex flex-col gap-4 p-6">
      <div class="pr-8">
        <h2 class="text-base font-semibold text-primary" data-confirm-target="title"><%= t("ui.confirm_dialog.title") %></h2>
        <p class="mt-1 text-sm text-secondary" data-confirm-target="message"></p>
      </div>
      <div class="flex items-center justify-end gap-2">
        <button type="button" data-action="click->confirm#cancel"
          class="inline-flex h-9 items-center rounded-md px-4 text-sm font-medium text-primary bg-button-secondary hover:bg-button-secondary-hover">
          <%= t("ui.alert_dialog.cancel_label") %>
        </button>
        <button type="button" data-action="click->confirm#accept" data-confirm-target="accept"
          class="<%= "inline-flex h-9 items-center rounded-md px-4 text-sm font-medium #{Ui::ButtonComponent::VARIANTS.fetch(:destructive)}" %>">
          <%= t("ui.alert_dialog.confirm_label") %>
        </button>
      </div>
    </div>
  </dialog>
</div>
