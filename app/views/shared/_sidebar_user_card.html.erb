<%# Identity block plus the gear that opens the account menu (shared/_sidebar_user_menu).
    The menu is a popover, not a fourth stacked card: it holds ten rows that
    would otherwise take more vertical room than the nav itself.
    The panel is position:fixed, which is what lets it escape the aside's
    overflow-hidden (there for the collapse width transition). %>
<%# The rail stacks the avatar over the gear instead of hiding the gear: the menu
    is the only route to settings and sign-out now, so dropping it at 64px would
    strand anyone who works with the sidebar collapsed. %>
<div class="<%= sidebar_card_class("flex flex-row items-center gap-2 group-data-[collapsed=true]:flex-col") %>">
  <%= render Ui::AvatarComponent.new(alt: Current.user.name.presence || Current.user.email_address, size: :sm, tint: Current.user.avatar_tint) %>
  <div class="min-w-0 flex-1 group-data-[collapsed=true]:hidden">
    <p class="truncate text-sm font-medium text-primary"><%= Current.user.name.presence || Current.user.email_address %></p>
    <p class="truncate text-xs text-secondary"><%= Current.user.email_address %></p>
  </div>

  <div class="shrink-0">
    <%# top-end: the card is pinned to the bottom of the viewport, so the menu
        opens upward and hangs off the gear's right edge. %>
    <%= render(Ui::PopoverComponent.new(placement: "top-end", variant: :menu)) do |popover| %>
      <% popover.with_trigger do %>
        <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :sm,
              html_options: { class: "px-2", aria: { label: t("sidebar.footer.menu") } })) do %>
          <%= lucide_icon("settings", css_class: "size-4 text-secondary") %>
        <% end %>
      <% end %>

      <%= render "shared/sidebar_user_menu" %>
    <% end %>
  </div>
</div>
