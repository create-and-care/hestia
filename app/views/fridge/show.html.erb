<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:fridge) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("refrigerator", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex flex-wrap items-center gap-2">
      <%# Alongside the search rather than in a band of its own below it: what
          you can cook right now is a property of the fridge's contents, so it
          belongs with the control that narrows them, not stranded above the
          first section with 40px of air under it. %>
      <% if @recipe_suggestions.present? %>
        <%= render(Ui::DialogComponent.new) do |dialog| %>
          <% dialog.with_trigger do %>
            <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) do %>
              <%= render Ui::MarkerComponent.new(variant: :accent, pulse: true,
                    label: t(".suggestions_marker", count: @recipe_suggestions.size)) %>
            <% end %>
          <% end %>
          <% dialog.with_title { t(".suggestions_heading") } %>
          <ul class="space-y-1 text-sm">
            <% @recipe_suggestions.each do |recipe| %>
              <li><%= link_to recipe.title, recipe_path(recipe), class: "underline" %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
      <%= form_with url: fridge_path, method: :get do |form| %>
        <%= render(Ui::LabelComponent.new(for_id: "fridge_q", html_options: { class: "sr-only" })) { t(".search_label") } %>
        <%# form.search_field rather than InputComponent so form_with keeps naming
            the param — but it takes the component's classes instead of a copy that
            had drifted to its own py-1.5 height. %>
        <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"), id: "fridge_q",
              class: Ui::InputComponent.classes(size: :sm) %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <section class="mb-10">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-medium"><%= t(".foods_heading") %></h2>
      <%# size: :lg — the form has six controls on one row and every one of them
          was wrapping onto a line of its own at max-w-md. %>
      <%= render(Ui::DialogComponent.new(size: :lg)) do |dialog| %>
        <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { t(".add_food") } } %>
        <% dialog.with_title { t(".add_food") } %>
        <%= render "fridge_items/form", fridge_item: @fridge_item %>
      <% end %>
    </div>

    <div class="mt-4">
      <%= render(Ui::TabsComponent.new(default: "all")) do |tabs| %>
        <% tabs.with_tab(label: t(".all_locations"), value: "all") do %>
          <div id="fridge_items" class="mt-3 space-y-2">
            <% if @fridge_items.any? %>
              <%= render @fridge_items %>
            <% else %>
              <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { @query.present? ? t(".no_items_for_search") : t(".no_items") } } %>
            <% end %>
          </div>
        <% end %>
        <% FridgeItem::LOCATIONS.each do |location| %>
          <% items_for_location = @fridge_items.select { |item| item.location == location } %>
          <% tabs.with_tab(label: location_label(location), value: location) do %>
            <div class="mt-3 space-y-2">
              <% if items_for_location.any? %>
                <%= render items_for_location %>
              <% else %>
                <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_items") } } %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="mb-8">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-medium"><%= t(".dishes_heading") %></h2>
      <%= render(Ui::DialogComponent.new) do |dialog| %>
        <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { t(".add_dish") } } %>
        <% dialog.with_title { t(".add_dish") } %>
        <%= render "prepared_dishes/form", prepared_dish: @prepared_dish %>
      <% end %>
    </div>

    <div id="prepared_dishes" class="mt-4 space-y-2">
      <% if @prepared_dishes.any? %>
        <%= render @prepared_dishes %>
      <% else %>
        <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".no_dishes") } } %>
      <% end %>
    </div>
  </section>

</div>
