<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:service_providers) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("wrench", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= form_with url: service_providers_path, method: :get do |form| %>
        <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"),
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_service_provider_path)) { t(".new_provider") } %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <section class="mb-6 flex flex-wrap items-center gap-2">
    <%= link_to service_providers_path do %>
      <%= render(Ui::BadgeComponent.new(variant: @type ? :secondary : :default)) { t(".all_types") } %>
    <% end %>
    <% @types.each do |type| %>
      <%= render(Ui::BadgeComponent.new(variant: :secondary)) do %>
        <%= link_to "#{type.icon} #{type.name}".strip, service_providers_path(type_id: type.id) %>
        <%= button_to "×", service_provider_type_path(type), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600", form: { class: "inline" } %>
      <% end %>
    <% end %>
    <%= form_with url: service_provider_types_path, method: :post, class: "inline-flex gap-1" do %>
      <%= render Ui::InputComponent.new(type: "text", name: "service_provider_type[icon]", placeholder: "🔧",
            html_options: { id: "service_provider_type_icon", maxlength: 4, class: "w-12" }) %>
      <%= render Ui::InputComponent.new(type: "text", name: "service_provider_type[name]", placeholder: t(".type_name_placeholder"),
            html_options: { id: "service_provider_type_name" }) %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add_type") } %>
    <% end %>
  </section>

  <div id="service_providers" class="space-y-2">
    <%= render @providers %>
  </div>
  <% if @providers.empty? %>
    <div class="mt-4">
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".none") } %>
      <% end %>
    </div>
  <% end %>

</div>
