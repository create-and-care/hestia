<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:service_providers) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("wrench", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= form_with url: service_providers_path, method: :get, data: { controller: "debounced-search" } do |form| %>
        <label for="service_providers_q" class="sr-only"><%= t(".search_placeholder") %></label>
        <%= render Ui::InputComponent.new(type: "search", name: "q", value: @query, placeholder: t(".search_placeholder"),
              html_options: { id: "service_providers_q", data: { action: "input->debounced-search#submit" } }) %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_service_provider_path)) { t(".new_provider") } %>
      <%= render Ui::ViewToggleComponent.new(mode: @view_mode, path_for: ->(mode) { service_providers_path(q: @query.presence, type_id: @type&.id, view: mode) }) %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <section class="mb-6 flex flex-wrap items-center gap-2">
    <%= link_to service_providers_path do %>
      <%= render(Ui::BadgeComponent.new(variant: @type ? :secondary : :default)) { t(".all_types") } %>
    <% end %>
    <% @types.each do |type| %>
      <%= render(Ui::BadgeComponent.new(variant: @type == type ? :default : :secondary)) do %>
        <% if type.color.present? %><span class="inline-block size-2 rounded-full <%= service_provider_type_dot_class(type.color) %>"></span><% end %>
        <%= link_to "#{type.icon} #{type.name}".strip, service_providers_path(type_id: type.id) %>
        <%= link_to edit_service_provider_type_path(type), aria: { label: t(".edit_type_aria", name: type.name) }, class: "text-subdued hover:text-primary" do %><%= lucide_icon("pencil", css_class: "size-3") %><% end %>
        <%= render(Ui::AlertDialogComponent.new(title: t(".delete_type_confirm", name: type.name), confirm_label: t(".delete_type_confirm_label"),
              confirm_url: service_provider_type_path(type), confirm_method: :delete)) do |alert_dialog| %>
          <% alert_dialog.with_trigger do %>
            <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon,
                  html_options: { aria: { label: t(".delete_type_aria", name: type.name) } })) { lucide_icon("x", css_class: "size-4") } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= form_with url: service_provider_types_path, method: :post, class: "inline-flex flex-wrap items-end gap-1",
          data: { controller: "maintenance-entry-type", action: "submit->maintenance-entry-type#beforeSubmit" } do %>
      <div>
        <label for="service_provider_type_icon" class="sr-only"><%= t(".type_icon_label") %></label>
        <%= render Ui::InputComponent.new(type: "text", name: "service_provider_type[icon]", placeholder: "🔧",
              html_options: { id: "service_provider_type_icon", maxlength: 4, class: "w-12" }) %>
      </div>
      <div>
        <label for="service_provider_type_name" class="sr-only"><%= t(".type_name_placeholder") %></label>
        <%= render Ui::NativeSelectComponent.new(name: "service_provider_type[name]", options: service_provider_type_predefined_options,
              html_options: { id: "service_provider_type_name", data: { maintenance_entry_type_target: "select", action: "change->maintenance-entry-type#sync" } }) %>
      </div>
      <%= render Ui::InputComponent.new(type: "text", name: "service_provider_type[name]", placeholder: t(".type_name_custom_placeholder"),
            html_options: { id: "service_provider_type_name_custom", class: "hidden w-32", data: { maintenance_entry_type_target: "custom" } }) %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add_type") } %>
    <% end %>
  </section>

  <div id="service_providers" class="<%= Ui::ViewToggleComponent.container_classes(@view_mode) %>">
    <%= render @providers %>
  </div>
  <% if @providers.empty? %>
    <div class="mt-4">
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".none") } %>
      <% end %>
    </div>
  <% end %>

</div>
