<%= form_with model: service_provider, url: url,
      data: { controller: "contact-picker" } do |form| %>
  <% if service_provider.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% service_provider.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "button",
          html_options: { data: { "contact-picker-target": "button", action: "click->contact-picker#pick" } })) do %>
      <%= lucide_icon("smartphone", css_class: "size-4") %> <%= t(".import_from_contacts") %>
    <% end %>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= render(Ui::FieldComponent.new(id: "service_provider_name")) do |field| %>
          <% field.with_label { t(".name_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "text", name: "service_provider[name]", value: service_provider.name,
                  html_options: { id: "service_provider_name", required: true, data: { "contact-picker-target": "name" } }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "service_provider_service_provider_type_id")) do |field| %>
          <% field.with_label { t(".type_label") } %>
          <% field.with_control do %>
            <%= render Ui::NativeSelectComponent.new(name: "service_provider[service_provider_type_id]",
                  options: [ [ "—", "" ] ] + Current.household.service_provider_types.order(:name).map { |type| [ type.name, type.id ] },
                  selected: service_provider.service_provider_type_id,
                  html_options: { id: "service_provider_service_provider_type_id" }) %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= render(Ui::FieldComponent.new(id: "service_provider_phone")) do |field| %>
          <% field.with_label { t(".phone_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "tel", name: "service_provider[phone]", value: service_provider.phone,
                  html_options: { id: "service_provider_phone", data: { "contact-picker-target": "phone" } }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "service_provider_email")) do |field| %>
          <% field.with_label { t(".email_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "email", name: "service_provider[email]", value: service_provider.email,
                  html_options: { id: "service_provider_email", data: { "contact-picker-target": "email" } }) %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "service_provider_linked_address_id")) do |field| %>
        <% field.with_label { t(".linked_address_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "service_provider[linked_address_id]",
                options: [ [ t(".none_option"), "" ] ] + @addresses.map { |address| [ address.name, address.id ] },
                selected: service_provider.linked_address_id, html_options: { id: "service_provider_linked_address_id" }) %>
        <% end %>
        <% field.with_description { t(".linked_address_hint") } %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "service_provider_address")) do |field| %>
        <% field.with_label { t(".address_label") } %>
        <% field.with_control do %>
          <%= render(Ui::TextareaComponent.new(name: "service_provider[address]", rows: 2,
                html_options: { id: "service_provider_address" })) { service_provider.address } %>
        <% end %>
      <% end %>
    </div>
    <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".save") } %>
  </div>
<% end %>
