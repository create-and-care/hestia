<%= tag.div id: dom_id(service_provider), class: "flex flex-wrap items-center gap-3 rounded-lg border border-gray-200 px-3 py-2" do %>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <span class="font-medium"><%= service_provider.name %></span>
      <% if service_provider.service_provider_type %>
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">
          <%= "#{service_provider.service_provider_type.icon} #{service_provider.service_provider_type.name}".strip %>
        </span>
      <% end %>
    </div>
    <% if service_provider.address.present? %>
      <p class="text-sm text-gray-500"><%= service_provider.address %></p>
    <% end %>
  </div>

  <div class="flex shrink-0 items-center gap-2 text-sm">
    <% if service_provider.phone.present? %>
      <%= link_to "📞", "tel:#{service_provider.phone}", class: "hover:opacity-70", title: service_provider.phone %>
    <% end %>
    <% if service_provider.email.present? %>
      <%= link_to "✉️", "mailto:#{service_provider.email}", class: "hover:opacity-70", title: service_provider.email %>
    <% end %>
    <% if service_provider.maps_url %>
      <%= link_to "🗺", service_provider.maps_url, target: "_blank", rel: "noopener", class: "hover:opacity-70", title: t(".directions") %>
    <% end %>
    <%= link_to "✎", edit_service_provider_path(service_provider), class: "text-gray-400 hover:text-gray-900" %>
    <%= button_to "✕", service_provider_path(service_provider), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" %>
  </div>
<% end %>
