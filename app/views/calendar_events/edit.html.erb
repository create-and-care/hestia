<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold"><%= t(".heading") %></h1>
    <% if @event.recurring? && @occurrence %>
      <div class="flex items-center gap-2">
        <%= form_with url: calendar_event_path(@event), method: :delete,
              data: { turbo_confirm: t(".delete_confirm") } do %>
          <input type="hidden" name="occurrence" value="<%= @occurrence.iso8601 %>">
          <input type="hidden" name="scope" value="occurrence">
          <%= render(Ui::ButtonComponent.new(type: "submit", variant: :outline, size: :sm)) { t(".delete_occurrence") } %>
        <% end %>
        <%= form_with url: calendar_event_path(@event), method: :delete,
              data: { turbo_confirm: t(".delete_series_confirm") } do %>
          <input type="hidden" name="scope" value="series">
          <%= render(Ui::ButtonComponent.new(type: "submit", variant: :destructive, size: :sm)) { t(".delete_series") } %>
        <% end %>
      </div>
    <% else %>
      <%= form_with url: calendar_event_path(@event), method: :delete,
            data: { turbo_confirm: t(".delete_confirm") } do %>
        <%= render(Ui::ButtonComponent.new(type: "submit", variant: :destructive, size: :sm)) { t(".delete") } %>
      <% end %>
    <% end %>
  </div>
  <%= render "form", event: @event, url: calendar_event_path(@event), occurrence: @occurrence %>

  <section class="mt-8 border-t border-primary pt-6">
    <h2 class="mb-2 flex items-center gap-1.5 font-medium"><%= lucide_icon("bell", css_class: "size-5") %> <%= t(".reminders_heading") %></h2>
    <div class="mb-3 divide-y divide-primary rounded-lg border border-primary">
      <% @event.event_reminders.each do |reminder| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title do %>
            <%= EventReminder::MINUTES_BEFORE_OPTIONS.find { |_, v| v == reminder.minutes_before }&.first || t(".minutes_before_fallback", minutes: reminder.minutes_before) %>
            <span class="text-subdued">· <%= reminder.user.name.presence || reminder.user.email_address %></span>
          <% end %>
          <% item.with_trailing do %>
            <%= button_to calendar_event_event_reminder_path(@event, reminder), method: :delete,
                  class: "cursor-pointer text-subdued hover:text-destructive", aria: { label: t(".delete_reminder_aria") } do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%= form_with model: EventReminder.new, url: calendar_event_event_reminders_path(@event), class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= render(Ui::FieldComponent.new(id: "event_reminder_minutes_before")) do |field| %>
        <% field.with_label { t(".delay_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "event_reminder[minutes_before]", options: EventReminder::MINUTES_BEFORE_OPTIONS,
                html_options: { id: "event_reminder_minutes_before" }) %>
        <% end %>
      <% end %>
      <%= render(Ui::FieldComponent.new(id: "event_reminder_user_id")) do |field| %>
        <% field.with_label { t(".recipient_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "event_reminder[user_id]", options: calendar_participant_options,
                html_options: { id: "event_reminder_user_id" }) %>
        <% end %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add_reminder_submit") } %>
    <% end %>
  </section>

  <p class="mt-6 text-sm"><%= link_to t(".back_link"), calendar_path, class: "underline" %></p>
</div>
