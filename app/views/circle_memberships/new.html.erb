<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <%= form_with url: circle_membership_path, method: :post do %>
    <div class="flex gap-2">
      <%= render Ui::InputComponent.new(name: "invite_code", placeholder: t(".invite_code_placeholder"),
            html_options: { id: "invite_code", required: true, autofocus: true, class: "flex-1 uppercase tracking-widest" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".join") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t("circles.back_to_circles"), circles_path, class: "underline" %></p>
</div>
