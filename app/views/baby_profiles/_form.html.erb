<%= form_with model: baby, url: url do |form| %>
  <% if baby.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% baby.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= render(Ui::FieldComponent.new(id: "baby_profile_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "text", name: "baby_profile[name]", value: baby.name,
                html_options: { id: "baby_profile_name", required: true }) %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "baby_profile_born_on")) do |field| %>
        <% field.with_label { t(".born_on_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "baby_profile[born_on]", value: baby.born_on,
                html_options: { id: "baby_profile_born_on" }) %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= render(Ui::FieldComponent.new(id: "baby_profile_service_provider_id")) do |field| %>
        <% field.with_label { t(".service_provider_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "baby_profile[service_provider_id]",
                options: [ [ t(".no_service_provider"), "" ] ] + @service_providers.map { |provider| [ provider.name, provider.id ] },
                selected: baby.service_provider_id, html_options: { id: "baby_profile_service_provider_id" }) %>
        <% end %>
      <% end %>
    </div>
    <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".submit") } %>
  </div>
<% end %>
