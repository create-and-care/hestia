<div id="<%= dom_id(baby_profile) %>">
  <%= render(Ui::CardComponent.new) do %>
    <%= link_to baby_profile_path(baby_profile), class: "flex items-center gap-3" do %>
      <%= lucide_icon("baby", css_class: "size-6 shrink-0 text-subdued") %>
      <div class="min-w-0 flex-1">
        <p class="font-medium text-primary truncate"><%= baby_profile.name %></p>
        <% if baby_profile.born_on %>
          <p class="text-xs text-secondary truncate">
            <%= t("baby_profiles.born_on", date: l(baby_profile.born_on, format: :numeric)) %>
            · <%= t("baby_profiles.age_months", count: baby_profile.age_in_months) %>
          </p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
