<div id="<%= dom_id(baby_profile) %>">
  <%= render(Ui::ItemComponent.new(href: baby_profile_path(baby_profile))) do |item| %>
    <% item.with_leading { lucide_icon("baby", css_class: "size-4") } %>
    <% item.with_title { baby_profile.name } %>
    <% if baby_profile.born_on %>
      <% item.with_description do %>
        <%= t("baby_profiles.born_on", date: baby_profile.born_on.strftime("%d/%m/%Y")) %>
        <span class="text-subdued">· <%= t("baby_profiles.age_months", count: baby_profile.age_in_months) %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
