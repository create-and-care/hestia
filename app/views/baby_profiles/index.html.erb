<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:baby) %></div>

  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("baby", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_baby_profile_path)) { t(".new_profile") } %>
  </header>

  <%= render "shared/flash" %>

  <div id="baby_profiles" class="grid gap-3 sm:grid-cols-2">
    <%= render @babies %>
  </div>
  <% if @babies.empty? %>
    <div class="mt-4">
      <%= render(Ui::CardComponent.new) do |empty| %>
        <% empty.with_description { t(".empty") } %>
      <% end %>
    </div>
  <% end %>

</div>
