<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "menu" %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:menu) %></div>

  <header class="mb-4 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("utensils", css_class: "size-6") %> <%= t(".heading") %></h1>
    <div class="flex items-center gap-2 text-sm">
      <%= link_to t(".previous_week"), menu_path(week: @week_start - 1.week), class: "underline" %>
      <%= link_to t(".this_week"), menu_path, class: "underline" %>
      <%= link_to t(".next_week"), menu_path(week: @week_start + 1.week), class: "underline" %>
    </div>
  </header>
  <p class="mb-4 text-sm text-gray-500"><%= t(".week_range", start: @week_start.strftime("%d/%m"), end: (@week_start + 6.days).strftime("%d/%m/%Y")) %></p>

  <%= render "shared/flash" %>

  <div class="space-y-3">
    <% @days.each do |day| %>
      <%= render(Ui::CardComponent.new) do %>
        <h2 class="mb-2 text-sm font-semibold"><%= day_name(day) %> <span class="text-gray-400"><%= day.strftime("%d/%m") %></span></h2>
        <ul class="divide-y divide-gray-100">
          <% Array(@entries[day]).each do |entry| %>
            <li>
              <%= render(Ui::ItemComponent.new) do |item| %>
                <% item.with_title do %>
                  <span class="text-gray-400"><%= meal_type_label(entry.meal_type) %> :</span> <%= entry.display_name %>
                <% end %>
                <% item.with_trailing do %>
                  <%= form_with url: meal_plan_entry_path(entry), method: :delete do %>
                    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit")) { lucide_icon("x", css_class: "size-4") } %>
                  <% end %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if (missing = missing_meal_types(day)).any? %>
          <p class="mt-2 flex items-center gap-1 text-xs text-amber-600"><%= lucide_icon("triangle-alert", css_class: "size-3.5") %> <%= t(".missing_meals", meals: missing.map { |type| meal_type_label(type) }.join(", ")) %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= render(Ui::CardComponent.new(class_name: "mt-6")) do %>
    <h2 class="mb-2 font-medium"><%= t(".add_meal") %></h2>
    <%= form_with model: @entry, url: meal_plan_entries_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <div>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:on_date))) do |field| %>
          <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:on_date), value: form.object.on_date, html_options: { id: form.field_id(:on_date) }) } %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:meal_type))) do |field| %>
          <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:meal_type), options: meal_type_options, selected: form.object.meal_type, html_options: { id: form.field_id(:meal_type) }) } %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:recipe_id))) do |field| %>
          <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:recipe_id), options: [ [ t(".recipe_blank"), "" ] ] + recipe_options, selected: form.object.recipe_id, html_options: { id: form.field_id(:recipe_id) }) } %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: form.field_id(:free_name))) do |field| %>
          <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:free_name), value: form.object.free_name, placeholder: t(".free_name_placeholder"), html_options: { id: form.field_id(:free_name) }) } %>
        <% end %>
      </div>
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, type: "submit")) { t(".add") } %>
    <% end %>
  <% end %>

</div>
