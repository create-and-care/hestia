<% filter_params = { q: query.presence, archived: (archived ? 1 : nil) } %>
<%= tag.div id: dom_id(note) do %>
  <%= render(Ui::CardComponent.new(class_name: note_card_color_class(note.color))) do %>
    <div class="flex flex-col">
      <div class="mb-1 flex items-start justify-between gap-2">
        <h2 class="flex items-center gap-1.5 font-medium">
          <% if note.favorite %>
            <span class="sr-only"><%= t(".favorite_indicator") %></span>
            <%= lucide_icon("star", css_class: "size-4 fill-current text-primary") %>
          <% end %>
          <%= note.title %>
        </h2>
        <%= link_to edit_note_path(note), class: "shrink-0 text-subdued hover:text-primary",
              aria: { label: t(".edit_aria", title: note.title) } do %><%= lucide_icon("pencil", css_class: "size-4") %><% end %>
      </div>
      <% if note.content.present? %>
        <div class="mb-3 line-clamp-4 space-y-1 text-sm text-secondary"><%= format_note_content(note.content) %></div>
      <% end %>
      <% if note.recipe || note.document %>
        <div class="mb-3 flex flex-wrap gap-3 text-xs">
          <% if note.recipe %>
            <%= link_to recipe_path(note.recipe), class: "inline-flex items-center gap-1 text-link hover:underline" do %><%= lucide_icon("book-open", css_class: "size-3.5") %> <%= note.recipe.title %><% end %>
          <% end %>
          <% if note.document %>
            <%= link_to document_path(note.document), class: "inline-flex items-center gap-1 text-link hover:underline" do %><%= lucide_icon("paperclip", css_class: "size-3.5") %> <%= note.document.name %><% end %>
          <% end %>
        </div>
      <% end %>
      <div class="mt-auto flex flex-wrap gap-2">
        <%= render(Ui::ButtonToComponent.new(toggle_favorite_note_path(note, **filter_params), method: :patch)) {
              note.favorite ? t(".unfavorite") : t(".favorite") } %>
        <%= render(Ui::ButtonToComponent.new(toggle_archive_note_path(note, **filter_params), method: :patch)) {
              note.archived ? t(".unarchive") : t(".archive") } %>
        <%= render(Ui::AlertDialogComponent.new(title: t(".promote_confirm"), confirm_label: t(".promote_confirm_label"),
              confirm_url: promote_to_task_note_path(note, **filter_params), confirm_method: :post, confirm_variant: :default)) do |alert_dialog| %>
          <% alert_dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { t(".promote_to_task") } } %>
        <% end %>
        <%= render(Ui::AlertDialogComponent.new(title: t(".delete_confirm"), confirm_label: t(".delete"),
              confirm_url: note_path(note, **filter_params), confirm_method: :delete)) do |alert_dialog| %>
          <% alert_dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { t(".delete") } } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
