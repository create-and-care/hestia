<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:notes) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("notebook-pen", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= form_with url: notes_path, method: :get, data: { controller: "debounced-search" } do |form| %>
        <%= form.hidden_field :archived, value: ("1" if @archived) %>
        <%= render Ui::InputComponent.new(type: "search", name: "q", value: @query, placeholder: t(".search_placeholder"),
              html_options: { id: "notes_q", data: { action: "input->debounced-search#submit" } }) %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: notes_path(archived: (@archived ? nil : 1)))) {
            (@archived ? t(".active_filter") : t(".archived_filter")) } %>
      <%= render Ui::ViewToggleComponent.new(mode: @view_mode, path_for: ->(mode) { notes_path(q: @query.presence, archived: (@archived ? 1 : nil), view: mode) }) %>
      <% unless @archived %>
        <%= render(Ui::DialogComponent.new(close_on_submit: true)) do |dialog| %>
          <% dialog.with_trigger { render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) { t(".new_note") } } %>
          <% dialog.with_title { t(".new_note") } %>
          <%= render "form", note: @note %>
        <% end %>
      <% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <div id="notes" class="mt-4 <%= Ui::ViewToggleComponent.container_classes(@view_mode) %>">
    <%= render partial: "note", collection: @notes, locals: { query: @query, archived: @archived } %>
  </div>
  <% if @notes.empty? %>
    <%= render(Ui::EmptyComponent.new) do |empty| %>
      <% empty.with_description do %>
        <%= t(".none") %><%= t(".none_archived_suffix") if @archived %><%= t(".none_search_suffix") if @query.present? %>.
      <% end %>
    <% end %>
  <% end %>

  <% if @total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= render Ui::PaginationComponent.new(current: @page, total: @total_pages,
            path: ->(page) { notes_path(q: @query, archived: (@archived ? 1 : nil), page: page) }) %>
    </div>
  <% end %>

</div>
