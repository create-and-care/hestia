<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:notes) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("notebook-pen", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= form_with url: notes_path, method: :get do |form| %>
        <%= form.hidden_field :archived, value: ("1" if @archived) %>
        <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"),
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <% end %>
      <%= link_to (@archived ? t(".active_filter") : t(".archived_filter")), notes_path(archived: (@archived ? nil : 1)),
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <% unless @archived %>
    <%= render "form", note: @note %>
  <% end %>

  <div id="notes" class="mt-4 grid gap-3 sm:grid-cols-2">
    <%= render @notes %>
  </div>
  <% if @notes.empty? %>
    <p class="mt-4 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">
      <%= t(".none") %><%= t(".none_archived_suffix") if @archived %><%= t(".none_search_suffix") if @query.present? %>.
    </p>
  <% end %>

</div>
