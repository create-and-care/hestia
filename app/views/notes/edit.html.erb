<% content_for :title, "Modifier la note" %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <h1 class="mb-6 text-2xl font-semibold">Modifier la note</h1>

  <%= form_with model: @note, url: note_path(@note) do |form| %>
    <% if @note.errors.any? %>
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-inside list-disc">
          <% @note.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      </div>
    <% end %>
    <div class="space-y-4">
      <div>
        <%= form.label :title, "Titre", class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :title, required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :content, "Contenu", class: "mb-1 block text-sm font-medium" %>
        <%= form.text_area :content, rows: 8, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>
      <%= form.submit "Enregistrer", class: "cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to "← Notes", notes_path, class: "underline" %></p>
</div>
