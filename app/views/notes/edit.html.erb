<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:notes, [ t(".title"), nil ], module_path: notes_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @note, url: note_path(@note) do |form| %>
    <% if @note.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @note.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>
    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "note_title")) do |field| %>
        <% field.with_label { t(".title_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "note[title]", value: @note.title, invalid: @note.errors[:title].any?,
                html_options: { id: "note_title", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "note_content")) do |field| %>
        <% field.with_label { t(".content_label") } %>
        <% field.with_control do %>
          <%= render(Ui::TextareaComponent.new(name: "note[content]", rows: 8, invalid: @note.errors[:content].any?,
                html_options: { id: "note_content" })) { @note.content } %>
        <% end %>
        <% field.with_description { t(".content_hint") } %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "note_color")) do |field| %>
        <% field.with_label { t(".color_label") } %>
        <% field.with_control { render "notes/color_picker", note: @note } %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "note_recipe_id")) do |field| %>
        <% field.with_label { t(".recipe_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "note[recipe_id]",
                options: [ [ t(".none_option"), "" ] ] + @recipes.map { |recipe| [ recipe.title, recipe.id ] },
                selected: @note.recipe_id, html_options: { id: "note_recipe_id" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "note_document_id")) do |field| %>
        <% field.with_label { t(".document_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "note[document_id]",
                options: [ [ t(".none_option"), "" ] ] + @documents.map { |document| [ document.name, document.id ] },
                selected: @note.document_id, html_options: { id: "note_document_id" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    </div>
  <% end %>
</div>
