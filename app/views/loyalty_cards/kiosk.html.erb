<% content_for :title, @card.name %>

<%# Deliberately outside the theme system: this is the "hold the screen up to
    the scanner" view, so it forces a maximum-brightness light slate whatever
    the user's theme. bg-white/text-black are therefore correct here and must
    not be tokenised — the code below has to read as dark-on-light to scan. %>
<div class="relative flex min-h-screen flex-col items-center justify-center gap-6 bg-white p-6 text-center text-black"
     data-controller="escape-exit" data-action="keydown.esc@window->escape-exit#exit">
  <%# ...and because the ground is theme-independent, the foreground has to be
      too. This carried text-subdued/hover:text-primary, which follow the theme:
      in dark mode hover:text-primary resolves to #FBF7F4 — a white icon on a
      white background, i.e. the close button vanished exactly when clicked. %>
  <%= link_to loyalty_card_path(@card), class: "absolute top-4 right-4 rounded-md p-2 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-900",
        data: { escape_exit_target: "link" }, aria: { label: t(".close_aria") } do %><%= lucide_icon("x", css_class: "size-6") %><% end %>

  <h1 class="flex items-center gap-2 text-xl font-semibold">
    <% if @card.loyalty_brand&.logo_emoji.present? %><span aria-hidden="true"><%= @card.loyalty_brand.logo_emoji %></span><% end %>
    <%= @card.name %>
  </h1>

  <% if (svg = Loyalty::CodeRenderer.call(@card)) %>
    <div class="w-full max-w-sm"><%= svg %></div>
  <% end %>

  <p class="break-all font-mono text-3xl font-semibold tracking-widest"><%= @card.number %></p>
</div>
