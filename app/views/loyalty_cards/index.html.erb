<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold">💳 <%= t(".heading") %></h1>
    <%= link_to t(".new_card"), new_loyalty_card_path,
          class: "rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
  </header>

  <%= render "shared/flash" %>

  <div id="loyalty_cards" class="grid gap-3 sm:grid-cols-2"
       data-controller="sortable" data-sortable-url-value="<%= reorder_loyalty_cards_path %>">
    <%= render @cards %>
  </div>
  <% if @cards.empty? %>
    <p class="mt-4 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500"><%= t(".none") %></p>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t("common.back_to_dashboard"), root_path, class: "underline" %></p>
</div>
