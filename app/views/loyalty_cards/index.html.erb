<% content_for :title, "Fidélité" %>
<%= turbo_stream_from Current.household %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold">💳 Cartes de fidélité</h1>
    <%= link_to "Nouvelle carte", new_loyalty_card_path,
          class: "rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
  </header>

  <%= render "shared/flash" %>

  <div id="loyalty_cards" class="grid gap-3 sm:grid-cols-2">
    <%= render @cards %>
  </div>
  <% if @cards.empty? %>
    <p class="mt-4 rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">Aucune carte.</p>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to "← Tableau de bord", root_path, class: "underline" %></p>
</div>
