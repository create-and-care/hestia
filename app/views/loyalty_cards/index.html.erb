<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:loyalty) %></div>

  <header class="mb-6 flex items-center justify-between">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("credit-card", css_class: "size-6") %> <%= t(".heading") %></h1>
    <div class="flex items-center gap-2">
      <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, href: new_loyalty_card_path)) { t(".new_card") } %>
      <%= render Ui::ViewToggleComponent.new(mode: @view_mode, path_for: ->(mode) { loyalty_cards_path(view: mode) }) %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <div id="loyalty_cards" class="<%= Ui::ViewToggleComponent.container_classes(@view_mode) %>"
       data-controller="sortable" data-sortable-url-value="<%= reorder_loyalty_cards_path %>"
       data-sortable-error-message-value="<%= t(".reorder_error") %>">
    <%= render @cards %>
  </div>
  <% if @cards.empty? %>
    <div class="mt-4">
      <%= render(Ui::EmptyComponent.new) { |empty| empty.with_description { t(".none") } } %>
    </div>
  <% end %>

</div>
