<% content_for :title, @card.name %>

<div class="mx-auto mt-10 max-w-md px-4 text-center">
  <h1 class="mb-6 text-2xl font-semibold"><%= @card.name %></h1>

  <div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
    <p class="mb-4 text-xs uppercase tracking-wide text-gray-400">
      <%= @card.code_format == "qrcode" ? "QR code" : "Code-barres" %> à présenter en caisse
    </p>
    <p class="break-all font-mono text-3xl font-bold tracking-widest"><%= @card.number %></p>
  </div>

  <div class="mt-6 flex justify-center gap-3 text-sm">
    <%= link_to "Modifier", edit_loyalty_card_path(@card), class: "underline" %>
    <%= link_to "← Toutes les cartes", loyalty_cards_path, class: "underline" %>
  </div>
</div>
