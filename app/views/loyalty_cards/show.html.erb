<% content_for :title, @card.name %>

<div class="mx-auto mt-10 max-w-md px-4 text-center">
  <div class="mb-4 text-left"><%= module_breadcrumb(:loyalty, [ @card.name, nil ], module_path: loyalty_cards_path) %></div>

  <h1 class="mb-6 flex items-center justify-center gap-2 text-2xl font-semibold">
    <% if @card.loyalty_brand&.logo_emoji.present? %><span aria-hidden="true"><%= @card.loyalty_brand.logo_emoji %></span><% end %>
    <%= @card.name %>
  </h1>

  <%= render(Ui::CardComponent.new) do %>
    <p class="mb-4 text-xs uppercase tracking-wide text-subdued">
      <%= @card.code_format == "qrcode" ? t(".qrcode_label") : t(".barcode_label") %> <%= t(".present_at_checkout") %>
    </p>
    <% if (svg = Loyalty::CodeRenderer.call(@card)) %>
      <div class="mx-auto max-w-64 bg-white p-3"><%= svg %></div>
    <% end %>
    <p class="mt-3 break-all font-mono text-lg font-bold tracking-widest"><%= @card.number %></p>
    <% if @card.address %>
      <p class="mt-3 text-sm text-secondary">
        <%= link_to @card.address.name, @card.address.maps_url, target: "_blank", rel: "noopener", class: "hover:underline" %>
      </p>
    <% end %>
  <% end %>

  <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
    <%= render(Ui::ButtonComponent.new(variant: :default, href: kiosk_loyalty_card_path(@card))) { t(".kiosk_link") } %>
    <%= render(Ui::ButtonComponent.new(variant: :outline, href: edit_loyalty_card_path(@card))) { t(".edit") } %>
  </div>
</div>
