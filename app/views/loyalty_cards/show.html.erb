<% content_for :title, @card.name %>

<div class="mx-auto mt-10 max-w-md px-4 text-center">
  <h1 class="mb-6 text-2xl font-semibold"><%= @card.name %></h1>

  <div class="rounded-xl border border-primary bg-container p-8 shadow-sm">
    <p class="mb-4 text-xs uppercase tracking-wide text-subdued">
      <%= @card.code_format == "qrcode" ? t(".qrcode_label") : t(".barcode_label") %> <%= t(".present_at_checkout") %>
    </p>
    <p class="break-all font-mono text-3xl font-bold tracking-widest"><%= @card.number %></p>
  </div>

  <div class="mt-6 flex justify-center gap-3 text-sm">
    <%= link_to t(".edit"), edit_loyalty_card_path(@card), class: "underline" %>
    <%= link_to t(".back_to_all"), loyalty_cards_path, class: "underline" %>
  </div>
</div>
