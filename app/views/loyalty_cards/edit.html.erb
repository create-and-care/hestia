<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>
  <%= render "form", card: @card, url: loyalty_card_path(@card) %>
  <p class="mt-6 text-sm"><%= link_to t("loyalty_cards.back_to_loyalty"), loyalty_cards_path, class: "underline" %></p>
</div>
