<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-md px-4">
  <div class="mb-4"><%= module_breadcrumb(:loyalty, [ @card.name, loyalty_card_path(@card) ], [ t(".title"), nil ], module_path: loyalty_cards_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>
  <%= render "form", card: @card, url: loyalty_card_path(@card) %>
</div>
