<%= form_with model: pet, url: url do |form| %>
  <% if pet.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% pet.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= render(Ui::FieldComponent.new(id: "pet_name")) do |field| %>
          <% field.with_label { t(".name_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "text", name: "pet[name]", value: pet.name,
                  html_options: { id: "pet_name", required: true }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "pet_species")) do |field| %>
          <% field.with_label { t(".species_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "text", name: "pet[species]", value: pet.species, placeholder: t(".species_placeholder"),
                  html_options: { id: "pet_species" }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "pet_breed")) do |field| %>
          <% field.with_label { t(".breed_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "text", name: "pet[breed]", value: pet.breed,
                  html_options: { id: "pet_breed" }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "pet_weight")) do |field| %>
          <% field.with_label { t(".weight_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "number", name: "pet[weight]", value: pet.weight,
                  html_options: { id: "pet_weight", step: "any" }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "pet_identifier")) do |field| %>
          <% field.with_label { t(".identifier_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "text", name: "pet[identifier]", value: pet.identifier,
                  html_options: { id: "pet_identifier" }) %>
          <% end %>
        <% end %>
      </div>
      <div>
        <%= render(Ui::FieldComponent.new(id: "pet_born_on")) do |field| %>
          <% field.with_label { t(".born_on_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "date", name: "pet[born_on]", value: pet.born_on,
                  html_options: { id: "pet_born_on" }) %>
          <% end %>
        <% end %>
      </div>
    </div>
    <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".submit") } %>
  </div>
<% end %>
