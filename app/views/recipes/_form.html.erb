<%= form_with model: recipe, url: url do |form| %>
  <% if recipe.errors.any? %>
    <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
      <ul class="list-inside list-disc">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <%= render(Ui::FieldComponent.new(id: "recipe_title")) do |field| %>
      <% field.with_label { t(".title_label") } %>
      <% field.with_control do %>
        <%= render Ui::InputComponent.new(name: "recipe[title]", value: recipe.title, invalid: recipe.errors[:title].any?,
              html_options: { id: "recipe_title", required: true }) %>
      <% end %>
    <% end %>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <%= render(Ui::FieldComponent.new(id: "recipe_category")) do |field| %>
        <% field.with_label { t(".category_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "recipe[category]", value: recipe.category, html_options: { id: "recipe_category" }) %>
        <% end %>
      <% end %>
      <%= render(Ui::FieldComponent.new(id: "recipe_prep_time_minutes")) do |field| %>
        <% field.with_label { t(".prep_time_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "recipe[prep_time_minutes]", value: recipe.prep_time_minutes,
                html_options: { id: "recipe_prep_time_minutes", min: 0 }) %>
        <% end %>
      <% end %>
      <%= render(Ui::FieldComponent.new(id: "recipe_cook_time_minutes")) do |field| %>
        <% field.with_label { t(".cook_time_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "recipe[cook_time_minutes]", value: recipe.cook_time_minutes,
                html_options: { id: "recipe_cook_time_minutes", min: 0 }) %>
        <% end %>
      <% end %>
      <%= render(Ui::FieldComponent.new(id: "recipe_servings")) do |field| %>
        <% field.with_label { t(".servings_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "recipe[servings]", value: recipe.servings,
                html_options: { id: "recipe_servings", min: 1 }) %>
        <% end %>
      <% end %>
    </div>

    <%= render(Ui::FieldComponent.new(id: "recipe_tags_text")) do |field| %>
      <% field.with_label { t(".tags_label") } %>
      <% field.with_control do %>
        <%= render Ui::InputComponent.new(name: "recipe[tags_text]", value: recipe.tags_text, placeholder: t(".tags_placeholder"),
              html_options: { id: "recipe_tags_text" }) %>
      <% end %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: "recipe_ingredients_text")) do |field| %>
      <% field.with_label { t(".ingredients_label") } %>
      <% field.with_control do %>
        <%= render(Ui::TextareaComponent.new(name: "recipe[ingredients_text]", rows: 6,
              html_options: { id: "recipe_ingredients_text" })) { recipe.ingredients_text } %>
      <% end %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: "recipe_steps_text")) do |field| %>
      <% field.with_label { t(".steps_label") } %>
      <% field.with_control do %>
        <%= render(Ui::TextareaComponent.new(name: "recipe[steps_text]", rows: 6,
              html_options: { id: "recipe_steps_text" })) { recipe.steps_text } %>
      <% end %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: "recipe_source_url")) do |field| %>
      <% field.with_label { t(".source_label") } %>
      <% field.with_control do %>
        <%= render Ui::InputComponent.new(type: "url", name: "recipe[source_url]", value: recipe.source_url, html_options: { id: "recipe_source_url" }) %>
      <% end %>
    <% end %>

    <%= render(Ui::FieldComponent.new(id: "recipe_photo")) do |field| %>
      <% field.with_label { t(".photo_label") } %>
      <% field.with_control do %>
        <% if recipe.photo.attached? %>
          <div class="mb-2 max-w-40">
            <%= render(Ui::AspectRatioComponent.new) do %>
              <%= image_tag recipe.photo.variant(resize_to_fill: [ 160, 90 ]), alt: "", class: "size-full object-cover" %>
            <% end %>
          </div>
        <% end %>
        <%= form.file_field :photo, accept: "image/*", id: "recipe_photo", class: "block text-sm text-secondary" %>
      <% end %>
    <% end %>

    <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
  </div>
<% end %>
