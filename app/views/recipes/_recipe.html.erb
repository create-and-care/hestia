<% list_mode = local_assigns[:view_mode] == "list" %>
<%= link_to recipe_path(recipe), id: dom_id(recipe),
      class: list_mode ? "flex items-center justify-between gap-3 px-4 py-3 hover:bg-gray-50" : "block rounded-lg border border-gray-200 p-4 hover:border-gray-400" do %>
  <h2 class="font-medium"><%= recipe.title %></h2>
  <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-500 <%= "mt-0 shrink-0" if list_mode %>">
    <% if recipe.category.present? %>
      <span class="rounded-full bg-gray-100 px-2 py-0.5"><%= recipe.category %></span>
    <% end %>
    <% if recipe.total_time_minutes %>
      <span class="inline-flex items-center gap-1"><%= lucide_icon("clock", css_class: "size-3.5") %> <%= t(".total_time", minutes: recipe.total_time_minutes) %></span>
    <% end %>
    <% if recipe.servings %>
      <span class="inline-flex items-center gap-1"><%= lucide_icon("utensils", css_class: "size-3.5") %> <%= recipe.servings %></span>
    <% end %>
  </div>
<% end %>
