<% list_mode = local_assigns[:view_mode] == "list" %>
<%# on-tone: the card is a clickable surface, not an inline link in prose. Without
    the marker the global `a { color: var(--link) }` painted the whole card — title
    and every currentColor glyph — in link blue, and `a:hover` underlined all of it.
    The row signals hover with its own background, the way ItemComponent does. %>
<%= link_to recipe_path(recipe), id: dom_id(recipe),
      class: "on-tone transition-colors #{list_mode ? "flex items-center gap-3 px-4 py-3 hover:bg-surface-hover" : "block rounded-lg border border-primary p-4 hover:border-secondary hover:bg-surface-hover"}" do %>
  <% if !list_mode && recipe.photo.attached? %>
    <%= render(Ui::AspectRatioComponent.new) do %>
      <%= image_tag recipe.photo.variant(resize_to_fill: [ 400, 225 ]), alt: "", loading: :lazy, class: "size-full object-cover" %>
    <% end %>
  <% elsif list_mode && recipe.photo.attached? %>
    <%= image_tag recipe.photo.variant(resize_to_fill: [ 64, 64 ]), alt: "", loading: :lazy, class: "size-12 shrink-0 rounded-md object-cover" %>
  <% end %>
  <div class="<%= "" unless list_mode %>">
    <h2 class="font-medium text-primary"><%= recipe.title %></h2>
    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-secondary">
      <% if recipe.category.present? %>
        <%= render(Ui::BadgeComponent.new(variant: :secondary)) { recipe.category } %>
      <% end %>
      <% if recipe.total_time_minutes %>
        <span class="inline-flex items-center gap-1"><%= lucide_icon("clock", css_class: "size-3.5") %> <%= t(".total_time", minutes: recipe.total_time_minutes) %></span>
      <% end %>
      <% if recipe.servings %>
        <span class="inline-flex items-center gap-1"><%= lucide_icon("utensils", css_class: "size-3.5") %> <%= recipe.servings %></span>
      <% end %>
    </div>
  </div>
<% end %>
