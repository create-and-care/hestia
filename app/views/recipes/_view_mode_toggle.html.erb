<div class="flex gap-1" role="group" aria-label="<%= t("recipes.index.view_mode_label") %>">
  <%= link_to path_helper.call("card"),
        class: "rounded-md border border-gray-300 px-2 py-1 #{'bg-gray-900 text-white' if @view_mode == 'card'}" do %><%= lucide_icon("layout-grid", css_class: "size-4") %><% end %>
  <%= link_to path_helper.call("list"),
        class: "rounded-md border border-gray-300 px-2 py-1 #{'bg-gray-900 text-white' if @view_mode == 'list'}" do %><%= lucide_icon("list", css_class: "size-4") %><% end %>
</div>
