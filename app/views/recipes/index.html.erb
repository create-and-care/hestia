<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">📖 <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= form_with url: recipes_path, method: :get do |form| %>
        <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"),
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <% end %>
      <%= link_to t(".import_link"), new_import_recipes_path,
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
      <%= link_to t(".new_link"), new_recipe_path,
            class: "rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700" %>
    </div>
  </header>

  <div class="mb-4 flex gap-2 text-sm">
    <span class="rounded-md bg-gray-900 px-3 py-1.5 font-medium text-white"><%= t(".mine_tab") %></span>
    <%= link_to t(".discover_tab"), recipe_catalog_path, class: "rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50" %>
  </div>

  <%= render "shared/flash" %>

  <div id="recipes" class="grid gap-3 sm:grid-cols-2">
    <%= render @recipes %>
  </div>
  <% if @recipes.empty? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">
      <%= @query.present? ? t(".empty_search") : t(".empty") %>
    </p>
  <% end %>

  <p class="mt-6 text-sm">
    <%= link_to t("common.back_to_dashboard"), root_path, class: "underline" %>
  </p>
</div>
