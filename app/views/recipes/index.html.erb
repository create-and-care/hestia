<% content_for :title, t(".title") %>
<%= turbo_stream_from Current.household %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:recipes) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("book-open", css_class: "size-6") %> <%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= render(Ui::SheetComponent.new) do |sheet| %>
        <% sheet.with_trigger do %>
          <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm)) do %>
            <%= lucide_icon("list-filter", css_class: "size-4") %> <%= t(".filters_trigger") %>
          <% end %>
        <% end %>
        <% sheet.with_title { t(".filters_heading") } %>
        <%= form_with url: recipes_path, method: :get, class: "flex flex-col gap-3" do |form| %>
          <%= render(Ui::FieldComponent.new(id: "recipes_q")) do |field| %>
            <% field.with_label { t(".search_label") } %>
            <% field.with_control { render Ui::InputComponent.new(type: "search", name: "q", value: @query, placeholder: t(".search_placeholder"), html_options: { id: "recipes_q" }) } %>
          <% end %>
          <%= render(Ui::FieldComponent.new(id: "recipes_category")) do |field| %>
            <% field.with_label { t(".category_label") } %>
            <% field.with_control { render Ui::NativeSelectComponent.new(name: "category",
                  options: [ [ t(".category_blank"), "" ] ] + @categories.map { |category| [ category, category ] },
                  selected: @category, html_options: { id: "recipes_category" }) } %>
          <% end %>
          <%= render(Ui::FieldComponent.new(id: "recipes_servings")) do |field| %>
            <% field.with_label { t(".servings_label") } %>
            <% field.with_control { render Ui::NativeSelectComponent.new(name: "servings",
                  options: [ [ t(".servings_blank"), "" ] ] + @servings_options.map { |servings| [ t(".servings_option", count: servings), servings.to_s ] },
                  selected: @servings, html_options: { id: "recipes_servings" }) } %>
          <% end %>
          <%= render(Ui::FieldComponent.new(id: "recipes_tag")) do |field| %>
            <% field.with_label { t(".tag_label") } %>
            <% field.with_control { render Ui::NativeSelectComponent.new(name: "tag",
                  options: [ [ t(".tag_blank"), "" ] ] + @tags.map { |tag| [ "##{tag}", tag ] },
                  selected: @tag, html_options: { id: "recipes_tag" }) } %>
          <% end %>
          <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".filter_submit") } %>
        <% end %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: new_import_recipes_path)) { t(".import_link") } %>
      <%= render(Ui::ButtonComponent.new(size: :sm, href: new_recipe_path)) { t(".new_link") } %>
    </div>
  </header>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-sm">
    <div class="flex gap-2">
      <%= render(Ui::ButtonComponent.new(size: :sm, href: recipes_path(q: @query, category: @category, servings: @servings, tag: @tag, view: @view_mode))) { t(".mine_tab") } %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: recipe_catalog_path(q: @query, tag: @tag))) { t(".discover_tab") } %>
    </div>
    <%= render "recipes/view_mode_toggle", path_helper: ->(view) { recipes_path(q: @query, category: @category, servings: @servings, tag: @tag, view: view) } %>
  </div>

  <%= render "shared/flash" %>

  <%# overflow-hidden in list mode: the rows are square-cornered and paint a hover
      background, which otherwise spills past the container's rounded corners. %>
  <div id="recipes" class="<%= @view_mode == "list" ? "overflow-hidden divide-y divide-primary rounded-lg border border-primary" : "grid gap-3 sm:grid-cols-2" %>">
    <%= render partial: "recipe", collection: @recipes, locals: { view_mode: @view_mode } %>
  </div>
  <% if @recipes.empty? %>
    <%= render(Ui::EmptyComponent.new) do |empty| %>
      <% empty.with_description { @query.present? ? t(".empty_search") : t(".empty") } %>
    <% end %>
  <% end %>

  <% if @total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= render Ui::PaginationComponent.new(current: @page, total: @total_pages,
            path: ->(page) { recipes_path(q: @query, category: @category, servings: @servings, tag: @tag, view: @view_mode, page: page) }) %>
    </div>
  <% end %>

</div>
