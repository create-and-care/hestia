<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <div class="mb-4"><%= module_breadcrumb(:recipes, [ t(".title"), nil ], module_path: recipes_path) %></div>

  <h1 class="mb-2 text-2xl font-semibold"><%= t(".heading") %></h1>
  <p class="mb-6 text-sm text-secondary"><%= t(".description") %></p>

  <%= render "shared/flash" %>

  <%= form_with url: import_recipes_path, method: :post do |form| %>
    <div class="flex gap-2">
      <%= render Ui::InputComponent.new(type: "url", name: "url", placeholder: "https://…",
            html_options: { id: "import_url", required: true, class: "flex-1" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".submit") } %>
    </div>
  <% end %>

</div>
