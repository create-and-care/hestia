<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-2xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:recipes, [ @recipe.title, recipe_path(@recipe) ], [ t(".title"), nil ], module_path: recipes_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>
  <%= render "form", recipe: @recipe, url: recipe_path(@recipe) %>
</div>
