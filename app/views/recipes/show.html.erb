<% content_for :title, @recipe.title %>

<div class="mt-10 px-4">
  <header class="mb-4">
    <h1 class="text-2xl font-semibold"><%= @recipe.title %></h1>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-gray-500">
      <% if @recipe.category.present? %><span class="rounded-full bg-gray-100 px-2 py-0.5"><%= @recipe.category %></span><% end %>
      <% @recipe.tags.each do |tag| %><span class="rounded-full bg-gray-100 px-2 py-0.5">#<%= tag %></span><% end %>
      <% if @recipe.prep_time_minutes %><span><%= t(".prep_time", minutes: @recipe.prep_time_minutes) %></span><% end %>
      <% if @recipe.cook_time_minutes %><span><%= t(".cook_time", minutes: @recipe.cook_time_minutes) %></span><% end %>
      <% if @recipe.servings %><span><%= t(".servings", count: @recipe.servings) %></span><% end %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <div class="mb-6 flex flex-wrap gap-2">
    <%= link_to cook_recipe_path(@recipe),
          class: "inline-flex items-center gap-1.5 rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" do %><%= lucide_icon("chef-hat", css_class: "size-4") %> <%= t('.cook_mode_link') %><% end %>
    <%= button_to add_to_shopping_list_recipe_path(@recipe), method: :post,
          class: "cursor-pointer inline-flex items-center gap-1.5 rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" do %><%= lucide_icon("shopping-cart", css_class: "size-4") %> <%= t('.add_to_shopping_list_link') %><% end %>
    <%= link_to t(".edit_link"), edit_recipe_path(@recipe),
          class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <%= button_to t(".delete_link"), recipe_path(@recipe), method: :delete,
          form: { data: { turbo_confirm: t(".delete_confirm") } },
          class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50" %>
  </div>

  <section class="mb-6 rounded-lg border border-gray-200 p-4">
    <h2 class="mb-2 font-medium"><%= t(".plan_meal_heading") %></h2>
    <%= form_with url: meal_plan_entries_path, scope: :meal_plan_entry, class: "flex flex-wrap items-end gap-2" do |form| %>
      <%= form.hidden_field :recipe_id, value: @recipe.id %>
      <%= form.date_field :on_date, value: Date.current, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.select :meal_type, meal_type_options, {}, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
      <%= form.submit t(".plan_meal_submit"), class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="mb-2 font-medium"><%= t(".ingredients_heading") %></h2>
    <ul class="list-inside list-disc space-y-1 text-gray-800">
      <% @recipe.recipe_ingredients.each do |ingredient| %>
        <li><%= ingredient.name %></li>
      <% end %>
    </ul>
  </section>

  <section class="mb-6">
    <h2 class="mb-2 font-medium"><%= t(".steps_heading") %></h2>
    <ol class="list-inside list-decimal space-y-2 text-gray-800">
      <% @recipe.recipe_steps.each do |step| %>
        <li><%= step.content %></li>
      <% end %>
    </ol>
  </section>

  <% if (source = safe_url(@recipe.source_url)) %>
    <p class="mb-4 text-sm text-gray-500"><%= t(".source_label") %> <%= link_to source, source, class: "underline", target: "_blank", rel: "noopener" %></p>
  <% end %>

  <p class="text-sm"><%= link_to t(".back_link"), recipes_path, class: "underline" %></p>
</div>
