<% content_for :title, t(".title", title: @recipe.title) %>

<div class="mx-auto max-w-2xl px-6 py-10" data-controller="wake-lock escape-exit" data-action="keydown.esc@window->escape-exit#exit">
  <p class="mb-6">
    <%= link_to recipe_path(@recipe), class: "inline-flex items-center gap-1.5 text-sm text-secondary hover:underline", data: { escape_exit_target: "link" } do %>
      <%= lucide_icon("x", css_class: "size-4") %> <%= t(".exit_link") %>
    <% end %>
  </p>

  <h1 class="mb-6 text-3xl font-semibold"><%= @recipe.title %></h1>

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-semibold"><%= t(".ingredients_heading") %></h2>
    <ul class="list-inside list-disc space-y-2 text-lg">
      <% @recipe.recipe_ingredients.each do |ingredient| %>
        <li><%= ingredient.name %></li>
      <% end %>
    </ul>
  </section>

  <section>
    <h2 class="mb-3 text-xl font-semibold"><%= t(".steps_heading") %></h2>
    <ol class="list-inside list-decimal space-y-4 text-lg leading-relaxed">
      <% @recipe.recipe_steps.each do |step| %>
        <li><%= step.content %></li>
      <% end %>
    </ol>
  </section>
</div>
