<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @entry, url: meal_plan_entry_path(@entry) do %>
    <% if @entry.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @entry.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "meal_plan_entry_on_date")) do |field| %>
        <% field.with_label { t(".on_date_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "meal_plan_entry[on_date]", value: @entry.on_date,
                html_options: { id: "meal_plan_entry_on_date", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "meal_plan_entry_meal_type")) do |field| %>
        <% field.with_label { t(".meal_type_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "meal_plan_entry[meal_type]", options: meal_type_options, selected: @entry.meal_type,
                html_options: { id: "meal_plan_entry_meal_type" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "meal_plan_entry_recipe_id")) do |field| %>
        <% field.with_label { t(".recipe_label") } %>
        <% field.with_control do %>
          <%= render Ui::ComboboxComponent.new(name: "meal_plan_entry[recipe_id]", options: recipe_options, selected: @entry.recipe_id,
                placeholder: t(".recipe_blank")) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "meal_plan_entry_free_name")) do |field| %>
        <% field.with_label { t(".free_name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "meal_plan_entry[free_name]", value: @entry.free_name,
                html_options: { id: "meal_plan_entry_free_name" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_menu"), menu_path(week: @entry.on_date), class: "underline" %></p>
</div>
