<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <div class="mb-4"><%= module_breadcrumb(:wine_cellar, [ t(".title"), nil ], module_path: wine_cellars_path) %></div>
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @bottle, url: bottle_path(@bottle), multipart: true do |form| %>
    <% if @bottle.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @bottle.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "bottle_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "bottle[name]", value: @bottle.name,
                html_options: { id: "bottle_name", required: true }) %>
        <% end %>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <%= render(Ui::FieldComponent.new(id: "bottle_vintage")) do |field| %>
          <% field.with_label { t(".vintage_label") } %>
          <% field.with_control do %>
            <%= render Ui::InputComponent.new(type: "number", name: "bottle[vintage]", value: @bottle.vintage,
                  html_options: { id: "bottle_vintage" }) %>
          <% end %>
        <% end %>

        <%= render(Ui::FieldComponent.new(id: "bottle_region")) do |field| %>
          <% field.with_label { t(".region_label") } %>
          <% field.with_control do %>
            <%= render Ui::ComboboxComponent.new(name: "bottle[region]", options: @regions.map { |region| [ region, region ] },
                  selected: @bottle.region, placeholder: t(".region_placeholder"),
                  allow_custom: true, create_label: t(".region_create_label", query: "%{query}")) %>
          <% end %>
        <% end %>
      </div>

      <%= render(Ui::FieldComponent.new(id: "bottle_wine_type")) do |field| %>
        <% field.with_label { t(".wine_type_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "bottle[wine_type]", options: [ [ t(".type_blank"), "" ] ] + wine_type_options,
                selected: @bottle.wine_type, html_options: { id: "bottle_wine_type" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "bottle_wine_cellar_id")) do |field| %>
        <% field.with_label { t(".wine_cellar_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "bottle[wine_cellar_id]", options: @cellar_options,
                selected: @bottle.wine_cellar_id, html_options: { id: "bottle_wine_cellar_id" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "bottle_photo")) do |field| %>
        <% field.with_label { t(".photo_label") } %>
        <% field.with_control do %>
          <%= render Ui::FileUploadComponent.new(name: "bottle[photo]", accept: "image/*",
                existing_url: (url_for(@bottle.photo.variant(resize_to_fill: [ 120, 160 ])) if @bottle.photo.attached?),
                html_options: { id: "bottle_photo" }) %>
        <% end %>
      <% end %>

      <% if @bottle.recipe %>
        <p class="text-sm text-secondary">
          <%= lucide_icon("book-open", css_class: "inline size-3.5") %>
          <%= t(".paired_with") %> <%= link_to @bottle.recipe.title, recipe_path(@bottle.recipe), class: "hover:underline" %>
        </p>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    </div>
  <% end %>
</div>
