<%= tag.div id: dom_id(bottle), class: "rounded-lg border border-primary #{"opacity-50" unless bottle.in_stock}" do %>
  <%= render(Ui::ItemComponent.new) do |item| %>
    <% item.with_leading { lucide_icon("wine", css_class: "size-4") } %>
    <% item.with_title do %>
      <span class="<%= "line-through" unless bottle.in_stock %>">
        <%= bottle.name %>
        <% if bottle.vintage %><span class="text-sm text-secondary"><%= bottle.vintage %></span><% end %>
      </span>
    <% end %>
    <% item.with_description do %>
      <%= [ (wine_type_label(bottle.wine_type) if bottle.wine_type.present?), bottle.region ].reject(&:blank?).join(" · ") %>
    <% end %>
    <% item.with_trailing do %>
      <div class="flex flex-wrap items-center gap-2">
        <%= button_to (bottle.in_stock ? t(".take_out") : t(".put_back")), toggle_stock_bottle_path(bottle), method: :patch,
              class: "cursor-pointer rounded border border-primary px-2 py-1 text-xs hover:bg-button-outline-hover" %>

        <%= form_with model: bottle, url: bottle_path(bottle), method: :patch, class: "flex items-center gap-1" do |form| %>
          <%= render Ui::NativeSelectComponent.new(name: "bottle[wine_cellar_id]", options: cellar_options, selected: bottle.wine_cellar_id,
                html_options: { id: "bottle_wine_cellar_id", class: "text-xs" }) %>
          <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".move") } %>
        <% end %>

        <%= button_to bottle_path(bottle), method: :delete, class: "cursor-pointer text-gray-400 hover:text-red-600" do %><%= lucide_icon("x", css_class: "size-4") %><% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
