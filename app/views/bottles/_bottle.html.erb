<%= tag.div id: dom_id(bottle), class: "flex flex-wrap items-center gap-3 rounded-lg border border-gray-200 px-3 py-2 #{'opacity-50' unless bottle.in_stock}" do %>
  <div class="min-w-0 flex-1">
    <p class="font-medium <%= "line-through" unless bottle.in_stock %>">
      🍷 <%= bottle.name %>
      <% if bottle.vintage %><span class="text-sm text-gray-500"><%= bottle.vintage %></span><% end %>
    </p>
    <p class="text-xs text-gray-500">
      <%= [ (wine_type_label(bottle.wine_type) if bottle.wine_type.present?), bottle.region ].reject(&:blank?).join(" · ") %>
    </p>
  </div>

  <%= button_to (bottle.in_stock ? "Sortir" : "Remettre"), toggle_stock_bottle_path(bottle), method: :patch,
        class: "shrink-0 cursor-pointer rounded border border-gray-300 px-2 py-1 text-xs hover:bg-gray-50" %>

  <%= form_with model: bottle, url: bottle_path(bottle), method: :patch, class: "flex shrink-0 items-center gap-1" do |form| %>
    <%= form.select :wine_cellar_id, cellar_options, {}, class: "rounded-md border border-gray-300 px-1 py-1 text-xs" %>
    <%= form.submit "Déplacer", class: "cursor-pointer rounded border border-gray-300 px-2 py-1 text-xs hover:bg-gray-50" %>
  <% end %>

  <%= button_to "✕", bottle_path(bottle), method: :delete, class: "shrink-0 cursor-pointer text-gray-400 hover:text-red-600" %>
<% end %>
