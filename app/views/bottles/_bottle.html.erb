<% show_cellar ||= false %>
<%= tag.div id: dom_id(bottle), class: "rounded-lg border border-primary #{"opacity-50" unless bottle.in_stock}" do %>
  <%= render(Ui::ItemComponent.new) do |item| %>
    <% if bottle.photo.attached? %>
      <% item.with_leading do %>
        <div class="size-8 overflow-hidden rounded">
          <%= image_tag bottle.photo.variant(resize_to_fill: [ 32, 32 ]), alt: "", class: "size-full object-cover" %>
        </div>
      <% end %>
    <% else %>
      <% item.with_leading { lucide_icon("wine", css_class: "size-4") } %>
    <% end %>
    <% item.with_title do %>
      <span class="<%= "line-through" unless bottle.in_stock %>">
        <%= bottle.name %>
        <% if bottle.vintage %><span class="text-sm text-secondary"><%= bottle.vintage %></span><% end %>
      </span>
    <% end %>
    <% item.with_description do %>
      <%= [ (wine_type_label(bottle.wine_type) if bottle.wine_type.present?), bottle.region,
            (show_cellar ? bottle.wine_cellar.name : nil), (t(".paired_indicator") if bottle.recipe) ].reject(&:blank?).join(" · ") %>
    <% end %>
    <% item.with_trailing do %>
      <div class="flex flex-wrap items-center gap-2">
        <%= render(Ui::ButtonToComponent.new(toggle_stock_bottle_path(bottle), method: :patch, variant: :outline, size: :sm)) {
              bottle.in_stock ? t(".take_out") : t(".put_back") } %>
        <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: edit_bottle_path(bottle),
              html_options: { aria: { label: t(".edit_aria", name: bottle.name) } })) { lucide_icon("pencil", css_class: "size-4") } %>
        <%= render(Ui::ButtonToComponent.new(bottle_path(bottle), method: :delete, variant: :ghost, size: :icon,
              html_options: { aria: { label: t(".delete_aria", name: bottle.name) },
                              form: { data: { turbo_confirm: t(".delete_confirm", name: bottle.name) } } })) { lucide_icon("x", css_class: "size-4") } %>
      </div>
    <% end %>
  <% end %>
<% end %>
