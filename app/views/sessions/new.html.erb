<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with url: session_path do %>
    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "email_address")) do |field| %>
        <% field.with_label { t(".email") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "email", name: "email_address", value: params[:email_address],
                placeholder: t(".email_placeholder"),
                html_options: { id: "email_address", required: true, autofocus: true, autocomplete: "username" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "password")) do |field| %>
        <% field.with_label { t(".password") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "password", name: "password",
                placeholder: t(".password_placeholder"),
                html_options: { id: "password", required: true, autocomplete: "current-password", maxlength: 72 }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t(".submit") } %>
    </div>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to t(".forgot_password"), new_password_path, class: "font-medium text-gray-900 underline" %>
  </p>

  <p class="mt-2 text-sm text-gray-600">
    <%= t(".no_account") %> <%= link_to t(".create_account"), new_registration_path, class: "font-medium text-gray-900 underline" %>
  </p>
</div>
