<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with url: session_path do |form| %>
    <div class="space-y-4">
      <div>
        <%= form.label :email_address, t(".email"), class: "mb-1 block text-sm font-medium" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              placeholder: t(".email_placeholder"), value: params[:email_address],
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :password, t(".password"), class: "mb-1 block text-sm font-medium" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
              placeholder: t(".password_placeholder"),
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <%= form.submit t(".submit"), class: "w-full cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to t(".forgot_password"), new_password_path, class: "font-medium text-gray-900 underline" %>
  </p>

  <p class="mt-2 text-sm text-gray-600">
    <%= t(".no_account") %> <%= link_to t(".create_account"), new_registration_path, class: "font-medium text-gray-900 underline" %>
  </p>
</div>
