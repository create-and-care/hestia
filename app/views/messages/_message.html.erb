<%# Hestia's conversations are an N-party household group chat, not the binary
    AI-chat pattern Ui::MessageComponent models — so `role:` here only drives the
    "mine vs. theirs" alignment/color Bubble provides. We always pass the real
    author name explicitly rather than letting the component default to
    "Vous"/"Assistant", since "Assistant" would misname a real household member.

    `role:` is correct here on the INITIAL page load (Current.user is the
    request's signed-in user), but this same partial is also rendered by
    Message#broadcasts_to's async Solid Queue job for every live message,
    where Current.user is always nil — see message_role_controller.js, which
    corrects "mine vs. theirs" client-side using data-author-id once the row
    lands in the DOM (works for both the correctly- and incorrectly-aligned
    initial render, since re-applying the same classes is a no-op). %>
<%= tag.div id: dom_id(message), data: { message_role_target: "row", author_id: message.author_id } do %>
  <%= render(Ui::MessageComponent.new(
        role: message.author == Current.user ? :user : :assistant,
        name: message.author.name.presence || message.author.email_address,
        timestamp: l(message.created_at, format: :numeric_short)
      )) do %>
    <p class="whitespace-pre-line"><%= message.content %></p>
    <% if message.photo.attached? %>
      <%= image_tag message.photo.variant(resize_to_limit: [ 480, 480 ]), alt: "", loading: :lazy, class: "mt-2 max-h-80 w-auto rounded-lg object-cover" %>
    <% end %>

    <% my_reaction = message.message_reactions.detect { |r| r.user_id == Current.user&.id } %>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <% message.message_reactions.group_by(&:emoji).each do |emoji, reactions| %>
        <%= render(Ui::BadgeComponent.new(variant: :secondary)) { "#{emoji} #{reactions.size}" } %>
      <% end %>
      <%# Bespoke one-tap emoji reaction pills, mirroring circle_posts/_circle_post —
          see that partial's comment on why these stay hand-rolled button_to forms
          rather than Ui::ButtonComponent. %>
      <% MessageReaction::ALLOWED_EMOJIS.each do |emoji| %>
        <%= button_to emoji, react_message_path(message, emoji: emoji), method: :post,
              class: "cursor-pointer rounded-full px-1 text-sm hover:bg-surface-hover #{"bg-surface-inset" if my_reaction&.emoji == emoji}",
              form: { class: "inline" },
              aria: { label: t("conversations.react_with", emoji: emoji), pressed: my_reaction&.emoji == emoji } %>
      <% end %>
      <% if my_reaction %>
        <%= button_to t("conversations.remove_reaction"), unreact_message_path(message), method: :delete,
              class: "cursor-pointer text-xs text-subdued underline", form: { class: "inline" } %>
      <% end %>
    </div>
  <% end %>
<% end %>
