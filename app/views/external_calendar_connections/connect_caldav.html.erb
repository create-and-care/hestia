<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with model: ExternalCalendarConnection.new, url: external_calendar_connections_path do |form| %>
    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "external_calendar_connection_caldav_url")) do |field| %>
        <% field.with_label { t(".url_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "url", name: "external_calendar_connection[caldav_url]", placeholder: t(".url_placeholder"),
                html_options: { id: "external_calendar_connection_caldav_url", required: true, autofocus: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "external_calendar_connection_username")) do |field| %>
        <% field.with_label { t(".username_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "external_calendar_connection[username]",
                html_options: { id: "external_calendar_connection_username", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "external_calendar_connection_password")) do |field| %>
        <% field.with_label { t(".password_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "password", name: "external_calendar_connection[password]",
                html_options: { id: "external_calendar_connection_password", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t(".submit") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm">
    <%= link_to t(".back_link"), external_calendar_connections_path, class: "underline" %>
  </p>
</div>
