<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-md px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".heading") %></h1>

  <%= render "shared/flash" %>

  <%= form_with model: ExternalCalendarConnection.new, url: external_calendar_connections_path do |form| %>
    <div class="space-y-4">
      <div>
        <%= form.label :caldav_url, t(".url_label"), class: "mb-1 block text-sm font-medium" %>
        <%= form.url_field :caldav_url, required: true, autofocus: true, placeholder: t(".url_placeholder"),
              class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :username, t(".username_label"), class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :username, required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :password, t(".password_label"), class: "mb-1 block text-sm font-medium" %>
        <%= form.password_field :password, required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      </div>

      <%= form.submit t(".submit"), class: "w-full cursor-pointer rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm">
    <%= link_to t(".back_link"), external_calendar_connections_path, class: "underline" %>
  </p>
</div>
