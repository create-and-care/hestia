<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <h1 class="mb-2 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("refresh-cw", css_class: "size-6") %> <%= t(".heading") %></h1>
  <p class="mb-6 text-sm text-secondary">
    <%= t(".description") %>
  </p>

  <%= render "shared/flash" %>

  <div class="mb-6">
    <% if @connections.none? %>
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".empty") } %>
      <% end %>
    <% else %>
      <div class="divide-y divide-primary rounded-lg border border-primary text-sm">
        <% @connections.each do |connection| %>
          <%= render(Ui::ItemComponent.new) do |item| %>
            <% item.with_title { connection.provider.capitalize } %>
            <% if connection.last_synced_at %>
              <% item.with_description { t(".last_synced_at", time: l(connection.last_synced_at, format: :long)) } %>
            <% end %>
            <% item.with_trailing do %>
              <div class="flex items-center gap-2">
                <%= render(Ui::BadgeComponent.new(variant: connection.active? ? :success : :secondary)) { connection.active? ? t(".active") : t(".inactive") } %>
                <%= form_with url: external_calendar_connection_path(connection), method: :delete,
                      data: { turbo_confirm: t(".disconnect_confirm") } do %>
                  <%= render(Ui::ButtonComponent.new(type: "submit", variant: :destructive, size: :sm)) { t(".disconnect") } %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <% ExternalCalendarConnection::PROVIDERS.each do |provider| %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: connect_external_calendar_connections_path(provider: provider))) do %>
        <%= t(".connect_provider", provider: provider.capitalize) %>
      <% end %>
    <% end %>
  </div>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_calendar"), calendar_path, class: "underline" %></p>
</div>
