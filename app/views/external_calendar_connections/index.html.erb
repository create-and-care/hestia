<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-xl px-4">
  <h1 class="mb-2 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("refresh-cw", css_class: "size-6") %> <%= t(".heading") %></h1>
  <p class="mb-6 text-sm text-gray-500">
    <%= t(".description") %>
  </p>

  <%= render "shared/flash" %>

  <ul class="mb-6 divide-y divide-gray-100 rounded-lg border border-gray-200">
    <% if @connections.none? %>
      <li class="px-4 py-6 text-center text-sm text-gray-400"><%= t(".empty") %></li>
    <% end %>
    <% @connections.each do |connection| %>
      <li class="flex items-center justify-between px-4 py-3 text-sm">
        <span>
          <%= connection.provider.capitalize %>
          <span class="text-gray-400">· <%= connection.active? ? t(".active") : t(".inactive") %></span>
          <% if connection.last_synced_at %>
            <span class="text-gray-400">· <%= t(".last_synced_at", time: l(connection.last_synced_at, format: :long)) %></span>
          <% end %>
        </span>
        <%= button_to t(".disconnect"), external_calendar_connection_path(connection), method: :delete,
              class: "cursor-pointer text-red-600 underline" %>
      </li>
    <% end %>
  </ul>

  <div class="flex flex-wrap gap-2">
    <% ExternalCalendarConnection::PROVIDERS.each do |provider| %>
      <%= link_to t(".connect_provider", provider: provider.capitalize), connect_external_calendar_connections_path(provider: provider),
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </div>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_calendar"), calendar_path, class: "underline" %></p>
</div>
