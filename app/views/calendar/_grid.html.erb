<div role="grid" aria-label="<%= t(".grid_aria") %>" class="grid grid-cols-7 gap-px overflow-hidden rounded-lg border border-primary bg-border-primary text-sm">
  <div role="row" class="contents">
    <% weekday_labels.each do |day| %>
      <div role="columnheader" class="bg-surface p-2 text-center text-xs font-medium text-secondary"><%= day %></div>
    <% end %>
  </div>
  <% dates.each do |date| %>
    <% holiday = holidays&.dig(date) %>
    <% muted = current_month && date.month != current_month.month %>
    <div role="gridcell" aria-current="<%= "date" if date == Date.current %>"
         class="min-h-24 p-1 <%= muted ? "bg-surface text-subdued" : "bg-container" %> <%= "bg-destructive-subtle" if holiday %>"
         title="<%= holiday&.fetch(:name) %>">
      <div class="mb-1 flex items-center justify-between">
        <%# The day number is a date first and a link second. Without an
            explicit colour it fell back to the global link blue, which on a
            public-holiday cell (bg-destructive-subtle) measured 3.21:1 — the
            worst contrast finding in the whole app. %>
        <%# min-w/min-h: the day number is the "add an event on this day"
            control, and at 20 × 16px it was the smallest tap target in the app.
            The cell is 96px tall, so there is room. %>
        <%= link_to date.day, new_calendar_event_path(starts_at: date.to_time.change(hour: 9).iso8601),
              class: "inline-flex min-h-9 min-w-9 items-center justify-center rounded px-1 text-xs hover:bg-surface-hover " +
                (date == Date.current ? "font-semibold text-primary" : (muted && !holiday ? "text-subdued" : "text-primary")),
              title: t(".new_event_on", date: l(date, format: :long)) %>
      </div>
      <% if holiday %>
        <%# text-xs, not a smaller ad-hoc size: a holiday name is read, and 13px
            is this system's floor for text that is. It truncates either way. %>
        <p class="mb-0.5 truncate text-xs font-medium text-destructive"><%= holiday[:name] %></p>
      <% end %>
      <% Array(by_day[date]).each do |time, occurrence| %>
        <%= render "calendar/occurrence", time: time, occurrence: occurrence %>
      <% end %>
    </div>
  <% end %>
</div>
