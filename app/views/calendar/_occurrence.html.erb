<% if birthday_occurrence?(occurrence) %>
  <%= link_to edit_contact_path(occurrence), class: "mb-0.5 flex items-center gap-1 truncate rounded px-1 py-0.5 text-xs bg-destructive-subtle text-destructive" do %>
    🎂 <%= occurrence.name %>
  <% end %>
<% elsif waste_occurrence?(occurrence) %>
  <%= link_to edit_waste_collection_event_path(occurrence), class: "mb-0.5 flex items-center gap-1 truncate rounded px-1 py-0.5 text-xs bg-surface-inset text-secondary" do %>
    <%= waste_type_icon(occurrence.waste_type) %> <%= waste_type_label(occurrence.waste_type) %>
  <% end %>
<% elsif trip_occurrence?(occurrence) %>
  <%= link_to trip_path(occurrence), class: "mb-0.5 flex items-center gap-1 truncate rounded px-1 py-0.5 text-xs bg-surface-inset text-secondary" do %>
    <%= lucide_icon("luggage", css_class: "size-3 shrink-0") %> <%= occurrence.name %>
  <% end %>
<% else %>
  <%= link_to edit_calendar_event_path(occurrence, occurrence: time.iso8601),
        class: "mb-0.5 block truncate rounded px-1 py-0.5 text-xs #{event_color_class(occurrence.color)}" do %>
    <% unless occurrence.all_day %><span class="font-medium"><%= time.strftime("%H:%M") %></span> <% end %><%= occurrence.title %>
  <% end %>
<% end %>
