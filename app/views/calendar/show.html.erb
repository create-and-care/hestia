<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "calendar" %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:calendar) %></div>

  <header class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("calendar", css_class: "size-6") %> <%= calendar_heading(@view, @month, @date) %></h1>
    <div class="flex flex-wrap items-center gap-2">
      <%= render(Ui::ButtonComponent.new(variant: @view == "month" ? :secondary : :outline, size: :sm,
            href: calendar_path(view: :month, member_id: @member_id))) { t(".month_view") } %>
      <%= render(Ui::ButtonComponent.new(variant: @view == "week" ? :secondary : :outline, size: :sm,
            href: calendar_path(view: :week, member_id: @member_id))) { t(".week_view") } %>
      <%= render(Ui::ButtonComponent.new(variant: @view == "day" ? :secondary : :outline, size: :sm,
            href: calendar_path(view: :day, member_id: @member_id))) { t(".day_view") } %>
      <%= render(Ui::ButtonComponent.new(variant: @view == "list" ? :secondary : :outline, size: :sm,
            href: calendar_path(view: :list, member_id: @member_id))) { t(".list_view") } %>
      <%= form_with url: calendar_path, method: :get, class: "flex items-center gap-1" do |form| %>
        <%= form.hidden_field :view, value: @view %>
        <%= render Ui::NativeSelectComponent.new(name: "member_id",
              options: [ [ t(".all_members"), "" ] ] + @members.map { |member| [ member.name.presence || member.email_address, member.id.to_s ] },
              selected: @member_id.to_s, html_options: { id: "calendar_member_id" }) %>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".filter_submit") } %>
      <% end %>
      <%= form_with model: Current.household, url: household_path(Current.household), method: :patch, class: "flex items-center gap-1" do |form| %>
        <%= render Ui::NativeSelectComponent.new(name: "household[holiday_country]",
              options: [ [ t(".holidays_none"), "" ] ] + Household::HOLIDAY_COUNTRIES.map { |country| [ t(".holidays_country", country: country), country ] },
              selected: Current.household.holiday_country, html_options: { id: "household_holiday_country", onchange: "this.form.requestSubmit()" }) %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm,
            href: calendar_path(format: :pdf, month: (@month || Date.current).strftime("%Y-%m"), member_id: @member_id),
            html_options: { target: "_blank" })) { t(".export_pdf") } %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: external_calendar_connections_path)) do %>
        <%= lucide_icon("refresh-cw", css_class: "size-4") %> <%= t(".sync_external") %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(size: :sm, href: new_calendar_event_path)) { t(".new_event") } %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <% if @view == "month" %>
    <div class="mb-3 flex items-center justify-between text-sm">
      <%= link_to t(".prev_month"), calendar_path(view: "month", month: (@month - 1.month).strftime("%Y-%m"), member_id: @member_id), class: "underline" %>
      <%= link_to t(".today"), calendar_path(view: "month", member_id: @member_id), class: "underline" %>
      <%= link_to t(".next_month"), calendar_path(view: "month", month: (@month + 1.month).strftime("%Y-%m"), member_id: @member_id), class: "underline" %>
    </div>
    <%= render "calendar/grid", dates: (@grid_start.to_date..@grid_end.to_date), by_day: @by_day, holidays: @holidays, current_month: @month %>
  <% elsif @view == "week" %>
    <div class="mb-3 flex items-center justify-between text-sm">
      <%= link_to t(".prev_week"), calendar_path(view: "week", date: (@date - 1.week).iso8601, member_id: @member_id), class: "underline" %>
      <%= link_to t(".today"), calendar_path(view: "week", member_id: @member_id), class: "underline" %>
      <%= link_to t(".next_week"), calendar_path(view: "week", date: (@date + 1.week).iso8601, member_id: @member_id), class: "underline" %>
    </div>
    <%= render "calendar/grid", dates: (@grid_start.to_date..@grid_end.to_date), by_day: @by_day, holidays: @holidays, current_month: nil %>
  <% elsif @view == "day" %>
    <div class="mb-3 flex items-center justify-between text-sm">
      <%= link_to t(".prev_day"), calendar_path(view: "day", date: (@date - 1.day).iso8601, member_id: @member_id), class: "underline" %>
      <%= link_to t(".today"), calendar_path(view: "day", member_id: @member_id), class: "underline" %>
      <%= link_to t(".next_day"), calendar_path(view: "day", date: (@date + 1.day).iso8601, member_id: @member_id), class: "underline" %>
    </div>
    <% if (holiday = @holidays&.dig(@date)) %>
      <%= render(Ui::BadgeComponent.new(variant: :destructive, html_options: { class: "mb-3" })) { holiday[:name] } %>
    <% end %>
    <%= render "calendar/occurrences_list", occurrences: @occurrences, overdue_tasks: @overdue_tasks %>
  <% else %>
    <%= render "calendar/occurrences_list", occurrences: @occurrences, overdue_tasks: @overdue_tasks %>
  <% end %>

</div>
