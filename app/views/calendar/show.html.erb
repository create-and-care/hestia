<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "calendar" %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:calendar) %></div>

  <header class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("calendar", css_class: "size-6") %> <%= @view == "list" ? t(".agenda_heading") : month_label(@month) %></h1>
    <div class="flex flex-wrap items-center gap-2">
      <%= render(Ui::ButtonComponent.new(variant: @view == "month" ? :secondary : :outline, size: :sm,
            href: calendar_path(view: :month, member_id: @member_id))) { t(".month_view") } %>
      <%= render(Ui::ButtonComponent.new(variant: @view == "list" ? :secondary : :outline, size: :sm,
            href: calendar_path(view: :list, member_id: @member_id))) { t(".list_view") } %>
      <%= form_with url: calendar_path, method: :get, class: "flex items-center gap-1" do |form| %>
        <%= form.hidden_field :view, value: @view %>
        <%= render Ui::NativeSelectComponent.new(name: "member_id",
              options: [ [ t(".all_members"), "" ] ] + @members.map { |member| [ member.name.presence || member.email_address, member.id.to_s ] },
              selected: @member_id.to_s, html_options: { id: "calendar_member_id" }) %>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".filter_submit") } %>
      <% end %>
      <%= form_with model: Current.household, url: household_path(Current.household), method: :patch, class: "flex items-center gap-1" do |form| %>
        <%= render Ui::NativeSelectComponent.new(name: "household[holiday_country]",
              options: [ [ t(".holidays_none"), "" ] ] + Household::HOLIDAY_COUNTRIES.map { |country| [ t(".holidays_country", country: country), country ] },
              selected: Current.household.holiday_country, html_options: { id: "household_holiday_country", onchange: "this.form.requestSubmit()" }) %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm,
            href: calendar_path(format: :pdf, month: (@month || Date.current).strftime("%Y-%m"), member_id: @member_id),
            html_options: { target: "_blank" })) { t(".export_pdf") } %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: external_calendar_connections_path)) do %>
        <%= lucide_icon("refresh-cw", css_class: "size-4") %> <%= t(".sync_external") %>
      <% end %>
      <%= render(Ui::ButtonComponent.new(size: :sm, href: new_calendar_event_path)) { t(".new_event") } %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <% if @view == "month" %>
    <div class="mb-3 flex items-center justify-between text-sm">
      <%= link_to t(".prev_month"), calendar_path(month: (@month - 1.month).strftime("%Y-%m"), member_id: @member_id), class: "underline" %>
      <%= link_to t(".today"), calendar_path(member_id: @member_id), class: "underline" %>
      <%= link_to t(".next_month"), calendar_path(month: (@month + 1.month).strftime("%Y-%m"), member_id: @member_id), class: "underline" %>
    </div>

    <div class="grid grid-cols-7 gap-px overflow-hidden rounded-lg border border-gray-200 bg-gray-200 text-sm">
      <% weekday_labels.each do |day| %>
        <div class="bg-gray-50 p-2 text-center text-xs font-medium text-gray-500"><%= day %></div>
      <% end %>
      <% (@grid_start.to_date..@grid_end.to_date).each do |date| %>
        <% holiday = @holidays&.dig(date) %>
        <div class="min-h-24 bg-white p-1 <%= "bg-gray-50 text-gray-400" unless date.month == @month.month %> <%= "bg-red-50" if holiday %>"
             title="<%= holiday&.fetch(:name) %>">
          <div class="mb-1 text-right text-xs <%= "font-bold text-gray-900" if date == Date.current %>"><%= date.day %></div>
          <% if holiday %>
            <p class="mb-0.5 truncate text-[10px] font-medium text-red-600"><%= holiday[:name] %></p>
          <% end %>
          <% Array(@by_day[date]).each do |time, event| %>
            <%= link_to edit_calendar_event_path(event),
                  class: "mb-0.5 block truncate rounded px-1 py-0.5 text-xs #{event_color_class(event.color)}" do %>
              <% unless event.all_day %><span class="font-medium"><%= time.strftime("%H:%M") %></span> <% end %><%= event.title %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <% if @occurrences.any? %>
      <div class="divide-y divide-gray-100 rounded-lg border border-gray-200">
        <% @occurrences.each do |time, event| %>
          <%= render(Ui::ItemComponent.new) do |item| %>
            <% item.with_leading { tag.span "", class: "size-2 rounded-full #{event_color_class(event.color)}" } %>
            <% item.with_title { link_to event.title, edit_calendar_event_path(event), class: "hover:underline" } %>
            <% item.with_description do %>
              <%= time.strftime("%a %d/%m — %H:%M") %>
              <% if event.location.present? %>· <%= event.location %><% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render(Ui::EmptyComponent.new) do |empty| %>
        <% empty.with_description { t(".no_events") } %>
      <% end %>
    <% end %>
  <% end %>

</div>
