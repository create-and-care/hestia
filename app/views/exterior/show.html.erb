<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
<% end %>
<%= turbo_stream_from Current.household, "exterior" %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:outdoor) %></div>

  <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("trees", css_class: "size-6") %> <%= t(".title") %></h1>

  <%= render "shared/flash" %>

  <section class="mb-10">
    <h2 class="mb-3 flex items-center gap-1.5 font-medium"><%= lucide_icon("sprout", css_class: "size-5") %> <%= t(".garden_heading") %></h2>
    <%= render(Ui::CardComponent.new) do %>
      <ul class="mb-3 divide-y divide-gray-100">
        <% @plants.each do |plant| %>
          <li>
            <%= render(Ui::ItemComponent.new) do |item| %>
              <% item.with_title do %>
                <%= plant.name %><% if plant.location.present? %> · <%= plant.location %><% end %><% if plant.plant_reference %> · <%= plant.plant_reference.common_name %><% end %>
              <% end %>
              <% if plant.notes.present? || plant.plant_reference %>
                <% item.with_description do %>
                  <%= plant.notes if plant.notes.present? %><% if plant.plant_reference %><%= " · " if plant.notes.present? %><%= lucide_icon("droplet", css_class: "inline size-3") %> <%= plant.plant_reference.water_needs %> · <%= lucide_icon("sun", css_class: "inline size-3") %> <%= plant.plant_reference.sunlight %><% end %>
                <% end %>
              <% end %>
              <% item.with_trailing do %>
                <%= form_with url: plant_path(plant), method: :delete do %>
                  <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit")) { lucide_icon("x", css_class: "size-4") } %>
                <% end %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= form_with model: @plant, url: plants_path, class: "flex flex-wrap items-end gap-2" do |form| %>
        <div class="flex-1">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:name))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:name), value: form.object.name, placeholder: t(".plant_placeholder"), html_options: { id: form.field_id(:name), required: true }) } %>
          <% end %>
        </div>
        <div class="w-32">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:location))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:location), value: form.object.location, placeholder: t(".location_placeholder"), html_options: { id: form.field_id(:location) }) } %>
          <% end %>
        </div>
        <div class="w-48">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:plant_reference_id))) do |field| %>
            <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:plant_reference_id), options: [ [ t(".reference_blank"), "" ] ] + PlantReference.ordered.map { |r| [ r.common_name, r.id ] }, selected: form.object.plant_reference_id, html_options: { id: form.field_id(:plant_reference_id) }) } %>
          <% end %>
        </div>
        <div class="w-40">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:notes))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:notes), value: form.object.notes, placeholder: t(".notes_placeholder"), html_options: { id: form.field_id(:notes) }) } %>
          <% end %>
        </div>
        <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".add") } %>
      <% end %>
    <% end %>
  </section>

  <section class="mb-8">
    <h2 class="mb-3 flex items-center gap-1.5 font-medium"><%= lucide_icon("waves", css_class: "size-5") %> <%= t(".pool_heading") %></h2>
    <% @pools.each do |pool| %>
      <%= render(Ui::CardComponent.new(class_name: "mb-4")) do %>
        <div class="mb-2 flex items-center justify-between">
          <h3 class="font-medium"><%= pool.name %> <span class="text-xs text-gray-400">(<%= treatment_label(pool.treatment_type) %>)</span></h3>
          <%= button_to t(".delete"), pool_path(pool), method: :delete, class: "cursor-pointer text-xs text-red-600 hover:underline" %>
        </div>

        <p class="text-xs font-medium text-gray-500"><%= t(".readings_heading") %></p>
        <ul class="mb-2 divide-y divide-gray-100 text-sm">
          <% pool.pool_readings.recent.first(5).each do |reading| %>
            <li>
              <%= render(Ui::ItemComponent.new) do |item| %>
                <% item.with_title { "#{reading.measured_on.strftime('%d/%m')} · #{reading.measure_type} : #{reading.value}" } %>
                <% item.with_trailing do %>
                  <%= form_with url: pool_pool_reading_path(pool, reading), method: :delete do %>
                    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit")) { lucide_icon("x", css_class: "size-4") } %>
                  <% end %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <%= form_with model: [ pool, PoolReading.new ], url: pool_pool_readings_path(pool), class: "mb-3 flex flex-wrap items-end gap-2" do |form| %>
          <div class="w-24">
            <%= render(Ui::FieldComponent.new(id: form.field_id(:measure_type))) do |field| %>
              <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:measure_type), value: form.object.measure_type, placeholder: t(".measure_type_placeholder"), html_options: { id: form.field_id(:measure_type) }) } %>
            <% end %>
          </div>
          <div class="w-24">
            <%= render(Ui::FieldComponent.new(id: form.field_id(:value))) do |field| %>
              <% field.with_control { render Ui::InputComponent.new(type: "number", name: form.field_name(:value), value: form.object.value, placeholder: t(".value_placeholder"), html_options: { id: form.field_id(:value), step: :any }) } %>
            <% end %>
          </div>
          <div>
            <%= render(Ui::FieldComponent.new(id: form.field_id(:measured_on))) do |field| %>
              <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:measured_on), value: Date.current, html_options: { id: form.field_id(:measured_on) }) } %>
            <% end %>
          </div>
          <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".reading_submit") } %>
        <% end %>

        <p class="text-xs font-medium text-gray-500"><%= t(".actions_heading") %></p>
        <ul class="mb-2 divide-y divide-gray-100 text-sm">
          <% pool.pool_actions.recent.first(5).each do |action| %>
            <li>
              <%= render(Ui::ItemComponent.new) do |item| %>
                <% item.with_title { "#{action.done_on.strftime('%d/%m')} · #{pool_action_label(action.action_type)}" } %>
                <% item.with_trailing do %>
                  <%= form_with url: pool_pool_action_path(pool, action), method: :delete do %>
                    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit")) { lucide_icon("x", css_class: "size-4") } %>
                  <% end %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <%= form_with model: [ pool, PoolAction.new ], url: pool_pool_actions_path(pool), class: "flex flex-wrap items-end gap-2" do |form| %>
          <div>
            <%= render(Ui::FieldComponent.new(id: form.field_id(:action_type))) do |field| %>
              <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:action_type), options: pool_action_options, selected: form.object.action_type, html_options: { id: form.field_id(:action_type) }) } %>
            <% end %>
          </div>
          <div>
            <%= render(Ui::FieldComponent.new(id: form.field_id(:done_on))) do |field| %>
              <% field.with_control { render Ui::InputComponent.new(type: "date", name: form.field_name(:done_on), value: Date.current, html_options: { id: form.field_id(:done_on) }) } %>
            <% end %>
          </div>
          <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".action_submit") } %>
        <% end %>
      <% end %>
    <% end %>

    <%= render(Ui::CardComponent.new) do %>
      <%= form_with model: @pool, url: pools_path, class: "flex flex-wrap items-end gap-2" do |form| %>
        <div class="flex-1">
          <%= render(Ui::FieldComponent.new(id: form.field_id(:name))) do |field| %>
            <% field.with_control { render Ui::InputComponent.new(name: form.field_name(:name), value: form.object.name, placeholder: t(".new_pool_placeholder"), html_options: { id: form.field_id(:name), required: true }) } %>
          <% end %>
        </div>
        <div>
          <%= render(Ui::FieldComponent.new(id: form.field_id(:treatment_type))) do |field| %>
            <% field.with_control { render Ui::NativeSelectComponent.new(name: form.field_name(:treatment_type), options: treatment_options, selected: form.object.treatment_type, html_options: { id: form.field_id(:treatment_type) }) } %>
          <% end %>
        </div>
        <%= render(Ui::ButtonComponent.new(variant: :default, size: :sm, type: "submit")) { t(".add") } %>
      <% end %>
    <% end %>
  </section>

</div>
