<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <h1 class="mb-2 text-2xl font-semibold"><%= t(".heading") %></h1>
  <p class="mb-6 text-sm text-gray-500"><%= t(".description") %></p>

  <%= render "shared/flash" %>

  <% if @products.any? %>
    <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @products.each do |product| %>
        <li class="flex items-center justify-between px-4 py-3">
          <div>
            <p class="font-medium"><%= product.name %></p>
            <% if product.brand.present? %>
              <p class="text-sm text-gray-500"><%= product.brand %></p>
            <% end %>
          </div>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">
            <%= rayon_label(product.rayon) %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">
      <%= t(".empty") %>
    </p>
  <% end %>

  <p class="mt-6 text-sm">
    <%= link_to t(".back_link"), shopping_lists_path, class: "underline" %>
  </p>
</div>
