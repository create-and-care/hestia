<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <h1 class="mb-2 text-2xl font-semibold"><%= t(".heading") %></h1>
  <p class="mb-6 text-sm text-gray-500"><%= t(".description") %></p>

  <%= render "shared/flash" %>

  <% if @products.any? %>
    <div class="divide-y divide-gray-100 rounded-lg border border-gray-200">
      <% @products.each do |product| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_title { product.name } %>
          <% item.with_description { product.brand } if product.brand.present? %>
          <% item.with_trailing { render(Ui::BadgeComponent.new(variant: :secondary)) { rayon_label(product.rayon) } } %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render(Ui::EmptyComponent.new) do |empty| %>
      <% empty.with_description { t(".empty") } %>
    <% end %>
  <% end %>

  <p class="mt-6 text-sm">
    <%= link_to t(".back_link"), shopping_lists_path, class: "underline" %>
  </p>
</div>
