<%= turbo_frame_tag dom_id(@fridge_item, :edit) do %>
  <%= form_with model: @fridge_item, url: fridge_item_path(@fridge_item), method: :patch do |form| %>
    <% if @fridge_item.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @fridge_item.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "fridge_item_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "fridge_item[name]", value: @fridge_item.name,
                html_options: { id: "fridge_item_name", required: true }) %>
        <% end %>
      <% end %>

      <div class="flex gap-3">
        <div class="w-24">
          <%= render(Ui::FieldComponent.new(id: "fridge_item_quantity")) do |field| %>
            <% field.with_label { t(".quantity_label") } %>
            <% field.with_control do %>
              <%= render Ui::InputComponent.new(type: "number", name: "fridge_item[quantity]", value: @fridge_item.quantity,
                    html_options: { id: "fridge_item_quantity", step: "any", min: 0 }) %>
            <% end %>
          <% end %>
        </div>
        <div class="flex-1">
          <%= render(Ui::FieldComponent.new(id: "fridge_item_unit")) do |field| %>
            <% field.with_label { t(".unit_label") } %>
            <% field.with_control do %>
              <%= render Ui::InputComponent.new(name: "fridge_item[unit]", value: @fridge_item.unit,
                    placeholder: t(".unit_placeholder"),
                    html_options: { id: "fridge_item_unit" }) %>
            <% end %>
          <% end %>
        </div>
      </div>

      <%= render(Ui::FieldComponent.new(id: "fridge_item_location")) do |field| %>
        <% field.with_label { t(".location_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "fridge_item[location]", options: location_select_options,
                selected: @fridge_item.location, html_options: { id: "fridge_item_location" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "fridge_item_expires_on")) do |field| %>
        <% field.with_label { t(".expires_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "fridge_item[expires_on]", value: @fridge_item.expires_on,
                html_options: { id: "fridge_item_expires_on" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit", html_options: { class: "w-full" })) { t(".submit") } %>
    </div>
  <% end %>
<% end %>
