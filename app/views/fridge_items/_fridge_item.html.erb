<%= tag.div id: dom_id(fridge_item), class: "rounded-lg border border-primary" do %>
  <%= render(Ui::ItemComponent.new) do |item| %>
    <% item.with_title do %>
      <%= fridge_item.name %>
      <% if fridge_item.quantity.present? %>
        <span class="text-sm text-secondary">— <%= number_with_precision(fridge_item.quantity, precision: 2, strip_insignificant_zeros: true) %> <%= fridge_item.unit %></span>
      <% end %>
    <% end %>
    <% if fridge_item.expires_on.present? %>
      <% item.with_description { t(".until_date", date: l(fridge_item.expires_on, format: :numeric)) } %>
    <% end %>
    <% item.with_trailing do %>
      <div class="flex flex-wrap items-center gap-2">
        <%= render(Ui::BadgeComponent.new(variant: :secondary)) { location_label(fridge_item.location) } %>
        <%= render(Ui::BadgeComponent.new(variant: expiration_badge_variant(fridge_item.expiration_status))) { expiration_label(fridge_item.expiration_status) } %>

        <div class="flex shrink-0 items-center gap-2">
          <%= render(Ui::DialogComponent.new(close_on_submit: true, size: :lg)) do |dialog| %>
            <%# An :outline button, not the :link variant: this sits between two
                icon buttons and opens a modal, so rendering it as underlined
                body text was the one control in the row that didn't look like
                one. %>
            <% dialog.with_trigger do %>
              <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, icon: "pencil")) { t(".edit") } %>
            <% end %>
            <% dialog.with_title { t(".edit") } %>
            <%= turbo_frame_tag dom_id(fridge_item, :edit), src: edit_fridge_item_path(fridge_item), loading: :lazy do %>
              <%= render "shared/frame_skeleton", label: t(".edit_loading"), rows: 3 %>
            <% end %>
          <% end %>
          <%= button_to move_to_shopping_list_fridge_item_path(fridge_item), method: :post,
                class: "cursor-pointer text-subdued hover:text-primary",
                form: { title: t(".add_to_list_title"), data: { turbo_confirm: t(".add_to_list_confirm") } },
                aria: { label: t(".rebuy_aria") } do %><%= lucide_icon("shopping-cart", css_class: "size-4") %><% end %>
          <%= form_with url: fridge_item_path(fridge_item), method: :delete, class: "inline",
                data: { turbo_confirm: t(".delete_confirm") } do %>
            <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, type: "submit",
                  html_options: { aria: { label: t(".delete_aria") } })) { lucide_icon("x", css_class: "size-4") } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
