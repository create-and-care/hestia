<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @supply, url: pet_supply_path(@pet, @supply) do %>
    <% if @supply.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @supply.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "pet_supply_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "pet_supply[name]", value: @supply.name,
                html_options: { id: "pet_supply_name", required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pet_supply_order_url")) do |field| %>
        <% field.with_label { t(".order_url_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "url", name: "pet_supply[order_url]", value: @supply.order_url,
                html_options: { id: "pet_supply_order_url" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "pet_supply_next_order_on")) do |field| %>
        <% field.with_label { t(".next_order_on_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "date", name: "pet_supply[next_order_on]", value: @supply.next_order_on,
                html_options: { id: "pet_supply_next_order_on" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_pet"), pet_path(@pet), class: "underline" %></p>
</div>
