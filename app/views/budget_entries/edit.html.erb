<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-lg px-4">
  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title") %></h1>

  <%= form_with model: @entry, url: budget_entry_path(@entry) do |form| %>
    <% if @entry.errors.any? %>
      <%= render(Ui::AlertComponent.new(variant: :destructive, class_name: "mb-4")) do %>
        <ul class="list-inside list-disc">
          <% @entry.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= render(Ui::FieldComponent.new(id: "budget_entry_name")) do |field| %>
        <% field.with_label { t(".name_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(name: "budget_entry[name]", value: @entry.name,
                html_options: { id: "budget_entry_name" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "budget_entry_amount")) do |field| %>
        <% field.with_label { t(".amount_label") } %>
        <% field.with_control do %>
          <%= render Ui::InputComponent.new(type: "number", name: "budget_entry[amount]", value: @entry.amount,
                html_options: { id: "budget_entry_amount", step: :any, required: true }) %>
        <% end %>
      <% end %>

      <%= render(Ui::FieldComponent.new(id: "budget_entry_periodicity")) do |field| %>
        <% field.with_label { t(".periodicity_label") } %>
        <% field.with_control do %>
          <%= render Ui::NativeSelectComponent.new(name: "budget_entry[periodicity]",
                options: [ [ t(".per_month_option"), "monthly" ], [ t(".per_year_option"), "yearly" ] ],
                selected: @entry.periodicity, html_options: { id: "budget_entry_periodicity" }) %>
        <% end %>
      <% end %>

      <%= render(Ui::ButtonComponent.new(variant: :default, type: "submit")) { t(".save") } %>
    </div>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to t(".back_to_budget"), budget_path, class: "underline" %></p>
</div>
