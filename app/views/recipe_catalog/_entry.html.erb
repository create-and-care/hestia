<% list_mode = local_assigns[:view_mode] == "list" %>
<% meta = capture do %>
  <% entry.tags.each do |tag| %>
    <%= render(Ui::BadgeComponent.new(variant: :secondary)) { "##{t("recipe_catalog.tags.#{tag}", default: tag.humanize)}" } %>
  <% end %>
  <% if entry.total_time_minutes %>
    <span class="inline-flex items-center gap-1"><%= lucide_icon("clock", css_class: "size-3.5") %> <%= t("recipes.recipe.total_time", minutes: entry.total_time_minutes) %></span>
  <% end %>
  <% if entry.servings %>
    <span class="inline-flex items-center gap-1"><%= lucide_icon("utensils", css_class: "size-3.5") %> <%= entry.servings %></span>
  <% end %>
<% end %>

<% action = capture do %>
  <% if @added_entry_ids&.include?(entry.id) %>
    <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-primary bg-surface text-subdued" title="<%= t(".already_added") %>">
      &minus;<span class="sr-only"><%= t(".already_added") %></span>
    </span>
  <% else %>
    <%= form_with url: add_to_household_recipe_catalog_path(entry), method: :post, class: "inline" do %>
      <%= render(Ui::ButtonComponent.new(type: "submit", variant: :outline, size: :icon,
            html_options: { class: "rounded-full", title: t(".add_link"), aria: { label: t(".add_link") } })) { "+" } %>
    <% end %>
  <% end %>
<% end %>

<div id="<%= dom_id(entry, :catalog) %>">
  <% if list_mode %>
    <%= render(Ui::ItemComponent.new) do |item| %>
      <% if entry.image_url.present? %>
        <% item.with_leading { image_tag entry.image_url, alt: "", class: "size-12 shrink-0 rounded-md object-cover" } %>
      <% end %>
      <% item.with_title { entry.title } %>
      <% item.with_description { meta } %>
      <% item.with_trailing { action } %>
    <% end %>
  <% else %>
    <%= render(Ui::CardComponent.new) do %>
      <% if entry.image_url.present? %>
        <%= render(Ui::AspectRatioComponent.new) do %>
          <%= image_tag entry.image_url, alt: "", class: "size-full object-cover" %>
        <% end %>
      <% end %>
      <h2 class="<%= "mt-3" if entry.image_url.present? %> font-medium text-primary"><%= entry.title %></h2>
      <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-secondary"><%= meta %></div>
      <div class="mt-3"><%= action %></div>
    <% end %>
  <% end %>
</div>
