<% list_mode = local_assigns[:view_mode] == "list" %>
<div id="<%= dom_id(entry, :catalog) %>" class="<%= list_mode ? "flex flex-wrap items-center justify-between gap-3 px-4 py-3" : "rounded-lg border border-gray-200 p-4" %>">
  <div>
    <h2 class="font-medium"><%= entry.title %></h2>
    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-500">
      <% entry.tags.each do |tag| %>
        <span class="rounded-full bg-gray-100 px-2 py-0.5">#<%= t("recipe_catalog.tags.#{tag}", default: tag.humanize) %></span>
      <% end %>
      <% if entry.total_time_minutes %>
        <span>⏱ <%= t("recipes.recipe.total_time", minutes: entry.total_time_minutes) %></span>
      <% end %>
      <% if entry.servings %>
        <span>🍽 <%= entry.servings %></span>
      <% end %>
    </div>
  </div>
  <% if @added_entry_ids&.include?(entry.id) %>
    <span class="<%= "mt-3" unless list_mode %> shrink-0 inline-flex size-8 items-center justify-center rounded-full border border-gray-200 bg-gray-50 text-gray-400" title="<%= t(".already_added") %>">
      &minus;<span class="sr-only"><%= t(".already_added") %></span>
    </span>
  <% else %>
    <%= button_to add_to_household_recipe_catalog_path(entry), method: :post, title: t(".add_link"),
          class: "#{'mt-3' unless list_mode} shrink-0 cursor-pointer inline-flex size-8 items-center justify-center rounded-full border border-gray-300 font-medium hover:bg-gray-50" do %>
      +<span class="sr-only"><%= t(".add_link") %></span>
    <% end %>
  <% end %>
</div>
