<% content_for :title, t(".title") %>

<div class="mx-auto mt-10 max-w-3xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:recipes) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("search", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= form_with url: recipe_catalog_path, method: :get, class: "flex flex-wrap items-center gap-2" do |form| %>
      <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"),
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= form.select :tag, options_for_select(@tags.map { |tag| [ t("recipe_catalog.tags.#{tag}", default: tag.humanize), tag ] }, @tag),
            { include_blank: t(".tag_blank") }, class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= form.submit t(".filter_submit"), class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
    <% end %>
  </header>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-sm">
    <div class="flex gap-2">
      <%= link_to t(".mine_tab"), recipes_path, class: "rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50" %>
      <span class="rounded-md bg-gray-900 px-3 py-1.5 font-medium text-white"><%= t(".discover_tab") %></span>
    </div>
    <%= render "recipes/view_mode_toggle", path_helper: ->(view) { recipe_catalog_path(q: @query, tag: @tag, view: view) } %>
  </div>

  <%= render "shared/flash" %>

  <div id="recipe_catalog_entries" class="<%= @view_mode == "list" ? "divide-y divide-gray-100 rounded-lg border border-gray-200" : "grid gap-3 sm:grid-cols-2" %>">
    <%= render partial: "entry", collection: @entries, locals: { view_mode: @view_mode } %>
  </div>
  <% if @entries.empty? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500">
      <%= @query.present? ? t(".empty_search") : t(".empty") %>
    </p>
  <% end %>

  <% if @total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= render Ui::PaginationComponent.new(current: @page, total: @total_pages,
            path: ->(page) { recipe_catalog_path(q: @query, tag: @tag, view: @view_mode, page: page) }) %>
    </div>
  <% end %>

</div>
