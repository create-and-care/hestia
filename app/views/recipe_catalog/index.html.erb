<% content_for :title, t(".title") %>

<div class="mt-10 max-w-5xl mx-auto px-4">
  <div class="mb-4"><%= module_breadcrumb(:recipes) %></div>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= lucide_icon("search", css_class: "size-6") %> <%= t(".title") %></h1>
    <%= form_with url: recipe_catalog_path, method: :get, class: "flex flex-wrap items-center gap-2" do |form| %>
      <%= render Ui::InputComponent.new(type: "search", name: "q", value: @query, placeholder: t(".search_placeholder"),
            html_options: { id: "recipe_catalog_q" }) %>
      <%= render Ui::NativeSelectComponent.new(name: "tag",
            options: [ [ t(".tag_blank"), "" ] ] + @tags.map { |tag| [ t("recipe_catalog.tags.#{tag}", default: tag.humanize), tag ] },
            selected: @tag, html_options: { id: "recipe_catalog_tag" }) %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, type: "submit")) { t(".filter_submit") } %>
    <% end %>
  </header>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-sm">
    <div class="flex gap-2">
      <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, href: recipes_path)) { t(".mine_tab") } %>
      <%= render(Ui::ButtonComponent.new(size: :sm, href: recipe_catalog_path(q: @query, tag: @tag, view: @view_mode))) { t(".discover_tab") } %>
    </div>
    <%= render "recipes/view_mode_toggle", path_helper: ->(view) { recipe_catalog_path(q: @query, tag: @tag, view: view) } %>
  </div>

  <%= render "shared/flash" %>

  <div id="recipe_catalog_entries" class="<%= @view_mode == "list" ? "divide-y divide-primary rounded-lg border border-primary" : "grid gap-3 sm:grid-cols-2" %>">
    <%= render partial: "entry", collection: @entries, locals: { view_mode: @view_mode } %>
  </div>
  <% if @entries.empty? %>
    <%= render(Ui::EmptyComponent.new) do |empty| %>
      <% empty.with_description { @query.present? ? t(".empty_search") : t(".empty") } %>
    <% end %>
  <% end %>

  <% if @total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= render Ui::PaginationComponent.new(current: @page, total: @total_pages,
            path: ->(page) { recipe_catalog_path(q: @query, tag: @tag, view: @view_mode, page: page) }) %>
    </div>
  <% end %>

</div>
